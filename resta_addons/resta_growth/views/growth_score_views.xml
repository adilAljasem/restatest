<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_growth_snapshot_list" model="ir.ui.view">
        <field name="name">resta.growth.score.snapshot.list</field>
        <field name="model">resta.growth.score.snapshot</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="score"/>
                <field name="band"/>
                <field name="forming"/>
                <field name="c_sales"/>
                <field name="c_inventory"/>
                <field name="c_invoices"/>
                <field name="c_margin"/>
                <field name="anomaly_deduction"/>
                <field name="quality_index"/>
                <field name="simulated" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_growth_snapshot_graph" model="ir.ui.view">
        <field name="name">resta.growth.score.snapshot.graph</field>
        <field name="model">resta.growth.score.snapshot</field>
        <field name="arch" type="xml">
            <graph type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="score" type="measure" operator="max"/>
            </graph>
        </field>
    </record>
    <record id="action_growth_snapshot" model="ir.actions.act_window">
        <field name="name">لقطات مؤشر الانضباط</field>
        <field name="res_model">resta.growth.score.snapshot</field>
        <field name="view_mode">list,graph</field>
    </record>

    <record id="view_growth_daily_list" model="ir.ui.view">
        <field name="name">resta.growth.daily.list</field>
        <field name="model">resta.growth.daily</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="planned"/>
                <field name="recorded"/>
                <field name="orders" sum="الإجمالي"/>
                <field name="sales_total" sum="الإجمالي"/>
                <field name="cash_sales" optional="hide"/>
                <field name="sessions_closed" optional="show"/>
                <field name="sessions_cash_ok" optional="show"/>
                <field name="invoices_total" optional="show"/>
                <field name="invoices_sent" optional="show"/>
                <field name="invoices_pending_48h" optional="hide"/>
                <field name="consumption_value" optional="show"/>
                <field name="waste_value" optional="show"/>
                <field name="inventory_count" optional="show"/>
                <field name="inventory_coverage" optional="hide"/>
                <field name="simulated" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_growth_daily" model="ir.actions.act_window">
        <field name="name">الحقائق اليومية</field>
        <field name="res_model">resta.growth.daily</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
