<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_growth_profile_form" model="ir.ui.view">
        <field name="name">resta.growth.profile.form</field>
        <field name="model">resta.growth.profile</field>
        <field name="arch" type="xml">
            <form string="ملف المطعم">
                <header>
                    <button name="action_recompute_now" type="object" string="تحديث الآن" class="btn-primary"
                            groups="resta_growth.group_resta_support"/>
                    <button name="action_skip_level" type="object" string="تخطي المستوى الحالي"
                            invisible="plan != 'paid_full'" groups="resta_growth.group_resta_owner"
                            confirm="تخطي المستوى يفتح ميزاته، والرحلة والمؤشر يبقيان ظاهرين. متابعة؟"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="company_id" readonly="1" options="{'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group string="المطعم">
                            <field name="restaurant_type_id" options="{'no_create': True}"/>
                            <field name="city"/>
                            <field name="region"/>
                            <field name="seats"/>
                            <field name="branches"/>
                        </group>
                        <group string="الاشتراك والرحلة">
                            <field name="plan" readonly="not context.get('growth_support')"/>
                            <field name="activation_date" readonly="not context.get('growth_support')"/>
                            <field name="current_level_id" options="{'no_open': True}"/>
                            <field name="score"/>
                            <field name="score_band"/>
                            <field name="quality_index"/>
                            <field name="last_compute"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="أيام العطلة والإجازات">
                            <group string="العطلة الأسبوعية">
                                <group>
                                    <field name="off_sun"/><field name="off_mon"/><field name="off_tue"/>
                                    <field name="off_wed"/>
                                </group>
                                <group>
                                    <field name="off_thu"/><field name="off_fri"/><field name="off_sat"/>
                                </group>
                            </group>
                            <field name="holiday_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                </list>
                            </field>
                        </page>
                        <page string="الموافقات">
                            <group>
                                <field name="consent_benchmark"/>
                                <field name="consent_league"/>
                                <field name="consent_financing"/>
                            </group>
                            <div class="text-muted">
                                يُرسل للمنصة مجاميع ونسب يومية فقط، بلا أسماء أو أرقام جوالات أو بيانات عملاء.
                                كل موافقة مستقلة ويمكن سحبها في أي وقت.
                            </div>
                        </page>
                        <page string="المستويات" groups="resta_growth.group_resta_support">
                            <field name="level_state_ids" readonly="1">
                                <list>
                                    <field name="level_id"/>
                                    <field name="state"/>
                                    <field name="started_date"/>
                                    <field name="ready_since"/>
                                    <field name="achieved_date"/>
                                    <field name="skipped"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_growth_profile" model="ir.actions.server">
        <field name="name">ملف المطعم</field>
        <field name="model_id" ref="model_resta_growth_profile"/>
        <field name="state">code</field>
        <field name="code">
profile = model._get()
action = {
    "type": "ir.actions.act_window", "res_model": "resta.growth.profile", "res_id": profile.id,
    "views": [[False, "form"]], "target": "current", "name": "ملف المطعم",
    "context": {"growth_support": env.user.has_group("resta_growth.group_resta_support")},
}
        </field>
    </record>

    <record id="action_growth_journey" model="ir.actions.client">
        <field name="name">رحلتي</field>
        <field name="tag">resta_growth.journey</field>
        <field name="path">growth</field>
    </record>
</odoo>
