<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_resta_growth" model="ir.module.category">
        <field name="name">رحلة النمو</field>
        <field name="sequence">4</field>
    </record>
    <record id="res_groups_privilege_resta_growth" model="res.groups.privilege">
        <field name="name">رحلة النمو</field>
        <field name="sequence">4</field>
        <field name="category_id" ref="module_category_resta_growth"/>
    </record>

    <!-- Branch manager: badge, score and lessons (read only), no subscription / billing -->
    <record id="group_resta_manager" model="res.groups">
        <field name="name">مدير الفرع</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_resta_growth"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Restaurant owner: the main user of the journey. Not a technical administrator. -->
    <record id="group_resta_owner" model="res.groups">
        <field name="name">صاحب الحساب</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_resta_growth"/>
        <field name="implied_ids" eval="[(4, ref('group_resta_manager'))]"/>
    </record>

    <!-- Resta team: sees everything, bypasses feature locks, simulator -->
    <record id="group_resta_support" model="res.groups">
        <field name="name">فريق ريستا (الدعم)</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_resta_growth"/>
        <field name="implied_ids" eval="[(4, ref('group_resta_owner'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
    </record>

    <!-- one profile per company -->
    <record id="rule_profile_company" model="ir.rule">
        <field name="name">Growth profile: own companies</field>
        <field name="model_id" ref="model_resta_growth_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_daily_company" model="ir.rule">
        <field name="name">Growth daily facts: own companies</field>
        <field name="model_id" ref="model_resta_growth_daily"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_snapshot_company" model="ir.rule">
        <field name="name">Growth score snapshots: own companies</field>
        <field name="model_id" ref="model_resta_growth_score_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_progress_own" model="ir.rule">
        <field name="name">Lesson progress: own records</field>
        <field name="model_id" ref="model_resta_growth_lesson_progress"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
