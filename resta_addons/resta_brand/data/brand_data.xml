<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- on every update: templates of the modules installed in between -->
    <function model="res.company" name="_resta_brand_apply"/>
    <record id="ir_cron_resta_brand" model="ir.cron">
        <field name="name">Resta: الهوية في قوالب الإيميل</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._resta_brand_apply()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
