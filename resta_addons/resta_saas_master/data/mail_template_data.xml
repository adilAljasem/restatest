<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_welcome" model="mail.template">
        <field name="name">Resta: الترحيب ببيانات الدخول</field>
        <field name="model_id" ref="model_resta_tenant"/>
        <field name="subject">مرحباً بك في ريستا - رقم حسابك {{ object.account_number }}</field>
        <field name="email_to">{{ object.owner_email }}</field>
        <field name="lang">ar_001</field>
        <field name="body_html" type="html">
<div dir="rtl" style="font-family:'IBM Plex Sans Arabic',Tahoma,Arial,sans-serif;color:#161616;max-width:560px;margin:auto">
    <div style="background:#FF5A1F;color:#fff;padding:18px 22px;border-radius:12px 12px 0 0;font-size:20px;font-weight:700">ريستا</div>
    <div style="background:#fff;border:1px solid #E9E4DF;border-top:0;padding:22px;border-radius:0 0 12px 12px">
        <p>مرحباً <t t-out="object.owner_name"/>،</p>
        <p>نظام <b t-out="object.name"/> جاهز. فترتك التجريبية تنتهي في <b t-out="object.trial_end"/>.</p>
        <table style="width:100%;background:#F9F7F3;border-radius:10px;padding:12px;margin:14px 0">
            <tr><td style="color:#706D69">رقم الحساب</td><td style="font-size:20px;font-weight:700" t-out="object.account_number"/></tr>
            <tr><td style="color:#706D69">البريد</td><td t-out="object.owner_email"/></tr>
            <tr><td style="color:#706D69">رابط النظام</td><td><a t-att-href="object.url" t-out="object.url" style="color:#C2410C"/></td></tr>
        </table>
        <p>مدير حسابك: <b t-out="object.account_manager_id.name or 'فريق ريستا'"/> وسيتواصل معك قريباً لمساعدتك في الإعداد.</p>
        <a t-att-href="object.url" style="display:inline-block;background:#FF5A1F;color:#fff;padding:10px 20px;border-radius:10px;text-decoration:none;font-weight:600">الدخول إلى نظامك</a>
    </div>
</div>
        </field>
    </record>
    <record id="mail_template_trial_ending" model="mail.template">
        <field name="name">Resta: التجربة تنتهي قريباً</field>
        <field name="model_id" ref="model_resta_tenant"/>
        <field name="subject">تجربة ريستا تنتهي بعد 3 أيام - {{ object.name }}</field>
        <field name="email_to">{{ object.owner_email }}</field>
        <field name="lang">ar_001</field>
        <field name="body_html" type="html">
<div dir="rtl" style="font-family:'IBM Plex Sans Arabic',Tahoma,Arial,sans-serif;color:#161616;max-width:560px;margin:auto">
    <p>مرحباً <t t-out="object.owner_name"/>،</p>
    <p>تنتهي الفترة التجريبية لنظام <b t-out="object.name"/> (رقم الحساب <b t-out="object.account_number"/>) في <b t-out="object.trial_end"/>.</p>
    <p>فعّل اشتراكك الآن للاستمرار دون انقطاع، ومدير حسابك <b t-out="object.account_manager_id.name or 'فريق ريستا'"/> جاهز لمساعدتك.</p>
</div>
        </field>
    </record>
</odoo>
