<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resta_announcement_view_list" model="ir.ui.view">
        <field name="name">resta.announcement.list</field>
        <field name="model">resta.announcement</field>
        <field name="arch" type="xml">
            <list>
                <field name="publish_date"/><field name="name"/>
                <field name="kind" widget="badge"/><field name="tag"/><field name="audience"/>
                <field name="important"/><field name="feedback_count"/><field name="rating_avg"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>
    <record id="resta_announcement_view_form" model="ir.ui.view">
        <field name="name">resta.announcement.form</field>
        <field name="model">resta.announcement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="نشر للمطاعم" class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_draft" type="object" string="إرجاع لمسودة" invisible="state != 'published'"/>
                    <button name="action_archive_announcement" type="object" string="أرشفة" invisible="state == 'archived'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name" placeholder="مثال: سجل النشاطات أصبح 270 يوماً"/></h1>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="tag" placeholder="نقاط البيع، المخزون..."/>
                            <field name="important"/>
                            <field name="publish_date"/>
                        </group>
                        <group>
                            <field name="audience"/>
                            <field name="edition" invisible="audience != 'edition'" required="audience == 'edition'"/>
                            <field name="tenant_state" invisible="audience != 'state'" required="audience == 'state'"/>
                            <field name="tenant_ids" widget="many2many_tags" invisible="audience != 'tenants'" required="audience == 'tenants'"/>
                        </group>
                    </group>
                    <field name="body" placeholder="اكتب تفاصيل التحديث أو الرسالة..."/>
                    <notebook>
                        <page string="تفاعل المطاعم">
                            <group><field name="rating_avg"/><field name="feedback_count"/></group>
                            <field name="feedback_ids" readonly="1">
                                <list><field name="create_date"/><field name="tenant_id"/><field name="rating"/><field name="message"/><field name="user_name"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_resta_announcement" model="ir.actions.act_window">
        <field name="name">التحديثات والرسائل</field>
        <field name="res_model">resta.announcement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
