<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_generator_brand" inherit_id="website.layout" name="Resta: website generator">
        <xpath expr="//meta[@name='generator']" position="attributes">
            <attribute name="content">Resta</attribute>
        </xpath>
    </template>

    <!-- staff sign-in on the platform: the same Resta page as the restaurant systems, not the site layout -->
    <template id="login_layout_platform" inherit_id="web.login_layout" priority="25" name="Resta: platform sign-in page">
        <xpath expr="//t[@t-call='website.layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
                <t t-set="body_classname" t-value="'rs_auth_body'"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <t t-call="resta_brand.auth_shell">
                    <t t-set="auth_logo" t-value="'/resta_sidebar_theme/static/img/resta-wordmark-default.svg'"/>
                    <t t-out="0"/>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
