<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="resta_demo_request_view_list" model="ir.ui.view">
        <field name="name">resta.demo.request.list</field>
        <field name="model">resta.demo.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/><field name="name"/><field name="phone" widget="phone"/>
                <field name="business_name"/><field name="business_type"/><field name="branches"/><field name="city"/>
                <field name="account_manager_id" widget="many2one_avatar_user"/>
                <field name="activity_ids" widget="list_activity"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="resta_demo_request_view_form" model="ir.ui.view">
        <field name="name">resta.demo.request.form</field>
        <field name="model">resta.demo.request</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar" options="{'clickable': '1'}"/></header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_whatsapp" type="object" class="oe_stat_button" icon="fa-whatsapp"><span class="o_stat_text">واتساب</span></button>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group><field name="phone" widget="phone"/><field name="email" widget="email"/><field name="city"/></group>
                        <group><field name="business_name"/><field name="business_type"/><field name="branches"/><field name="account_manager_id"/><field name="tenant_id"/></group>
                    </group>
                    <field name="message"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_resta_demo_request" model="ir.actions.act_window">
        <field name="name">طلبات العرض</field>
        <field name="res_model">resta.demo.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
