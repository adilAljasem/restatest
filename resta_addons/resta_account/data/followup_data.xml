<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="followup_level_1" model="resta.followup.level">
            <field name="name">تذكير ودي</field>
            <field name="delay">7</field>
            <field name="send_email" eval="True"/>
            <field name="attach_statement" eval="True"/>
            <field name="auto" eval="True"/>
            <field name="email_subject">تذكير بالمبالغ المستحقة - {company}</field>
            <field name="email_body" type="html"><div><p>السادة {partner}،</p><p>تحية طيبة، نود تذكيركم بوجود مبلغ <b>{overdue}</b> تجاوز موعد استحقاقه. مرفق كشف الحساب للاطلاع.</p><p>إن كنتم سددتم مؤخراً فنرجو تجاهل هذه الرسالة. شكراً لتعاملكم معنا.</p><p>{company}</p></div></field>
            <field name="whatsapp_text">مرحباً {partner}، نذكّركم بمبلغ {overdue} تجاوز موعد استحقاقه. شاكرين تعاونكم - {company}</field>
        </record>
        <record id="followup_level_2" model="resta.followup.level">
            <field name="name">تذكير ثانٍ واتصال</field>
            <field name="delay">30</field>
            <field name="send_email" eval="True"/>
            <field name="attach_statement" eval="True"/>
            <field name="create_activity" eval="True"/>
            <field name="activity_note">اتصل بالعميل بخصوص {overdue} متأخرة منذ {days} يوماً</field>
            <field name="auto" eval="True"/>
            <field name="email_subject">تذكير ثانٍ: مبالغ متأخرة - {company}</field>
            <field name="email_body" type="html"><div><p>السادة {partner}،</p><p>لم نستلم حتى الآن سداد مبلغ <b>{overdue}</b> المتأخر منذ {days} يوماً. نرجو المبادرة بالسداد أو التواصل معنا.</p><p>{company}</p></div></field>
            <field name="whatsapp_text">مرحباً {partner}، تذكير ثانٍ بمبلغ {overdue} متأخر منذ {days} يوماً. نرجو السداد أو التواصل معنا - {company}</field>
        </record>
        <record id="followup_level_3" model="resta.followup.level">
            <field name="name">إنذار نهائي</field>
            <field name="delay">60</field>
            <field name="send_email" eval="True"/>
            <field name="attach_statement" eval="True"/>
            <field name="create_activity" eval="True"/>
            <field name="activity_note">إنذار نهائي: قرر إيقاف التعامل الآجل مع العميل أو تحويله للتحصيل</field>
            <field name="auto" eval="False"/>
            <field name="email_subject">إنذار نهائي بالسداد - {company}</field>
            <field name="email_body" type="html"><div><p>السادة {partner}،</p><p>رغم تذكيراتنا السابقة ما زال مبلغ <b>{overdue}</b> غير مسدد منذ {days} يوماً. نرجو السداد خلال 7 أيام لتجنب إيقاف التعامل الآجل.</p><p>{company}</p></div></field>
            <field name="whatsapp_text">السادة {partner}، إنذار نهائي بسداد {overdue} المتأخرة منذ {days} يوماً خلال 7 أيام - {company}</field>
        </record>
    </data>
    <record id="cron_followup" model="ir.cron">
        <field name="name">ريستا: متابعة التحصيل اليومية</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_resta_followup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
