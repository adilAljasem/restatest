<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_payroll" model="res.groups.privilege">
        <field name="name">الرواتب</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="sequence">40</field>
    </record>
    <record id="group_payroll_user" model="res.groups">
        <field name="name">مسؤول رواتب</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="group_payroll_manager" model="res.groups">
        <field name="name">مدير الرواتب</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_payroll_user')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_payslip_company" model="ir.rule">
        <field name="name">Payslip: multi-company</field>
        <field name="model_id" ref="model_resta_payslip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_batch_company" model="ir.rule">
        <field name="name">Payslip batch: multi-company</field>
        <field name="model_id" ref="model_resta_payslip_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
