<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="resta_settings.SettingsPage" t-inherit="web.SettingsPage" t-inherit-mode="extension">
        <xpath expr="//div[@t-ref='settings']/t[1]" position="before">
            <div t-if="state.search.value.length === 0" class="o_rs_set_strip">
                <button type="button" class="btn btn-sm btn-light" t-on-click="restaOpenHome">
                    <i class="fa fa-th-large" aria-hidden="true"/> مركز الإعدادات
                </button>
                <span class="o_rs_set_strip_text">
                    <t t-if="restaAdvanced">تعرض الآن كل الإعدادات (الوضع المتقدم لفريق الدعم).</t>
                    <t t-else="">تظهر هنا إعدادات المطعم فقط. استخدم البحث للوصول لأي إعداد بسرعة.</t>
                </span>
                <button t-if="restaCanAdvance" type="button" class="btn btn-sm btn-link" t-on-click="restaToggleAdvanced">
                    <t t-if="restaAdvanced">العودة للإعدادات المبسطة</t>
                    <t t-else="">الإعدادات المتقدمة</t>
                </button>
            </div>
        </xpath>
    </t>
</templates>
