<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kds_ticket_list" model="ir.ui.view">
        <field name="name">resta.kds.ticket.list</field>
        <field name="model">resta.kds.ticket</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-muted="done" decoration-danger="cancelled">
                <field name="create_date" string="وقت الإرسال"/>
                <field name="tracking_number"/>
                <field name="pos_order_id"/>
                <field name="display_id"/>
                <field name="table_label" optional="show"/>
                <field name="order_type" optional="show"/>
                <field name="stage_id"/>
                <field name="send_index" optional="hide"/>
                <field name="ready_date" optional="show"/>
                <field name="done" optional="hide"/>
                <field name="cancelled" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_kds_ticket_form" model="ir.ui.view">
        <field name="name">resta.kds.ticket.form</field>
        <field name="model">resta.kds.ticket</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <div class="oe_title"><h1>طلب <field name="tracking_number" class="d-inline"/></h1></div>
                    <group>
                        <group>
                            <field name="pos_order_id"/>
                            <field name="display_id"/>
                            <field name="stage_id"/>
                            <field name="send_index"/>
                        </group>
                        <group>
                            <field name="create_date" string="وقت الإرسال"/>
                            <field name="ready_date"/>
                            <field name="done_date"/>
                            <field name="table_label"/>
                            <field name="order_type"/>
                        </group>
                    </group>
                    <field name="note" readonly="1"/>
                    <field name="line_ids">
                        <list>
                            <field name="qty"/>
                            <field name="name"/>
                            <field name="attributes"/>
                            <field name="note"/>
                            <field name="qty_cancelled"/>
                            <field name="done"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_kds_ticket_search" model="ir.ui.view">
        <field name="name">resta.kds.ticket.search</field>
        <field name="model">resta.kds.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="tracking_number"/>
                <field name="pos_order_id"/>
                <field name="display_id"/>
                <filter name="open" string="مفتوحة" domain="[('done', '=', False)]"/>
                <filter name="today" string="اليوم" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="by_display" string="الشاشة" context="{'group_by': 'display_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_kds_ticket" model="ir.actions.act_window">
        <field name="name">سجل تذاكر المطبخ</field>
        <field name="res_model">resta.kds.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
