# Copy these into Dokploy > (your compose app) > Environment. Never commit real values.

# --- Required -------------------------------------------------------------
DB_PASSWORD=change-me-long-random-32-chars
ODOO_MASTER_PASSWORD=change-me-another-long-random
RESTA_DOMAIN=resta.sa

# --- Odoo sizing (Contabo Cloud VPS 30: 8 vCPU / 24 GB) -------------------
ODOO_WORKERS=6
ODOO_CRON_THREADS=2
ODOO_DB_MAXCONN=16
ODOO_MEMORY_SOFT_MB=2048
ODOO_MEMORY_HARD_MB=2560

# --- PostgreSQL sizing -----------------------------------------------------
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB

# --- Backups -----------------------------------------------------------------
BACKUP_HOST_DIR=/root/resta-backups
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
# Off-site copy (Backblaze B2): bucket "resta-backups", folder "prod"
B2_KEY_ID=
B2_APPLICATION_KEY=
BACKUP_RCLONE_REMOTE=b2:resta-backups/prod
# Uptime Kuma "Push" monitor URL (alerts you if a nightly backup is missing or fails)
BACKUP_NOTIFY_URL=

# First start creates the platform + 2 templates (~10 min). Set false afterwards if you like.
RESTA_AUTO_INIT=true
