#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Only Draft batches can be validated."
msgstr "يمكن اعتماد الأوامر المجمعة الموجودة في حالة المسودة فقط."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Scrap Orders have already been created for this batch."
msgstr "تم إنشاء أوامر الهالك لهذا الأمر المجمع بالفعل."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Source Location and Scrap Location are required."
msgstr "الموقع المصدر وموقع الهالك مطلوبان."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Add at least one scrap line before validating the batch."
msgstr "أضف سطر هالك واحدًا على الأقل قبل اعتماد الأمر المجمع."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Every scrap line must have a Product, a Unit, and a Quantity greater than zero."
msgstr "يجب أن يحتوي كل سطر هالك على منتج ووحدة وكمية أكبر من صفر."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
#, python-format
msgid "Scrap %(scrap)s could not be completed automatically. Check the available quantity and any lot or serial requirements, then validate the batch again."
msgstr "تعذر إكمال أمر الهالك %(scrap)s تلقائيًا. تحقق من الكمية المتاحة ومتطلبات الدفعة أو الرقم التسلسلي ثم اعتمد الأمر المجمع مرة أخرى."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "The batch cannot be completed until every Scrap Order is Done."
msgstr "لا يمكن إكمال الأمر المجمع حتى تصبح جميع أوامر الهالك في حالة تم."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Only Draft batches can be cancelled."
msgstr "يمكن إلغاء الأوامر المجمعة الموجودة في حالة المسودة فقط."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "A batch with generated Scrap Orders cannot be cancelled."
msgstr "لا يمكن إلغاء أمر مجمع تم إنشاء أوامر هالك منه."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "A batch linked to generated Scrap Orders cannot be deleted."
msgstr "لا يمكن حذف أمر مجمع مرتبط بأوامر هالك تم إنشاؤها."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Scrap lines can only be added in Draft."
msgstr "يمكن إضافة سطور الهالك في حالة المسودة فقط."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Validated scrap lines cannot be changed."
msgstr "لا يمكن تعديل سطور الهالك بعد الاعتماد."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Validated scrap lines cannot be deleted."
msgstr "لا يمكن حذف سطور الهالك بعد الاعتماد."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/stock_scrap.py:0
msgid "This Scrap Order was not created from a batch."
msgstr "لم يتم إنشاء أمر الهالك هذا من أمر هالك مجمع."

#. module: batch_scrap_orders
#: code:addons/batch_scrap_orders/models/batch_scrap_order.py:0
msgid "Product %(product)s is a Kit with no available Kit BoM. Create or unarchive its BoM (Type = Kit) before scrapping it."
msgstr "المنتج %(product)s معرف كطقم (Kit) دون قائمة مواد طقم متاحة. يجب إنشاء قائمة المواد (النوع = طقم) أو إلغاء أرشفتها قبل تنفيذ الهالك."
