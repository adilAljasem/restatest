<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.configuration.controls</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="before">
                <block title="Order Invoicing" id="pos_configuration_controls_section">
                    <setting id="pos_always_to_invoice_setting"
                             string="Always To Invoice"
                             help="Automatically check Invoice for every order and prevent the cashier from disabling it.">
                        <field name="pos_always_to_invoice"/>
                    </setting>
                    <setting id="pos_disable_auto_invoice_pdf_download_setting"
                             string="Disable Automatic Invoice PDF Download"
                             help="Keep invoice creation unchanged, but do not automatically download or open the full invoice PDF after payment validation.">
                        <field name="pos_disable_auto_invoice_pdf_download"/>
                    </setting>
                    <setting id="pos_default_customer_setting"
                             string="Default Customer"
                             help="Select this customer automatically on each new order. The cashier can replace it.">
                        <field name="pos_default_customer_id"
                               options="{'no_create': False}"
                               placeholder="Select a customer"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
