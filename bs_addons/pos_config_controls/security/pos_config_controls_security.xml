<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_pos_restriction" model="res.groups.privilege">
        <field name="name">Point of Sale Restriction</field>
        <field name="description">Limit a user to explicitly assigned Point of Sale configurations.</field>
        <field name="placeholder">Unrestricted</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_restricted_pos_user" model="res.groups">
        <field name="name">Restricted POS User</field>
        <field name="comment">Only grants access to the Point of Sale configurations assigned on the user.</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_restriction"/>
        <field name="implied_ids" eval="[Command.link(ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="rule_restricted_pos_config" model="ir.rule">
        <field name="name">Restricted POS User: assigned configurations only</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="groups" eval="[Command.link(ref('group_restricted_pos_user'))]"/>
        <field name="domain_force">[('id', 'in', user.allowed_pos_config_ids.ids)]</field>
    </record>

    <record id="rule_restricted_pos_session" model="ir.rule">
        <field name="name">Restricted POS User: sessions of assigned configurations only</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="groups" eval="[Command.link(ref('group_restricted_pos_user'))]"/>
        <field name="domain_force">[('config_id', 'in', user.allowed_pos_config_ids.ids)]</field>
    </record>

    <record id="rule_restricted_pos_stock_picking" model="ir.rule">
        <field name="name">Restricted POS User: transfers of assigned POS operation types</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="groups" eval="[Command.link(ref('group_restricted_pos_user'))]"/>
        <field name="domain_force">[('picking_type_id', 'in', user.allowed_pos_config_ids.mapped('picking_type_id').ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
