<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_stock_ageing" model="report.paperformat">
        <field name="name">Stock Ageing Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">32</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_stock_ageing" model="ir.actions.report">
        <field name="name">Stock Ageing Report</field>
        <field name="model">stock.ageing.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_stock_ageing_report.report_stock_ageing_document</field>
        <field name="report_file">custom_stock_ageing_report.report_stock_ageing_document</field>
        <field name="paperformat_id" ref="custom_stock_ageing_report.paperformat_stock_ageing"/>
        <field name="binding_model_id" eval="False"/>
        <field name="print_report_name">'Stock Ageing - %s' % (object.report_date or '')</field>
    </record>
</odoo>
