<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="stock_ageing_filter_summary">
        <table class="table table-sm table-bordered mb-2" style="width: 100%; border-collapse: collapse; font-size: 9px;">
            <tbody>
                <tr style="background-color: #e7e7e7; font-weight: bold; text-align: center;">
                    <td>Company</td>
                    <td>Report Date</td>
                    <td>Period Length (Days)</td>
                    <td>Number of Periods</td>
                </tr>
                <tr style="text-align: center;">
                    <td><t t-out="data['company']"/></td>
                    <td><t t-out="data['report_date']"/></td>
                    <td><t t-out="data['period_length']"/></td>
                    <td><t t-out="data['period_count']"/></td>
                </tr>
                <tr style="background-color: #f4f4f4;">
                    <td colspan="2">
                        <strong>Filter By <t t-out="data['filters']['filter_by']"/>:</strong>
                        <t t-if="data['filters']['filter_by_key'] == 'product'" t-out="data['filters']['products']"/>
                        <t t-else="" t-out="data['filters']['categories']"/>
                    </td>
                    <td colspan="2">
                        <strong>Generate Report Based on <t t-out="data['filters']['report_based_on']"/>:</strong>
                        <t t-if="data['filters']['report_based_on_key'] == 'warehouse'" t-out="data['filters']['warehouses']"/>
                        <t t-else="" t-out="data['filters']['locations']"/>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="stock_ageing_result_table">
        <div class="o_stock_ageing_table" style="overflow-x: auto;">
            <t t-if="show_filters" t-call="custom_stock_ageing_report.stock_ageing_filter_summary"/>
            <table
                class="table table-sm table-bordered mb-2"
                t-att-style="'width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 6.5px;' if pdf_mode else 'width: max-content; min-width: 100%; border-collapse: collapse; font-size: 10px;'"
            >
                <thead>
                    <tr style="background-color: #d9d9d9; color: #111; text-align: center; vertical-align: middle;">
                        <th rowspan="2" style="padding: 4px;">Code</th>
                        <th rowspan="2" style="padding: 4px;">Product Name</th>
                        <th rowspan="2" style="padding: 4px;">UoM</th>
                        <th rowspan="2" style="padding: 4px;">Warehouse</th>
                        <th rowspan="2" style="padding: 4px;">Total Qty</th>
                        <th rowspan="2" style="padding: 4px;">Total Value</th>
                        <t t-foreach="data['periods']" t-as="period">
                            <th colspan="2" style="padding: 4px;"><t t-out="period['label']"/></th>
                        </t>
                    </tr>
                    <tr style="background-color: #e7e7e7; color: #111; text-align: center;">
                        <t t-foreach="data['periods']" t-as="period">
                            <th style="padding: 3px;">Qty</th>
                            <th style="padding: 3px;">Value</th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="not data['lines']">
                        <tr>
                            <td t-att-colspan="6 + (2 * len(data['periods']))" style="padding: 16px; text-align: center;">
                                No stock ageing results were found for the selected filters and report date.
                            </td>
                        </tr>
                    </t>
                    <t t-foreach="data['lines']" t-as="line">
                        <tr>
                            <td style="padding: 4px;"><t t-out="line['default_code']"/></td>
                            <td style="padding: 4px;"><t t-out="line['product']"/></td>
                            <td style="padding: 4px;"><t t-out="line['uom']"/></td>
                            <td style="padding: 4px;"><t t-out="line['warehouse']"/></td>
                            <td style="padding: 4px; text-align: right; color: #008a00; font-weight: 600;"><t t-out="line['total_qty_display']"/></td>
                            <td style="padding: 4px; text-align: right;"><t t-out="line['total_value_display']"/></td>
                            <t t-foreach="line['buckets']" t-as="bucket">
                                <td style="padding: 4px; text-align: right; color: #008a00; font-weight: 600;"><t t-out="bucket['quantity_display']"/></td>
                                <td style="padding: 4px; text-align: right;"><t t-out="bucket['value_display']"/></td>
                            </t>
                        </tr>
                    </t>
                </tbody>
                <tfoot t-if="data['lines']">
                    <tr style="background-color: #d9ead3; font-weight: bold;">
                        <td colspan="4" style="padding: 5px;">Grand Total</td>
                        <td style="padding: 5px; text-align: right;"><t t-out="data['totals']['quantity_display']"/></td>
                        <td style="padding: 5px; text-align: right;"><t t-out="data['totals']['value_display']"/></td>
                        <t t-foreach="data['totals']['buckets']" t-as="bucket">
                            <td style="padding: 5px; text-align: right;"><t t-out="bucket['quantity_display']"/></td>
                            <td style="padding: 5px; text-align: right;"><t t-out="bucket['value_display']"/></td>
                        </t>
                    </tr>
                </tfoot>
            </table>
            <div t-if="show_filters" class="alert alert-light py-2 mb-0" style="font-size: 10px;">
                <strong>Valuation method:</strong> <t t-out="data['valuation_method']"/>
            </div>
        </div>
    </template>

    <template id="report_stock_ageing_document">
        <t t-call="web.html_container">
            <t t-foreach="reports" t-as="report">
                <t t-set="o" t-value="report['wizard']"/>
                <t t-set="data" t-value="report['data']"/>
                <t t-set="company" t-value="o.company_id"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align: center; margin: 0 0 8px 0;">Stock Ageing Report</h2>
                        <t t-call="custom_stock_ageing_report.stock_ageing_filter_summary"/>
                        <t t-set="show_filters" t-value="False"/>
                        <t t-set="pdf_mode" t-value="True"/>
                        <t t-call="custom_stock_ageing_report.stock_ageing_result_table"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
