<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_ageing_report_wizard_view_form" model="ir.ui.view">
        <field name="name">stock.ageing.report.wizard.form</field>
        <field name="model">stock.ageing.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Ageing Report" create="0" delete="0">
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="result_data" invisible="1"/>
                    <field name="xlsx_file" invisible="1"/>
                    <field name="xlsx_filename" invisible="1"/>

                    <div invisible="state != 'filters'" class="pt-2">
                        <group col="2">
                            <group>
                                <field name="company_id"
                                       options="{'no_create': True}"
                                       domain="[('id', 'in', context.get('allowed_company_ids', []))]"/>
                                <field name="filter_by" widget="radio" options="{'horizontal': true}"/>
                                <field name="product_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('is_storable', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                                       invisible="filter_by != 'product'"/>
                                <field name="category_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       invisible="filter_by != 'category'"/>
                                <field name="report_based_on" widget="radio" options="{'horizontal': true}"/>
                                <field name="warehouse_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('company_id', '=', company_id)]"
                                       invisible="report_based_on != 'warehouse'"/>
                                <field name="location_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('usage', '=', 'internal'), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                                       invisible="report_based_on != 'location'"/>
                            </group>
                            <group>
                                <field name="period_length"/>
                                <field name="period_count"/>
                                <field name="report_date"/>
                            </group>
                        </group>
                    </div>

                    <div invisible="state != 'results'">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <h2 class="mb-0">Stock Ageing Report</h2>
                                <span class="text-muted">Historical FIFO result as of <field name="report_date" readonly="1" class="oe_inline"/>.</span>
                            </div>
                        </div>
                        <field name="result_html" widget="html" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_view_report"
                            type="object"
                            string="View Report"
                            class="btn-primary"
                            icon="fa-eye"
                            invisible="state != 'filters'"/>
                    <span invisible="state != 'filters'">or</span>
                    <button name="action_print_pdf"
                            type="object"
                            string="Print PDF"
                            class="btn-primary"
                            icon="fa-print"
                            invisible="state != 'filters'"/>
                    <span invisible="state != 'filters'">or</span>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Print Excel"
                            class="btn-primary"
                            icon="fa-file-excel-o"
                            invisible="state != 'filters'"/>

                    <button name="action_back_to_filters"
                            type="object"
                            string="Change Filters"
                            class="btn-secondary"
                            icon="fa-arrow-left"
                            invisible="state != 'results'"/>
                    <button name="action_print_pdf"
                            type="object"
                            string="Print PDF"
                            class="btn-primary"
                            icon="fa-print"
                            invisible="state != 'results'"/>
                    <button name="action_export_xlsx"
                            type="object"
                            string="Print Excel"
                            class="btn-primary"
                            icon="fa-file-excel-o"
                            invisible="state != 'results'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" invisible="state != 'filters'"/>
                    <button string="Close" special="cancel" class="btn-secondary" invisible="state != 'results'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_ageing_report_download_view_form" model="ir.ui.view">
        <field name="name">stock.ageing.report.download.form</field>
        <field name="model">stock.ageing.report.download</field>
        <field name="arch" type="xml">
            <form string="Files to Download" create="0" edit="0" delete="0">
                <sheet>
                    <field name="filename" invisible="1"/>
                    <separator string="REPORT GENERATED"/>
                    <group>
                        <field name="file_data" filename="filename" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_ageing_report_wizard" model="ir.actions.act_window">
        <field name="name">Stock Ageing Report</field>
        <field name="res_model">stock.ageing.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="custom_stock_ageing_report.stock_ageing_report_wizard_view_form"/>
        <field name="target">new</field>
        <field name="context">{'default_company_id': allowed_company_ids and allowed_company_ids[0] or False, 'dialog_size': 'extra-large'}</field>
        <field name="help" type="html">
            <p>Choose the stock scope, product filter, report date, and ageing periods.</p>
        </field>
    </record>

    <menuitem
        id="menu_stock_ageing_report"
        name="Stock Ageing Report"
        parent="stock.menu_warehouse_report"
        action="custom_stock_ageing_report.action_stock_ageing_report_wizard"
        sequence="60"
        groups="stock.group_stock_manager"
    />
</odoo>
