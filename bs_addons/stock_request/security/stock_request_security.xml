            <field name="name">stock_request multi-company</field>
            <field
                name="model_id"
                search="[('model','=','stock.request')]"
                model="ir.model"
            />
            <field name="global" eval="True" />
            <field
                name="domain_force"
            >['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
