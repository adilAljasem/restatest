<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.module.category" id="module_category_stock_request">
        <field name="name">Stock Transfer</field>
        <field name="parent_id" ref="base.module_category_supply_chain" />
        <field name="sequence">10</field>
    </record>
    <record id="group_stock_request_user" model="res.groups">
        <field name="name">Stock Request User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_stock_request_warehouse_responsible" model="res.groups">
        <field name="name">Stock Request Warehouse Responsible</field>
        <field
            name="implied_ids"
            eval="[(4, ref('stock_request.group_stock_request_user')),(4, ref('stock.group_stock_user'))]"
        />
    </record>
    <record id="group_stock_request_manager" model="res.groups">
        <field name="name">Stock Request Manager</field>
<!--        <field-->
<!--            name="user_ids"-->
<!--            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"-->
<!--        />-->
        <field
            name="implied_ids"
            eval="[(4, ref('stock_request.group_stock_request_warehouse_responsible')),(4, ref('stock.group_stock_manager'))]"
        />
    </record>
    <!-- New rules also load on upgrade; existing noupdate rules stay intact. -->
    <record id="stock_request_no_transit_warehouse_items_rule" model="ir.rule">
        <field name="name">Warehouse responsible - No transit items before delivery</field>
        <field name="model_id" ref="model_stock_request"/>
        <field name="groups" eval="[(4, ref('group_stock_request_warehouse_responsible'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[
            ('order_id.operation_type', '=', 'request'),
            ('order_id.transfer_flow', '=', 'two_step_no_transit'),
            ('order_id.state', 'in', ['draft', 'submitted', 'ready']),
            '|',
            ('order_id.source_warehouse_id.stock_request_responsible_user_ids', 'in', [user.id]),
            ('order_id.warehouse_id.stock_request_responsible_user_ids', 'in', [user.id])
        ]</field>
    </record>
    <record id="stock_request_no_transit_warehouse_order_rule" model="ir.rule">
        <field name="name">Warehouse responsible - No transit order items before delivery</field>
        <field name="model_id" ref="model_stock_request_order"/>
        <field name="groups" eval="[(4, ref('group_stock_request_warehouse_responsible'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[
            ('operation_type', '=', 'request'),
            ('transfer_flow', '=', 'two_step_no_transit'),
            ('state', 'in', ['draft', 'submitted', 'ready']),
            '|',
            ('source_warehouse_id.stock_request_responsible_user_ids', 'in', [user.id]),
            ('warehouse_id.stock_request_responsible_user_ids', 'in', [user.id])
        ]</field>
    </record>
    <record id="stock_request_no_transit_in_transit_items_rule" model="ir.rule">
        <field name="name">No transit - Edit items awaiting receipt</field>
        <field name="model_id" ref="model_stock_request"/>
        <field name="groups" eval="[(4, ref('group_stock_request_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[
            ('order_id.operation_type', '=', 'request'),
            ('order_id.transfer_flow', '=', 'two_step_no_transit'),
            ('order_id.state', '=', 'in_transit'), '|', '|',
            ('order_id.requested_by', '=', user.id),
            ('order_id.source_warehouse_id.stock_request_responsible_user_ids', 'in', [user.id]),
            ('order_id.warehouse_id.stock_request_responsible_user_ids', 'in', [user.id])
        ]</field>
    </record>
    <record id="stock_request_no_transit_in_transit_order_rule" model="ir.rule">
        <field name="name">No transit - Edit order items awaiting receipt</field>
