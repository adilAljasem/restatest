<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_request_in_transit_list" model="ir.ui.view">
        <field name="name">stock.request.in.transit.list</field>
        <field name="model">stock.request</field>
        <field name="arch" type="xml">
            <list
                string="In Transit"
                create="false"
                edit="false"
                delete="false"
                default_order="delivery_date desc, id desc"
                decoration-danger="overdue"
            >
                <field name="order_id" string="Request Number" />
                <field name="operation_type" />
                <field name="requested_by" />
                <field name="source_warehouse_id" />
                <field name="warehouse_id" string="Destination Warehouse" />
                <field name="transit_location_id" />
                <field name="product_id" />
                <field name="product_uom_id" string="UOM" />
                <field name="product_uom_qty" string="Requested Quantity" />
                <field name="delivered_qty" />
                <field name="received_qty" />
                <field name="in_transit_qty" sum="Total In Transit" />
                <field name="delivery_date" />
                <field name="expected_date" />
                <field name="days_in_transit" />
                <field name="delivered_by_id" />
                <field name="operation_state" />
                <field name="overdue" />
                <button
                    name="action_open_stock_request_order"
                    type="object"
                    string="Request"
                    icon="fa-external-link"
                    title="Open Stock Request"
                />
                <button
                    name="action_open_delivery_transfers"
                    type="object"
                    string="Delivery"
                    icon="fa-truck"
                    title="Open Delivery Transfers"
                />
                <button
                    name="action_open_receipt_transfers"
                    type="object"
                    string="Receipt"
                    icon="fa-download"
                    title="Open Receipt Transfers"
                />
            </list>
        </field>
    </record>

    <record id="stock_request_in_transit_search" model="ir.ui.view">
        <field name="name">stock.request.in.transit.search</field>
        <field name="model">stock.request</field>
        <field name="arch" type="xml">
            <search string="In Transit Operations">
                <field name="order_id" string="Request Number" />
                <field name="source_warehouse_id" />
                <field name="warehouse_id" string="Destination Warehouse" />
                <field name="transit_location_id" />
                <field name="product_id" />
                <field name="product_category_id" />
                <field name="delivered_by_id" />
                <separator />
                <filter
                    name="my_related_operations"
                    string="My Related Operations"
                    domain="['|', '|', ('requested_by', '=', uid), ('source_warehouse_id.stock_request_responsible_user_ids', 'in', [uid]), ('warehouse_id.stock_request_responsible_user_ids', 'in', [uid])]"
                />
                <filter
                    name="in_transit"
                    string="In Transit"
                    domain="[('in_transit_qty', '&gt;', 0)]"
                />
                <filter
                    name="overdue"
                    string="Overdue"
                    domain="[('overdue', '=', True)]"
                />
                <separator />
                <filter
                    name="stock_requests"
                    string="Stock Requests"
                    domain="[('operation_type', '=', 'request')]"
                />
                <filter
                    name="direct_transfers"
                    string="Direct Transfers"
                    domain="[('operation_type', '=', 'transfer')]"
                />
                <group>
                    <filter
                        name="group_source_warehouse"
                        string="Source Warehouse"
                        context="{'group_by': 'source_warehouse_id'}"
                    />
                    <filter
                        name="group_destination_warehouse"
                        string="Destination Warehouse"
                        context="{'group_by': 'warehouse_id'}"
                    />
                    <filter
                        name="group_transit_location"
                        string="Transit Location"
                        context="{'group_by': 'transit_location_id'}"
                    />
                    <filter
                        name="group_product"
                        string="Product"
                        context="{'group_by': 'product_id'}"
                    />
                    <filter
                        name="group_product_category"
                        string="Product Category"
                        context="{'group_by': 'product_category_id'}"
                    />
                    <filter
                        name="group_delivered_by"
                        string="Delivered By"
                        context="{'group_by': 'delivered_by_id'}"
                    />
                    <filter
                        name="group_delivery_month"
                        string="Delivery Month"
                        context="{'group_by': 'delivery_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="stock_request_in_transit_action" model="ir.actions.act_window">
        <field name="name">In Transit</field>
        <field name="res_model">stock.request</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="stock_request_in_transit_list" />
        <field name="search_view_id" ref="stock_request_in_transit_search" />
        <field name="domain">[('order_id', '!=', False), ('in_transit_qty', '&gt;', 0)]</field>
        <field name="context">{'search_default_in_transit': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                There are no product quantities currently in transit.
            </p>
        </field>
    </record>

    <record id="stock_request_in_transit_picking_list" model="ir.ui.view">
        <field name="name">stock.request.in.transit.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Stock Request Transfers" create="false" edit="false" delete="false">
                <field name="name" />
                <field name="stock_request_order_id" />
                <field name="stock_request_operation" />
                <field name="location_id" />
                <field name="location_dest_id" />
                <field name="scheduled_date" />
                <field name="date_done" />
                <field name="stock_request_validated_by_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="stock_request_in_transit_picking_form" model="ir.ui.view">
        <field name="name">stock.request.in.transit.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <form string="Stock Request Transfer" create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="stock_request_order_id" readonly="1" />
                            <field name="stock_request_operation" readonly="1" />
                            <field name="location_id" readonly="1" />
                            <field name="location_dest_id" readonly="1" />
                        </group>
                        <group>
                            <field name="scheduled_date" readonly="1" />
                            <field name="date_done" readonly="1" />
                            <field name="stock_request_validated_by_id" readonly="1" />
                            <field name="stock_request_validation_date" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="move_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="product_id" />
                                    <field name="product_uom_qty" />
                                    <field name="quantity" />
                                    <field name="product_uom" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_request_in_transit_picking_action" model="ir.actions.act_window">
        <field name="name">Stock Request Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="stock_request_in_transit_picking_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="stock_request_in_transit_picking_list" />
        <field name="act_window_id" ref="stock_request_in_transit_picking_action" />
    </record>
    <record id="stock_request_in_transit_picking_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock_request_in_transit_picking_form" />
        <field name="act_window_id" ref="stock_request_in_transit_picking_action" />
    </record>
</odoo>
