<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_request_close_receipt_wizard_form" model="ir.ui.view">
        <field name="name">stock.request.close.receipt.wizard.form</field>
        <field name="model">stock.request.close.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Remaining Receipt">
                <div class="alert alert-warning" role="alert">
                    Confirming will cancel the remaining quantities shown below.
                    The actual received quantities will not be changed.
                </div>
                <group>
                    <field name="order_id" />
                    <field name="company_id" invisible="1" />
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="company_id" column_invisible="1" />
                        <field name="stock_request_id" column_invisible="1" />
                        <field name="product_id" />
                        <field name="received_quantity" />
                        <field name="remaining_quantity" />
                        <field name="product_uom_id" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_confirm_close"
                        string="Close Remaining Receipt"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
