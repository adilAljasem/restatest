<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="stock_request_template_tree">
        <field name="name">stock.request.order.template.legacy.tree</field>
        <field name="model">stock.request.order</field>
        <field name="active" eval="False" />
        <field name="arch" type="xml"><list /></field>
    </record>

    <record model="ir.ui.view" id="stock_request_template_form">
        <field name="name">stock.request.order.template.legacy.form</field>
        <field name="model">stock.request.order</field>
        <field name="active" eval="False" />
        <field name="arch" type="xml"><form /></field>
    </record>

    <record model="ir.ui.view" id="stock_request_template_manager_form">
        <field name="name">stock.request.order.template.legacy.manager.form</field>
        <field name="model">stock.request.order</field>
        <field name="active" eval="False" />
        <field name="arch" type="xml"><form /></field>
    </record>

    <record model="ir.ui.view" id="stock_request_template_tree_v14">
        <field name="name">stock.request.template.tree</field>
        <field name="model">stock.request.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="priority" widget="priority" />
                <field name="active" optional="show" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_request_template_form_v14">
        <field name="name">stock.request.template.form</field>
        <field name="model">stock.request.template</field>
        <field name="arch" type="xml">
            <form string="Stock Request Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Template Name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Weekly Replenishment"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="priority" widget="priority" />
                            <field name="active" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Default request notes..." />
                    </group>
                    <notebook>
                        <page name="products" string="Products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field
                                        name="product_id"
                                        options="{'no_create': True}"
                                    />
                                    <field name="product_uom_qty" />
                                    <field
                                        name="product_uom_id"
                                        string="UOM"
                                        groups="uom.group_uom"
                                        optional="show"
                                    />
                                    <field name="company_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="stock_request_template_action">
        <field name="name">Templates</field>
        <field name="res_model">stock.request.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create reusable products and quantities for stock operations.
            </p>
        </field>
    </record>

    <record
        model="ir.actions.act_window.view"
        id="stock_request_template_action_list_view"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="stock_request_template_tree_v14" />
        <field name="act_window_id" ref="stock_request_template_action" />
    </record>

    <record
        model="ir.actions.act_window.view"
        id="stock_request_template_action_form_view"
    >
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock_request_template_form_v14" />
        <field name="act_window_id" ref="stock_request_template_action" />
    </record>
</odoo>
