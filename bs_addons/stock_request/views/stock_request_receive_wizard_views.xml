<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_request_receive_wizard_form" model="ir.ui.view">
        <field name="name">stock.request.receive.wizard.form</field>
        <field name="model">stock.request.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Receive Products">
                <group>
                    <field name="order_id" />
                    <field name="company_id" invisible="1" />
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="company_id" column_invisible="1" />
                        <field name="stock_request_id" column_invisible="1" />
                        <field name="product_id" />
                        <field name="remaining_quantity" />
                        <field name="quantity" />
                        <field name="product_uom_id" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_confirm_receipt"
                        string="Confirm Receipt"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
