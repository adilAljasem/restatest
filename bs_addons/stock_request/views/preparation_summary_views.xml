<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="preparation_summary_action" model="ir.actions.client">
        <field name="name">Preparation Summary</field>
        <field name="tag">stock_request.preparation_summary</field>
    </record>
    <record id="preparation_summary_list" model="ir.ui.view">
        <field name="name">stock.request.preparation.summary.list</field>
        <field name="model">stock.request.preparation.summary</field>
        <field name="arch" type="xml">
            <list string="Preparation Summary" create="0" edit="0" delete="0" import="0" export_xlsx="0"
                  js_class="stock_request_preparation_summary">
                <field name="company_id" options="{'no_open': True}"/>
                <field name="source_warehouse_id" options="{'no_open': True}"/>
                <field name="product_id" options="{'no_open': True}"/>
                <field name="code"/>
                <field name="product_uom_id" options="{'no_open': True}"/>
                <field name="quantity"/>
                <field name="order_count"/>
                <field name="row_key" column_invisible="True"/>
                <field name="report_domain" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="preparation_summary_search" model="ir.ui.view">
        <field name="name">stock.request.preparation.summary.search</field>
        <field name="model">stock.request.preparation.summary</field>
        <field name="arch" type="xml">
            <search string="Preparation Summary">
                <field name="source_warehouse_id"/>
                <field name="warehouse_id"/>
                <field name="product_id"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="request_date"/>
                <separator/>
                <filter name="request_date" string="Request Date" date="request_date"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_source" string="Source Warehouse" context="{'group_by': 'source_warehouse_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_code" string="Internal Reference" context="{'group_by': 'code'}"/>
                    <filter name="group_uom" string="Unit of Measure" context="{'group_by': 'product_uom_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="preparation_summary_list_action" model="ir.actions.act_window">
        <field name="name">Preparation Summary</field>
        <field name="res_model">stock.request.preparation.summary</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="preparation_summary_list"/>
        <field name="search_view_id" ref="preparation_summary_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
    <menuitem id="preparation_summary_menu" name="Preparation Summary"
              parent="menu_stock_request_root" action="preparation_summary_list_action"
              groups="stock_request.group_stock_request_warehouse_responsible,stock_request.group_stock_request_manager"
              sequence="28"/>
    <function model="res.config.settings" name="_sync_preparation_summary_menu"/>
</odoo>
