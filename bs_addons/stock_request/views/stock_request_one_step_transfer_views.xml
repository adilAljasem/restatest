<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_request_one_step_transfer_list" model="ir.ui.view">
        <field name="name">stock.request.order.one.step.transfer.list</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <list string="Transfer">
                <field name="name" string="Request Number" />
                <field name="expected_date" string="Expected Date" />
                <field name="source_warehouse_id" string="Source Warehouse" />
                <field name="warehouse_id" string="Destination Warehouse" />
                <field name="priority" string="Priority" widget="priority" />
                <field
                    name="one_step_transfer_state"
                    widget="badge"
                    decoration-info="one_step_transfer_state == 'draft'"
                    decoration-success="one_step_transfer_state == 'transferred'"
                    decoration-muted="one_step_transfer_state == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <record id="stock_request_one_step_transfer_form" model="ir.ui.view">
        <field name="name">stock.request.order.one.step.transfer.form</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <form string="Transfer">
                <header>
                    <button
                        name="action_confirm_one_step_transfer"
                        string="Confirm Transfer"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ('draft', 'ready') or not is_source_warehouse_responsible"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state != 'draft' or not is_source_warehouse_responsible"
                    />
                    <button
                        name="action_create_return"
                        string="Create Return"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'done' or is_return"
                    />
                    <field
                        name="one_step_transfer_state"
                        widget="statusbar"
                        statusbar_visible="draft,transferred,cancelled"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_source_request"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="not source_request_id"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Source Request</span>
                            </div>
                        </button>
                        <button
                            type="object"
                            name="action_view_returns"
                            class="oe_stat_button"
                            icon="fa-undo"
                            invisible="return_count == 0 or is_return"
                        >
                            <field name="return_count" widget="statinfo" string="Returns" />
                        </button>
                        <button
                            type="object"
                            name="action_view_transfers"
                            class="oe_stat_button"
                            icon="fa-exchange"
                            invisible="transfer_picking_count == 0"
                            groups="stock.group_stock_user"
                        >
                            <field
                                name="transfer_picking_count"
                                widget="statinfo"
                                string="Transfer"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Request Number" />
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="expected_date" string="Expected Date" readonly="state != 'draft'" />
                            <field
                                name="priority"
                                string="Priority"
                                widget="priority"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="source_request_id"
                                string="Source Document"
                                readonly="state != 'draft'"
                                options="{'no_create': True}"
                                domain="[('operation_type', '=', 'request'), ('company_id', '=', company_id)]"
                            />
                        </group>
                        <group>
                            <field
                                name="source_warehouse_id"
                                string="Source Warehouse"
                                required="1"
                                readonly="state != 'draft'"
                                options="{'no_create': True, 'no_open': True}"
                                domain="[('company_id', '=', company_id)]"
                            />
                            <field
                                name="warehouse_id"
                                string="Destination Warehouse"
                                required="1"
                                readonly="state != 'draft'"
                                options="{'no_create': True, 'no_open': True}"
                                domain="[('company_id', '=', company_id)]"
                            />
                            <field
                                name="template_id"
                                string="Template"
                                readonly="state != 'draft'"
                                options="{'no_create': True}"
                            />
                            <button
                                name="action_load_template"
                                string="Load Template"
                                type="object"
                                class="btn-secondary"
                                icon="fa-download"
                                invisible="state != 'draft' or not template_id"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>

                    <field name="state" invisible="1" />
                    <field name="requested_by" invisible="1" />
                    <field name="request_date" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="location_id" invisible="1" />
                    <field name="source_location_id" invisible="1" />
                    <field name="route_id" invisible="1" />
                    <field name="route_ids" invisible="1" />
                    <field name="operation_type" invisible="1" />
                    <field name="transfer_flow" invisible="1" />
                    <field name="procurement_group_id" invisible="1" />
                    <field name="move_ids" invisible="1" />
                    <field name="is_source_warehouse_responsible" invisible="1" />
                    <field name="transfer_picking_count" invisible="1" />
                    <field name="show_available_qty" invisible="1" />
                    <field name="is_return" invisible="1" />
                    <field name="return_count" invisible="1" />

                    <group string="Products">
                        <field
                            name="stock_request_ids"
                            nolabel="1"
                            colspan="2"
                            context="{
                                'default_expected_date': expected_date,
                                'default_warehouse_id': warehouse_id,
                                'default_location_id': location_id,
                                'default_source_location_id': source_location_id,
                                'default_route_id': route_id,
                                'default_procurement_group_id': procurement_group_id,
                                'default_company_id': company_id,
                                'default_requested_by': requested_by,
                                'default_state': state
                            }"
                            readonly="state != 'draft'"
                        >
                            <list editable="bottom">
                                <field name="product_id" context="{'stock_request_company_id': parent.company_id, 'stock_request_hide_kits': True}"
                                       domain="[('type', 'in', ['product', 'consu']), ('stock_request_is_kit', '=', False)]" />
                                <field name="allowed_uom_categ_id" column_invisible="1" />
                                <field
                                    name="product_uom_id"
                                    string="UOM"
                                    options="{'no_open': True, 'no_create': True}"
                                />
                                <field
                                    name="available_qty"
                                    string="Available Qty"
                                    optional="show"
                                    readonly="1"
                                    column_invisible="not parent.show_available_qty"
                                />
                                <field name="product_uom_qty" string="Quantity" />

                                <field name="name" column_invisible="1" />
                                <field name="expected_date" column_invisible="1" />
                                <field name="warehouse_id" column_invisible="1" />
                                <field name="location_id" column_invisible="1" />
                                <field name="source_location_id" column_invisible="1" />
                                <field name="route_id" column_invisible="1" />
                                <field name="route_ids" column_invisible="1" />
                                <field name="procurement_group_id" column_invisible="1" />
                                <field name="company_id" column_invisible="1" />
                                <field name="move_ids" column_invisible="1" />
                                <field name="allocation_ids" column_invisible="1" />
                            </list>
                        </field>
                    </group>
                    <group string="Notes">
                        <field
                            name="reason"
                            nolabel="1"
                            colspan="2"
                            placeholder="Add transfer notes..."
                            readonly="state != 'draft'"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_request_one_step_transfer_search" model="ir.ui.view">
        <field name="name">stock.request.order.one.step.transfer.search</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <search string="Transfer">
                <field name="name" string="Request Number" />
                <field name="requested_by" string="Requested By" />
                <field name="source_warehouse_id" string="Source Warehouse" />
                <field name="warehouse_id" string="Destination Warehouse" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Transferred" name="transferred" domain="[('state', '=', 'done')]" />
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]" />
                <group>
                    <filter
                        string="Source Warehouse"
                        name="group_source_warehouse"
                        context="{'group_by': 'source_warehouse_id'}"
                    />
                    <filter
                        string="Destination Warehouse"
                        name="group_destination_warehouse"
                        context="{'group_by': 'warehouse_id'}"
                    />
                    <filter
                        string="Request Date"
                        name="group_request_date"
                        context="{'group_by': 'request_date:month'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="stock_request_one_step_transfer_action" model="ir.actions.act_window">
        <field name="name">Transfer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.request.order</field>
        <field name="path">stock-transfer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="stock_request_one_step_transfer_list" />
        <field name="search_view_id" ref="stock_request_one_step_transfer_search" />
        <field name="domain">[("operation_type", "=", "transfer"), ("transfer_flow", "=", "one_step"), ("is_return", "=", False)]</field>
        <field name="context">{"default_operation_type": "transfer", "default_is_return": False}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a direct warehouse transfer in one step.
            </p>
        </field>
    </record>

    <record id="stock_request_one_step_transfer_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="stock_request_one_step_transfer_list" />
        <field name="act_window_id" ref="stock_request_one_step_transfer_action" />
    </record>

    <record id="stock_request_one_step_transfer_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock_request_one_step_transfer_form" />
        <field name="act_window_id" ref="stock_request_one_step_transfer_action" />
    </record>
</odoo>
