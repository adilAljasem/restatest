<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field eval="12" name="priority" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    type="object"
                    name="action_view_stock_request"
                    class="oe_stat_button"
                    icon="fa-chain"
                    invisible="stock_request_ids == []"
                >
                    <field
                        name="stock_request_count"
                        widget="statinfo"
                        string="Stock Requests"
                    />
                    <field name="stock_request_ids" invisible="1" />
                </button>
            </div>
            <field name="origin" position="after">
                <field
                    name="stock_request_order_id"
                    readonly="1"
                    invisible="not stock_request_order_id"
                />
                <field
                    name="stock_request_operation"
                    readonly="1"
                    invisible="not stock_request_operation"
                />
                <field
                    name="stock_request_validated_by_id"
                    readonly="1"
                    invisible="not stock_request_validated_by_id"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field
                    name="stock_request_validation_date"
                    readonly="1"
                    invisible="not stock_request_validation_date"
                />
            </field>
        </field>
    </record>
</odoo>
