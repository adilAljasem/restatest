<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_request_one_step_return_list" model="ir.ui.view">
        <field name="name">stock.request.order.one.step.return.list</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <list string="Returns">
                <field name="name" string="Return Number" />
                <field name="original_transfer_id" string="Original Transfer" />
                <field name="expected_date" string="Expected Date" />
                <field name="source_warehouse_id" string="Source Warehouse" />
                <field name="warehouse_id" string="Destination Warehouse" />
                <field name="priority" string="Priority" widget="priority" />
                <field
                    name="one_step_return_state"
                    widget="badge"
                    decoration-info="one_step_return_state == 'draft'"
                    decoration-success="one_step_return_state == 'returned'"
                    decoration-muted="one_step_return_state == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <record id="stock_request_one_step_return_form" model="ir.ui.view">
        <field name="name">stock.request.order.one.step.return.form</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <form string="Return">
                <header>
                    <button
                        name="action_confirm_one_step_return"
                        string="Confirm Return"
                        type="object"
                        class="oe_highlight"
                        invisible="state not in ('draft', 'ready') or not original_transfer_id or not is_source_warehouse_responsible"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state != 'draft' or not is_source_warehouse_responsible"
                    />
                    <field
                        name="one_step_return_state"
                        widget="statusbar"
                        statusbar_visible="draft,returned,cancelled"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_original_transfer"
                            class="oe_stat_button"
                            icon="fa-external-link"
                            invisible="not original_transfer_id"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Original Transfer</span>
                            </div>
                        </button>
                        <button
                            type="object"
                            name="action_view_transfers"
                            class="oe_stat_button"
                            icon="fa-exchange"
                            invisible="transfer_picking_count == 0"
                            groups="stock.group_stock_user"
                        >
                            <field name="transfer_picking_count" widget="statinfo" string="Return" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Return Number" />
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group>
                            <field
                                name="original_transfer_id"
                                string="Original Transfer"
                                required="1"
                                readonly="state != 'draft'"
                                force_save="1"
                                options="{'no_create': True}"
                            />
                            <field name="expected_date" string="Expected Date" readonly="state != 'draft'" />
                            <field name="priority" string="Priority" widget="priority" readonly="state != 'draft'" />
                        </group>
                        <group>
                            <field name="source_warehouse_id" string="Source Warehouse" readonly="1" force_save="1" />
                            <field name="warehouse_id" string="Destination Warehouse" readonly="1" force_save="1" />
                            <field name="company_id" groups="base.group_multi_company" readonly="1" />
                        </group>
                    </group>

                    <field name="state" invisible="1" />
                    <field name="requested_by" invisible="1" />
                    <field name="request_date" invisible="1" />
                    <field name="company_id" invisible="1" />
                    <field name="location_id" invisible="1" />
                    <field name="source_location_id" invisible="1" />
                    <field name="route_id" invisible="1" />
                    <field name="route_ids" invisible="1" />
                    <field name="operation_type" invisible="1" />
                    <field name="transfer_flow" invisible="1" />
                    <field name="procurement_group_id" invisible="1" />
                    <field name="move_ids" invisible="1" />
                    <field name="is_return" invisible="1" />
                    <field name="is_source_warehouse_responsible" invisible="1" />
                    <field name="transfer_picking_count" invisible="1" />
                    <field name="show_available_qty" invisible="1" />

                    <group string="Products">
                        <field
                            name="stock_request_ids"
                            nolabel="1"
                            colspan="2"
                            context="{
                                'default_expected_date': expected_date,
                                'default_warehouse_id': warehouse_id,
                                'default_location_id': location_id,
                                'default_source_location_id': source_location_id,
                                'default_route_id': route_id,
                                'default_procurement_group_id': procurement_group_id,
                                'default_company_id': company_id,
                                'default_requested_by': requested_by,
                                'default_state': state
                            }"
                            readonly="state != 'draft'"
                        >
                            <list editable="bottom" create="false">
                                <field name="product_id" readonly="1" force_save="1" />
                                <field name="allowed_uom_categ_id" column_invisible="1" />
                                <field name="product_uom_id" string="UOM" readonly="1" force_save="1" />
                                <field
                                    name="available_qty"
                                    string="Available Qty"
                                    optional="show"
                                    readonly="1"
                                    column_invisible="not parent.show_available_qty"
                                />
                                <field name="product_uom_qty" string="Quantity" />
                                <field name="name" column_invisible="1" />
                                <field name="expected_date" column_invisible="1" />
                                <field name="warehouse_id" column_invisible="1" />
                                <field name="location_id" column_invisible="1" />
                                <field name="source_location_id" column_invisible="1" />
                                <field name="route_id" column_invisible="1" />
                                <field name="route_ids" column_invisible="1" />
                                <field name="procurement_group_id" column_invisible="1" />
                                <field name="company_id" column_invisible="1" />
                                <field name="move_ids" column_invisible="1" />
                                <field name="allocation_ids" column_invisible="1" />
                            </list>
                        </field>
                    </group>
                    <group string="Notes">
                        <field
                            name="reason"
                            nolabel="1"
                            colspan="2"
                            placeholder="Add return notes..."
                            readonly="state != 'draft'"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_request_one_step_return_search" model="ir.ui.view">
        <field name="name">stock.request.order.one.step.return.search</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <search string="Returns">
                <field name="name" string="Return Number" />
                <field name="original_transfer_id" string="Original Transfer" />
                <field name="source_warehouse_id" string="Source Warehouse" />
                <field name="warehouse_id" string="Destination Warehouse" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Returned" name="returned" domain="[('state', '=', 'done')]" />
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]" />
                <group>
                    <filter string="Original Transfer" name="group_original_transfer" context="{'group_by': 'original_transfer_id'}" />
                    <filter string="Source Warehouse" name="group_source_warehouse" context="{'group_by': 'source_warehouse_id'}" />
                    <filter string="Destination Warehouse" name="group_destination_warehouse" context="{'group_by': 'warehouse_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="stock_request_one_step_return_action" model="ir.actions.act_window">
        <field name="name">Returns</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.request.order</field>
        <field name="path">stock-transfer-returns</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="stock_request_one_step_return_list" />
        <field name="search_view_id" ref="stock_request_one_step_return_search" />
        <field name="domain">[("is_return", "=", True), ("transfer_flow", "=", "one_step")]</field>
        <field name="context">{"default_is_return": True, "default_operation_type": "transfer"}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a full or partial return for a completed One Step transfer.
            </p>
        </field>
    </record>

    <record id="stock_request_one_step_return_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="stock_request_one_step_return_list" />
        <field name="act_window_id" ref="stock_request_one_step_return_action" />
    </record>

    <record id="stock_request_one_step_return_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock_request_one_step_return_form" />
        <field name="act_window_id" ref="stock_request_one_step_return_action" />
    </record>
</odoo>
