<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_request_purchase_requisition_form" model="ir.ui.view">
        <field name="name">purchase.requisition.form.stock.request.warehouse</field>
        <field name="model">purchase.requisition</field>
        <field
            name="inherit_id"
            ref="purchase_requisition.view_purchase_requisition_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='products']/field[@name='line_ids']"
                position="before"
            >
                <field name="stock_request_multi_warehouse_enabled" invisible="1" />
            </xpath>
            <xpath
                expr="//page[@name='products']/field[@name='line_ids']/list/field[@name='product_id']"
                position="after"
            >
                <field
                    name="warehouse_id"
                    domain="[('company_id', '=', parent.company_id)]"
                    options="{'no_create': True}"
                    column_invisible="not parent.stock_request_multi_warehouse_enabled"
                    optional="show"
                />
            </xpath>
            <xpath
                expr="//page[@name='products']/field[@name='line_ids']/form/group/field[@name='product_id']"
                position="after"
            >
                <field
                    name="warehouse_id"
                    domain="[('company_id', '=', parent.company_id)]"
                    options="{'no_create': True}"
                    invisible="not parent.stock_request_multi_warehouse_enabled"
                />
            </xpath>
        </field>
    </record>
</odoo>
