#. module: stock_request
#. odoo-javascript
#: code:addons/stock_request/static/src/preparation_summary.xml:0
msgid "Two Step without Transit"
msgstr "خطوتان دون موقع تحويل"


#. module: stock_request
msgid ""
"Two Step without Transit cannot be delivered when stock transfers already "
"exist."
msgstr ""
"لا يمكن تسجيل تسليم «خطوتان دون موقع تحويل» عند وجود تحويلات مخزون بالفعل."


#. module: stock_request
msgid "Unit"
msgstr "الوحدة"


