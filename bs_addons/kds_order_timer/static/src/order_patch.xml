<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="kds_order_timer.Order" t-inherit="pos_enterprise.Order" t-inherit-mode="extension">
        <!-- رقم الطلب بين قوسين بجوار رقم الطاولة -->
        <xpath expr="//div[hasclass('o_pdis_tracking_number')]" position="attributes">
            <attribute name="class" add="d-flex align-items-center gap-1" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_pdis_tracking_number')]" position="inside">
            <span t-if="kdsShortNumber" class="kds-order-no">(<t t-esc="kdsShortNumber"/>)</span>
        </xpath>
        <!-- استبدال الدقائق بعدّاد دقائق:ثواني -->
        <xpath expr="//div[hasclass('o_pdis_alert-timer')]//span" position="attributes">
            <attribute name="t-esc">isLastStage ? this.props.order.prepOrder.completion_time : kdsDurationDisplay</attribute>
            <attribute name="class">kds-timer</attribute>
        </xpath>
    </t>
</templates>
