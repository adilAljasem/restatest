<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_employee_loans" model="ir.ui.view">
        <field name="name">res.config.settings.form.employee.loans</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Employee Loans" id="employee_loan_settings">
                    <setting
                        string="Loan Account"
                        company_dependent="1"
                        help="Account used for employee loan disbursements and collections."
                        groups="account.group_account_manager"
                    >
                        <field
                            name="employee_loan_account_id"
                            domain="[('active', '=', True)]"
                            options="{'no_create': True}"
                        />
                    </setting>
                    <setting
                        string="Salary Input Type"
                        company_dependent="1"
                        help="Salary Adjustment input type used to deduct loan installments from payroll."
                        groups="account.group_account_manager"
                    >
                        <field
                            name="employee_loan_salary_input_type_id"
                            domain="[('available_in_attachments', '=', True)]"
                            options="{'no_create': True}"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
