<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_loan_view_list" model="ir.ui.view">
        <field name="name">employee.loan.list</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <list string="Loan Requests" multi_edit="1">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id" optional="show"/>
                <field name="loan_amount" sum="Total"/>
                <field name="total_paid_amount" sum="Total Paid"/>
                <field name="balance_amount" sum="Balance"/>
                <field name="request_date"/>
                <field name="applicant_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="employee_loan_view_search" model="ir.ui.view">
        <field name="name">employee.loan.search</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <search string="Loan Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="applicant_id"/>
                <field name="department_id"/>
                <filter name="my_requests" string="My Requests" domain="[('applicant_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="waiting" string="Waiting Approve" domain="[('state', '=', 'waiting')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter name="employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="state_group" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="employee_loan_view_form" model="ir.ui.view">
        <field name="name">employee.loan.form</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <form string="Loan Request">
                <header>
                    <button
                        name="action_compute_installments"
                        type="object"
                        string="Compute Installment"
                        class="btn-secondary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_send_to_approve"
                        type="object"
                        string="Send to Approve"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        invisible="state != 'waiting'"
                        groups="employee_loan_management.group_employee_loan_approver,account.group_account_manager"
                    />
                    <button
                        name="action_open_payment_wizard"
                        type="object"
                        string="Pay"
                        class="btn-primary"
                        invisible="state != 'approved' or disbursement_payment_id"
                        groups="account.group_account_user"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,waiting,approved"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_disbursement_payment"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="not disbursement_payment_id"
                            groups="account.group_account_user"
                        >
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Loan Payment</span>
                            </div>
                        </button>
                        <button
                            name="action_view_installment_payments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                            invisible="not installment_payment_count"
                            groups="account.group_account_user"
                        >
                            <field name="installment_payment_count" widget="statinfo" string="Installment Payments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" text="Paid to Employee" bg_color="text-bg-success" invisible="not is_disbursed"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="applicant_id" widget="many2one_avatar_user"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="loan_amount" readonly="state != 'draft'"/>
                            <field name="no_of_installments" readonly="state != 'draft'"/>
                            <field name="payment_start_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="disbursement_payment_id" invisible="1"/>
                            <field name="is_disbursed" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installments" name="installments">
                            <field name="installment_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" readonly="parent.state != 'draft'"/>
                                    <field name="payment_date" readonly="parent.state != 'draft'"/>
                                    <field name="amount" sum="Total" readonly="parent.state != 'draft'"/>
                                    <field name="paid" widget="boolean_toggle" readonly="1"/>
                                    <field name="salary_deduction" readonly="paid or payroll_state != 'none'"/>
                                    <field name="payroll_state" widget="badge" optional="show"/>
                                    <field name="salary_attachment_id" optional="hide"/>
                                    <field name="payroll_payslip_id" optional="hide"/>
                                    <field name="payment_id" optional="hide"/>
                                    <button
                                        name="action_open_payment_wizard"
                                        type="object"
                                        string="Pay"
                                        icon="fa-money"
                                        invisible="parent.state != 'approved' or not parent.is_disbursed or paid or payroll_state != 'none'"
                                        groups="account.group_account_user"
                                    />
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" col="2">
                                <field name="loan_amount" string="Total Amount" readonly="1"/>
                                <field name="total_paid_amount" readonly="1"/>
                                <field name="balance_amount" readonly="1" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_employee_loan_requests" model="ir.actions.act_window">
        <field name="name">Loan Requests</field>
        <field name="res_model">employee.loan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="employee_loan_view_search"/>
    </record>

    <record id="action_accounting_employee_loans" model="ir.actions.act_window">
        <field name="name">Employee Loans</field>
        <field name="res_model">employee.loan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="employee_loan_view_search"/>
        <field name="domain">[('state', '=', 'approved')]</field>
        <field name="context">{'search_default_approved': 1}</field>
    </record>
</odoo>
