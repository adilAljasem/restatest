<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_loan_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">employee.loan.payment.wizard.form</field>
        <field name="model">employee.loan.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Pay Loan">
                <group>
                    <group>
                        <field name="payment_kind" invisible="1"/>
                        <field name="payment_type" invisible="1"/>
                        <field name="loan_id" invisible="1"/>
                        <field name="installment_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="employee_id"/>
                        <field name="loan_reference"/>
                        <field name="amount"/>
                        <field name="payment_date"/>
                    </group>
                    <group>
                        <field name="loan_account_id"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field
                            name="payment_method_line_id"
                            options="{'no_create': True}"
                        />
                    </group>
                </group>
                <footer>
                    <button
                        name="action_create_payment"
                        type="object"
                        string="Create Payment"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
