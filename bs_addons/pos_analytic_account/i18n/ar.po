#. module: pos_analytic_account
#: model:ir.model.fields,field_description:pos_analytic_account.field_pos_order__pos_analytic_account_id
msgid "POS Analytic Account"
msgstr "الحساب التحليلي لنقطة البيع"

#. module: pos_analytic_account
#: model_terms:ir.ui.view,arch_db:pos_analytic_account.pos_config_view_form_analytic_account
msgid "Apply this analytic account automatically to eligible POS revenue and expense entries."
msgstr "تطبيق هذا الحساب التحليلي تلقائيًا على بنود إيرادات ومصروفات نقطة البيع المناسبة."

#. module: pos_analytic_account
#: model_terms:ir.ui.view,arch_db:pos_analytic_account.pos_config_view_form_analytic_account
msgid "Leave empty to keep the standard Point of Sale accounting behavior."
msgstr "اترك الحقل فارغًا للاحتفاظ بالسلوك المحاسبي القياسي لنقطة البيع."

#. module: pos_analytic_account
#: model_terms:ir.ui.view,arch_db:pos_analytic_account.pos_config_view_form_analytic_account
msgid "Select an analytic account..."
msgstr "اختر حسابًا تحليليًا..."

#. module: pos_analytic_account
#: code:addons/pos_analytic_account/models/pos_config.py:0
msgid "The analytic account must belong to the same company as the Point of Sale."
msgstr "يجب أن يتبع الحساب التحليلي نفس شركة نقطة البيع."

#. module: pos_analytic_account
#: model:ir.model.fields,help:pos_analytic_account.field_pos_config__analytic_account_id
msgid "Applied at 100% to eligible profit and loss lines generated by this Point of Sale. Leave empty to keep the standard Odoo behavior."
msgstr "يُطبّق بنسبة 100٪ على بنود الأرباح والخسائر المناسبة الناتجة من نقطة البيع. اتركه فارغًا للاحتفاظ بالسلوك القياسي للنظام."

#. module: pos_analytic_account
#: model:ir.model.fields,help:pos_analytic_account.field_pos_order__pos_analytic_account_id
msgid "Analytic account captured from the Point of Sale when the order was created."
msgstr "الحساب التحليلي المحفوظ من نقطة البيع عند إنشاء الطلب."
