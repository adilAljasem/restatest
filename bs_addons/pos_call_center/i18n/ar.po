#. odoo-python
#: code:addons/pos_call_center/models/pos_order.py:0
msgid "The order was not found, please try again."
msgstr "لم يتم العثور على الطلب، حاول مرة أخرى."

#. module: pos_call_center
#: model_terms:ir.ui.view,arch_db:pos_call_center.view_pos_call_center_form
msgid ""
"This call center has no POS for the agents yet. Click <strong>Create Call Center POS</strong>\n"
"                        (or choose an existing POS in the field \"Call Center POS\") so agents can take orders."
msgstr ""
"لا توجد شاشة لموظفي هذا الكول سنتر بعد. اضغط <strong>إنشاء شاشة الكول "
"سنتر</strong> (أو اختر نقطة بيع موجودة في حقل \"شاشة الكول سنتر\") ليتمكن "
"الموظفون من تسجيل الطلبات."

#. module: pos_call_center
#. odoo-python
#: code:addons/pos_call_center/models/pos_order.py:0
