<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_call_center" model="res.groups.privilege">
        <field name="name">Call Center</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_call_center_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_call_center"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_call_center_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_call_center"/>
        <field name="implied_ids" eval="[(4, ref('group_call_center_agent'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Agents only see their own call centers and their orders -->
    <record id="rule_call_center_agent" model="ir.rule">
        <field name="name">Call Center: agent sees own call centers</field>
        <field name="model_id" ref="model_pos_call_center"/>
        <field name="domain_force">[('user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_call_center_agent'))]"/>
    </record>
    <record id="rule_call_center_manager" model="ir.rule">
        <field name="name">Call Center: manager sees all</field>
        <field name="model_id" ref="model_pos_call_center"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_call_center_manager'))]"/>
    </record>
    <!-- Multi-company -->
    <record id="rule_call_center_company" model="ir.rule">
        <field name="name">Call Center: multi-company</field>
        <field name="model_id" ref="model_pos_call_center"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
