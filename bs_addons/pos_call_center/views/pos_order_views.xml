<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Call center information on the standard POS order form -->
    <record id="view_pos_order_form_call_center" model="ir.ui.view">
        <field name="name">pos.order.form.call.center</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='extra']" position="after">
                <page string="Call Center" name="call_center" invisible="not cc_call_center_id">
                    <group>
                        <group>
                            <field name="cc_ref"/>
                            <field name="cc_call_center_id"/>
                            <field name="cc_agent_id"/>
                            <field name="cc_origin_config_id"/>
                            <field name="cc_zone_id"/>
                        </group>
                        <group>
                            <field name="cc_status"/>
                            <field name="cc_dispatch_date"/>
                            <field name="cc_kitchen_state"/>
                            <field name="cc_kitchen_date"/>
                            <field name="cc_transfer_count"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_cc_pos_order_list" model="ir.ui.view">
        <field name="name">pos.order.list.call.center</field>
        <field name="model">pos.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="cc_status == 'dispatched'" decoration-warning="cc_status == 'kitchen'"
                  decoration-success="cc_status == 'paid'" decoration-muted="cc_status == 'cancel'">
                <header>
                    <button name="%(action_open_my_terminal)d" type="action" string="Take Orders"
                            class="btn-primary" display="always"/>
                </header>
                <field name="cc_ref"/>
                <field name="cc_dispatch_date"/>
                <field name="cc_call_center_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="mobile" optional="show"/>
                <field name="preset_id" optional="show"/>
                <field name="config_id" string="Branch"/>
                <field name="tracking_number" optional="show"/>
                <field name="cc_agent_id" widget="many2one_avatar_user" optional="show"/>
                <field name="cc_kitchen_date" optional="hide"/>
                <field name="cc_transfer_count" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cc_status" widget="badge"
                       decoration-info="cc_status == 'dispatched'" decoration-warning="cc_status == 'kitchen'"
                       decoration-success="cc_status == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_cc_pos_order_kanban" model="ir.ui.view">
        <field name="name">pos.order.kanban.call.center</field>
        <field name="model">pos.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <kanban create="0" default_group_by="cc_status" group_create="false" records_draggable="false">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="cc_ref" class="fw-bold"/>
                            <field name="amount_total" widget="monetary"/>
                        </div>
                        <field name="partner_id"/>
                        <div class="d-flex justify-content-between text-muted">
                            <field name="config_id"/>
                            <field name="preset_id"/>
                        </div>
                        <footer>
                            <field name="cc_agent_id" widget="many2one_avatar_user"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_cc_pos_order_search" model="ir.ui.view">
        <field name="name">pos.order.search.call.center</field>
        <field name="model">pos.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="cc_ref"/>
                <field name="partner_id"/>
                <field name="mobile"/>
                <field name="config_id" string="Branch"/>
                <field name="cc_call_center_id"/>
                <field name="cc_agent_id"/>
                <filter name="my_orders" string="My Orders" domain="[('cc_agent_id', '=', uid)]"/>
                <separator/>
                <filter name="dispatched" string="Sent to Branch" domain="[('cc_status', '=', 'dispatched')]"/>
                <filter name="kitchen" string="In Kitchen" domain="[('cc_status', '=', 'kitchen')]"/>
                <filter name="paid" string="Paid" domain="[('cc_status', '=', 'paid')]"/>
                <filter name="cancel" string="Cancelled" domain="[('cc_status', '=', 'cancel')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('cc_dispatch_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'cc_status'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'config_id'}"/>
                    <filter name="group_center" string="Call Center" context="{'group_by': 'cc_call_center_id'}"/>
                    <filter name="group_agent" string="Agent" context="{'group_by': 'cc_agent_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'cc_dispatch_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cc_pos_orders" model="ir.actions.act_window">
        <field name="name">Call Center Orders</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('cc_call_center_id', '!=', False)]</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="search_view_id" ref="view_cc_pos_order_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_cc_pos_order_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_cc_pos_order_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('point_of_sale.view_pos_pos_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No call center order yet</p>
            <p>Open the call center POS, take the order and click "Send to Branch".</p>
        </field>
    </record>
</odoo>
