<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">account.account.form.bs.analytic.rate</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="bs_include_in_analytic_rate"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_list" model="ir.ui.view">
        <field name="name">account.account.list.bs.analytic.rate</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="bs_include_in_analytic_rate" optional="hide"
                       widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
