<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bs_delivery_order_binding_form" model="ir.ui.view">
        <field name="name">bs.delivery.order.binding.form</field>
        <field name="model">bs.delivery.order.binding</field>
        <field name="arch" type="xml">
            <form string="Delivery Order" create="false" edit="false" delete="false">
                <header>
                    <field name="sync_state"
                           widget="statusbar"
                           statusbar_visible="pending,synced,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list-alt">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="external_order_id"/>
                        <h1><field name="external_order_id"/></h1>
                    </div>
                    <group>
                        <group string="Integration">
                            <field name="provider_id"/>
                            <field name="connection_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="external_source"/>
                        </group>
                        <group string="Order">
                            <field name="pos_order_id"/>
                            <field name="external_reference"/>
                            <field name="external_status"/>
                            <field name="odoo_status"/>
                            <field name="last_sync_date"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bs_delivery_order_binding_list" model="ir.ui.view">
        <field name="name">bs.delivery.order.binding.list</field>
        <field name="model">bs.delivery.order.binding</field>
        <field name="arch" type="xml">
            <list string="Delivery Orders" create="false" edit="false" delete="false">
                <field name="external_order_id"/>
                <field name="external_reference" optional="hide"/>
                <field name="external_source" optional="show"/>
                <field name="provider_id"/>
                <field name="connection_id"/>
                <field name="pos_order_id"/>
                <field name="external_status" optional="show"/>
                <field name="odoo_status" widget="badge"/>
                <field name="sync_state"
                       widget="badge"
                       decoration-success="sync_state == 'synced'"
                       decoration-warning="sync_state == 'pending'"
                       decoration-danger="sync_state == 'error'"/>
                <field name="last_sync_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bs_delivery_order_binding_search" model="ir.ui.view">
        <field name="name">bs.delivery.order.binding.search</field>
        <field name="model">bs.delivery.order.binding</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_order_id"/>
                <field name="external_reference"/>
                <field name="external_source"/>
                <field name="provider_id"/>
                <field name="connection_id"/>
                <field name="pos_order_id"/>
                <filter name="pending" string="Pending" domain="[('sync_state', '=', 'pending')]"/>
                <filter name="errors" string="Errors" domain="[('sync_state', '=', 'error')]"/>
                <filter name="synced" string="Synced" domain="[('sync_state', '=', 'synced')]"/>
                <group>
                    <filter name="group_provider"
                            string="Provider"
                            context="{'group_by': 'provider_id'}"/>
                    <filter name="group_connection"
                            string="Connection"
                            context="{'group_by': 'connection_id'}"/>
                    <filter name="group_status"
                            string="Status"
                            context="{'group_by': 'odoo_status'}"/>
                    <filter name="group_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bs_delivery_order_binding" model="ir.actions.act_window">
        <field name="name">Delivery Orders</field>
        <field name="res_model">bs.delivery.order.binding</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bs_delivery_order_binding_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No external delivery orders yet.</p>
            <p>Bindings are created automatically by installed provider adapters.</p>
        </field>
    </record>
</odoo>

