<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bs_delivery_outbox_form" model="ir.ui.view">
        <field name="name">bs.delivery.outbox.form</field>
        <field name="model">bs.delivery.outbox</field>
        <field name="arch" type="xml">
            <form string="Delivery Outgoing Job" create="false" edit="false" delete="false">
                <header>
                    <button name="action_retry"
                            type="object"
                            string="Retry"
                            class="btn-primary"
                            invisible="state != 'failed'"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            confirm="This outgoing job will not be processed automatically. Continue?"
                            invisible="state not in ('queued', 'retry', 'failed')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="queued,processing,retry,done,failed,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group string="Integration">
                            <field name="provider_id"/>
                            <field name="connection_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="binding_id"/>
                            <field name="external_id"/>
                        </group>
                        <group string="Operation">
                            <field name="operation"/>
                            <field name="status_value"/>
                            <field name="reason"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <group>
                        <group string="Processing">
                            <field name="attempt_count"/>
                            <field name="max_attempts"/>
                            <field name="last_attempt_at"/>
                            <field name="next_attempt_at"/>
                            <field name="processed_at"/>
                        </group>
                        <group string="Traceability">
                            <field name="correlation_id"/>
                            <field name="idempotency_key"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Result" name="result">
                            <field name="result_payload" nolabel="1" class="font-monospace"/>
                        </page>
                        <page string="Last Error" name="error" invisible="not last_error">
                            <field name="last_error" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bs_delivery_outbox_list" model="ir.ui.view">
        <field name="name">bs.delivery.outbox.list</field>
        <field name="model">bs.delivery.outbox</field>
        <field name="arch" type="xml">
            <list string="Delivery Outgoing Queue" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="provider_id"/>
                <field name="connection_id"/>
                <field name="operation"/>
                <field name="external_id"/>
                <field name="status_value" optional="show"/>
                <field name="binding_id" optional="hide"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at" optional="show"/>
                <field name="correlation_id" optional="hide"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'queued'"
                       decoration-warning="state in ('processing', 'retry')"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bs_delivery_outbox_search" model="ir.ui.view">
        <field name="name">bs.delivery.outbox.search</field>
        <field name="model">bs.delivery.outbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_id"/>
                <field name="correlation_id"/>
                <field name="provider_id"/>
                <field name="connection_id"/>
                <field name="binding_id"/>
                <filter name="queued" string="Queued" domain="[('state', 'in', ('queued', 'retry'))]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_id'}"/>
                    <filter name="group_connection" string="Connection" context="{'group_by': 'connection_id'}"/>
                    <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bs_delivery_outbox" model="ir.actions.act_window">
        <field name="name">Delivery Outgoing Queue</field>
        <field name="res_model">bs.delivery.outbox</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bs_delivery_outbox_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No outgoing operations are queued.</p>
            <p>Enable queued mode on a connection to get durable retries and traceability.</p>
        </field>
    </record>
</odoo>
