<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bs_delivery_sync_log_form" model="ir.ui.view">
        <field name="name">bs.delivery.sync.log.form</field>
        <field name="model">bs.delivery.sync.log</field>
        <field name="arch" type="xml">
            <form string="Delivery Synchronization Log"
                  create="false"
                  edit="false"
                  delete="false">
                <header>
                    <button name="action_retry_processing"
                            type="object"
                            string="Retry Processing"
                            class="btn-primary"
                            groups="bs_pos_delivery_core.group_delivery_integration_manager"
                            invisible="not can_retry_processing"/>
                    <field name="can_retry_processing" invisible="1"/>
                    <field name="can_force_send" invisible="1"/>
                    <button name="action_force_send_to_branch"
                            type="object"
                            string="Force Send to Branch"
                            class="btn-danger"
                            icon="fa-paper-plane"
                            groups="bs_pos_delivery_core.group_delivery_manager,bs_pos_delivery_core.group_delivery_integration_manager"
                            invisible="not can_force_send"
                            confirm="Send this order to the branch cashier and kitchen even though Odoo rejected it? Amounts will follow the Odoo product prices and taxes. Confirm with the platform that the order is still live before sending."/>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="pending,success,failed"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <strong>Failure Reason</strong>
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group string="Integration">
                            <field name="provider_id"/>
                            <field name="connection_id"/>
                            <field name="binding_id"/>
                            <field name="webhook_event_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="direction"/>
                            <field name="operation"/>
                            <field name="external_id"/>
                            <field name="correlation_id"/>
                        </group>
                        <group string="HTTP">
                            <field name="request_method"/>
                            <field name="request_url" widget="url"/>
                            <field name="http_status"/>
                            <field name="duration_ms"/>
                            <field name="attempt_number"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_payload"
                                   nolabel="1"
                                   class="font-monospace"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_payload"
                                   nolabel="1"
                                   class="font-monospace"/>
                        </page>
                        <page string="Error" name="error" invisible="not error_message">
                            <field name="error_message" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bs_delivery_sync_log_list" model="ir.ui.view">
        <field name="name">bs.delivery.sync.log.list</field>
        <field name="model">bs.delivery.sync.log</field>
        <field name="arch" type="xml">
            <list string="Delivery Logs" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="provider_id"/>
                <field name="connection_id"/>
                <field name="direction" widget="badge"/>
                <field name="operation"/>
                <field name="external_id" optional="show"/>
                <field name="correlation_id" optional="hide"/>
                <field name="binding_id" optional="hide"/>
                <field name="webhook_event_id" optional="hide"/>
                <field name="request_method" optional="show"/>
                <field name="http_status" optional="show"/>
                <field name="duration_ms" optional="hide"/>
                <field name="attempt_number" optional="show"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'success'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'failed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bs_delivery_sync_log_search" model="ir.ui.view">
        <field name="name">bs.delivery.sync.log.search</field>
        <field name="model">bs.delivery.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="operation"/>
                <field name="external_id"/>
                <field name="correlation_id"/>
                <field name="provider_id"/>
                <field name="connection_id"/>
                <field name="binding_id"/>
                <field name="webhook_event_id"/>
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <filter name="success" string="Success" domain="[('status', '=', 'success')]"/>
                <separator/>
                <filter name="incoming" string="Incoming" domain="[('direction', '=', 'incoming')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'outgoing')]"/>
                <group>
                    <filter name="group_provider"
                            string="Provider"
                            context="{'group_by': 'provider_id'}"/>
                    <filter name="group_connection"
                            string="Connection"
                            context="{'group_by': 'connection_id'}"/>
                    <filter name="group_operation"
                            string="Operation"
                            context="{'group_by': 'operation'}"/>
                    <filter name="group_status"
                            string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bs_delivery_sync_log" model="ir.actions.act_window">
        <field name="name">Delivery Logs</field>
        <field name="res_model">bs.delivery.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bs_delivery_sync_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No synchronization attempts yet.</p>
            <p>Requests and responses are masked before they are stored.</p>
        </field>
    </record>

    <record id="action_bs_delivery_sync_log_retry_bulk" model="ir.actions.server">
        <field name="name">Retry Processing</field>
        <field name="model_id" ref="model_bs_delivery_sync_log"/>
        <field name="binding_model_id" ref="model_bs_delivery_sync_log"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('bs_pos_delivery_core.group_delivery_integration_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_retry_processing_bulk()</field>
    </record>
</odoo>
