    <menuitem id="menu_bs_delivery_stores" name="Store Mapping"
              parent="menu_bs_delivery_settings" action="action_bs_delivery_store_binding"
              sequence="20" groups="group_delivery_manager"/>
    <menuitem id="menu_bs_delivery_reject_reasons" name="Rejection Reasons"
