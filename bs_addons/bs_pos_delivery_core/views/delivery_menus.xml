              parent="menu_bs_delivery_settings" action="action_bs_delivery_payment_binding"
              sequence="70" groups="group_delivery_manager" active="False"/>
    <menuitem id="menu_bs_delivery_menu_sync" name="Menu Synchronization"
              parent="menu_bs_delivery_settings" action="action_bs_delivery_menu_version"
