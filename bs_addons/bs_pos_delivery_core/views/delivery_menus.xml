<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_open_bs_delivery_provider_catalog" model="ir.actions.server">
        <field name="name">Delivery Integrations</field>
        <field name="model_id" ref="model_bs_delivery_provider"/>
        <field name="group_ids" eval="[(4, ref('group_delivery_integration_manager'))]"/>
        <field name="state">code</field>
        <field name="code">
            action = env['bs.delivery.provider'].action_open_provider_catalog()
        </field>
    </record>

    <menuitem id="menu_bs_delivery_root" name="Connect"
              sequence="61" web_icon="bs_pos_delivery_core,static/description/icon.png"
              groups="group_delivery_viewer"/>
    <menuitem id="menu_bs_delivery_dashboard" name="Dashboard"
              parent="menu_bs_delivery_root" action="action_bs_delivery_dashboard"
              sequence="10" groups="group_delivery_viewer"/>
    <menuitem id="menu_bs_delivery_orders_new" name="NEW Orders"
              parent="menu_bs_delivery_root" action="action_bs_delivery_order_new"
              sequence="20" groups="group_delivery_operator"/>
    <menuitem id="menu_bs_delivery_orders" name="All Orders"
              parent="menu_bs_delivery_root" action="action_bs_delivery_order"
              sequence="30" groups="group_delivery_viewer"/>
    <menuitem id="menu_bs_delivery_connections" name="Platforms"
              parent="menu_bs_delivery_root" action="action_bs_delivery_connection"
              sequence="40" groups="group_delivery_manager"/>
    <menuitem id="menu_bs_delivery_product_mapping" name="Menu Mapping"
              parent="menu_bs_delivery_root" action="action_bs_delivery_product_binding"
              sequence="50" groups="group_delivery_manager" active="False"/>
    <menuitem id="menu_bs_delivery_webhook_events" name="Webhook Log"
              parent="menu_bs_delivery_root" action="action_bs_delivery_webhook_event"
              sequence="70" groups="group_delivery_integration_manager"/>
