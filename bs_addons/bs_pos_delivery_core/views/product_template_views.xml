<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_delivery" model="ir.ui.view">
        <field name="name">product.template.form.delivery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_delivery_sync_product"
                            string="Sync to Delivery"
                            type="object"
                            class="btn-secondary"
                            groups="bs_pos_delivery_core.group_delivery_manager"/>
                </header>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="delivery_available" invisible="1"/>
                <button name="action_delivery_toggle_availability"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cutlery">
                    <div class="o_stat_info">
                        <span class="o_stat_text text-success" invisible="not delivery_available">Available in Delivery</span>
                        <span class="o_stat_text text-danger" invisible="delivery_available">Closed in Delivery</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex ms-2">
                    <field name="delivery_available"/>
                    <label for="delivery_available" string="Delivery Platforms"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_delivery" model="ir.ui.view">
        <field name="name">product.template.list.delivery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="delivery_available" optional="show" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>

