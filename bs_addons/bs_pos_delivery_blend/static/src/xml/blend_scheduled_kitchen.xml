<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="pos_enterprise.Order" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pdis_table-info')]" position="after">
            <div t-if="this.order.pos_order_id.blend_aggregator and !this.order.pos_order_id.kitchen_delivery_app"
                 class="o_blend_kitchen_aggregator d-flex justify-content-between gap-2 px-2 pt-2">
                <span class="text-muted">App / التطبيق</span>
                <strong class="text-break text-end" t-esc="this.order.pos_order_id.blend_aggregator"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'customer-note')]" position="attributes">
            <attribute name="t-att-class">{'bg-warning text-dark fs-5 fw-bold': this.order.pos_order_id.blend_schedule_at}</attribute>
        </xpath>
    </t>
</templates>

