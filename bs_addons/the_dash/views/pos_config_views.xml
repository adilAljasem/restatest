<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_the_dash" model="ir.ui.view">
        <field name="name">pos.config.form.the.dash</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <group string="The Dash">
                    <field name="dash_cost_center_id" options="{'no_create': True}"/>
                    <field name="dash_region_id"/>
                    <div colspan="2" class="text-muted" style="font-size:.85rem">
                        <i class="fa fa-info-circle me-1" role="img"
                           aria-label="Info" title="Info"/>
                        The Dash opens every branch from a single link. There is
                        nothing to generate here - use the
                        <strong>The Dash</strong> menu.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
