<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_tracking_push" model="ir.cron">
        <field name="name">POS Order Tracking: send web push notifications</field>
        <field name="model_id" ref="model_pos_tracking_push"/>
        <field name="state">code</field>
        <field name="code">model._process_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_tracking_ready_repeat" model="ir.cron">
        <field name="name">POS Order Tracking: repeat the ready alert</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_tracking_ready_repeat()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_tracking_nps_reminder" model="ir.cron">
        <field name="name">POS Order Tracking: NPS survey reminder</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_tracking_nps_reminder()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
