<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_correction_user" model="ir.rule">
            <field name="name">ESS correction: own / approver</field>
            <field name="model_id" ref="model_bs_hr_attendance_correction"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('current_approver_ids', 'in', [user.id])]</field>
        </record>
        <record id="rule_correction_hr" model="ir.rule">
            <field name="name">ESS correction: HR</field>
            <field name="model_id" ref="model_bs_hr_attendance_correction"/>
            <field name="groups" eval="[(4, ref('bs_hr_ess_base.group_ess_hr_officer'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_attempt_supervisor" model="ir.rule">
            <field name="name">ESS attempts: branches managed</field>
            <field name="model_id" ref="model_bs_hr_attendance_attempt"/>
            <field name="groups" eval="[(4, ref('bs_hr_ess_base.group_ess_branch_supervisor'))]"/>
            <field name="domain_force">['|', ('location_id.ess_manager_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_attempt_hr" model="ir.rule">
            <field name="name">ESS attempts: HR</field>
            <field name="model_id" ref="model_bs_hr_attendance_attempt"/>
            <field name="groups" eval="[(4, ref('bs_hr_ess_base.group_ess_hr_officer'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_device_company" model="ir.rule">
            <field name="name">ESS devices: company</field>
            <field name="model_id" ref="model_bs_hr_ess_device"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
