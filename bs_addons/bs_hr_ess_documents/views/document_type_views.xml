<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_type_list" model="ir.ui.view">
        <field name="name">bs.hr.document.type.list</field>
        <field name="model">bs.hr.document.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="alert_days"/>
                <field name="block_attendance"/>
                <field name="mandatory_for"/>
                <field name="job_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_document_type_form" model="ir.ui.view">
        <field name="name">bs.hr.document.type.form</field>
        <field name="model">bs.hr.document.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="alert_days"/>
                            <field name="block_attendance"/>
                        </group>
                        <group>
                            <field name="mandatory_for"/>
                            <field name="job_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">bs.hr.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
