<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_document_renewal" model="ir.sequence">
        <field name="name">ESS Document Renewal</field>
        <field name="code">bs.hr.document.renewal</field>
        <field name="prefix">DOC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_contract_renewal" model="ir.sequence">
        <field name="name">ESS Contract Renewal</field>
        <field name="code">bs.hr.contract.renewal</field>
        <field name="prefix">CTR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
