<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bonat_order_attempt_list" model="ir.ui.view">
        <field name="name">x.bonat.order.attempt.list</field>
        <field name="model">x_bonat_order_attempt</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="x_attempted_at desc">
                <field name="x_attempted_at"/>
                <field name="x_order_id"/>
                <field name="x_attempt_number"/>
                <field name="x_result"/>
                <field name="x_http_status"/>
                <field name="x_duration_ms"/>
            </list>
        </field>
    </record>
    <record id="view_bonat_order_attempt_form" model="ir.ui.view">
        <field name="name">x.bonat.order.attempt.form</field>
        <field name="model">x_bonat_order_attempt</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="x_order_id"/>
                        <field name="x_attempt_number"/>
                        <field name="x_delivery_key"/>
                        <field name="x_attempted_at"/>
                        <field name="x_result"/>
                        <field name="x_http_status"/>
                        <field name="x_duration_ms"/>
                    </group>
                    <group>
                        <field name="x_request" widget="text"/>
                        <field name="x_response" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_bonat_order_attempt_search" model="ir.ui.view">
        <field name="name">x.bonat.order.attempt.search</field>
        <field name="model">x_bonat_order_attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_order_id"/>
                <field name="x_delivery_key"/>
                <field name="x_result"/>
                <filter name="failed" string="Failed" domain="[('x_result', '=', 'failed')]"/>
            </search>
        </field>
    </record>
    <record id="action_bonat_order_attempt" model="ir.actions.act_window">
        <field name="name">Bonat Delivery Attempts</field>
        <field name="res_model">x_bonat_order_attempt</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_bonat_order_attempt" name="Bonat Delivery Attempts"
              parent="point_of_sale.menu_point_of_sale" action="action_bonat_order_attempt"
              sequence="20" groups="point_of_sale.group_pos_manager"/>
</odoo>
