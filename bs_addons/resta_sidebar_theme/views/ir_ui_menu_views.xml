<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rs_sidebar_sections_list" model="ir.ui.view">
        <field name="name">ir.ui.menu.rs.sidebar.sections.list</field>
        <field name="model">ir.ui.menu</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Sidebar Sections" editable="bottom" create="0" delete="0" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="web_icon_data" widget="image" options="{'size': [24, 24]}" string=" " readonly="1"/>
                <field name="name" readonly="1" string="App"/>
                <field name="rs_icon" placeholder="Automatic"/>
                <field name="rs_section" placeholder="Automatic"/>
                <field name="rs_section_sequence"/>
            </list>
        </field>
    </record>

    <record id="action_rs_sidebar_sections" model="ir.actions.act_window">
        <field name="name">Sidebar Sections</field>
        <field name="res_model">ir.ui.menu</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_rs_sidebar_sections_list"/>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="help" type="html">
            <p>Give apps the same section name to group them in the sidebar.
               Drag rows to change the order of apps. Reload the page to see changes.</p>
        </field>
    </record>
</odoo>
