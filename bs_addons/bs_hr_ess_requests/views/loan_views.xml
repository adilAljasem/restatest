<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_type_list" model="ir.ui.view">
        <field name="name">bs.hr.loan.type.list</field>
        <field name="model">bs.hr.loan.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="max_percent_wage"/>
                <field name="max_amount"/>
                <field name="max_installments"/>
                <field name="min_service_months"/>
                <field name="allow_parallel"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_loan_type_form" model="ir.ui.view">
        <field name="name">bs.hr.loan.type.form</field>
        <field name="model">bs.hr.loan.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Salary advance"/></h1></div>
                    <group>
                        <group string="Limits">
                            <field name="max_percent_wage"/>
                            <field name="max_amount"/>
                            <field name="max_installments"/>
                            <field name="min_service_months"/>
                            <field name="allow_parallel"/>
                        </group>
                        <group string="Accounting">
                            <field name="account_id"/>
                            <field name="journal_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description shown to employees"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_loan_type" model="ir.actions.act_window">
        <field name="name">Loan Types</field>
        <field name="res_model">bs.hr.loan.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="view_loan_form" model="ir.ui.view">
        <field name="name">bs.hr.loan.form</field>
        <field name="model">bs.hr.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ess_approve" type="object" string="Approve" class="btn-primary" invisible="not can_ess_approve"/>
                    <button name="action_ess_reject_wizard" type="object" string="Reject" invisible="not can_ess_approve"/>
                    <button name="action_disburse" type="object" string="Disburse" class="btn-primary" invisible="state != 'approved' or disbursed" groups="bs_hr_ess_base.group_ess_hr_officer" confirm="Post the disbursement entry and schedule the payroll deductions?"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'in_approval')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state not in ('rejected', 'cancelled')" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_approval,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_id" groups="account.group_account_readonly,bs_hr_ess_base.group_ess_hr_officer">
                            <field name="move_id" string="Entry" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="current_approver_ids" widget="many2many_tags" invisible="state != 'in_approval'"/>
                            <field name="can_ess_approve" invisible="1"/>
                            <field name="loan_type_id" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="installment_count" readonly="state != 'draft'"/>
                            <field name="installment_amount"/>
                            <field name="first_installment_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="paid_amount"/>
                            <field name="remaining_amount"/>
                            <field name="disbursed"/>
                            <field name="disburse_date" invisible="not disbursed"/>
                            <field name="submit_date"/>
                            <field name="decision_date"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule" name="schedule">
                            <button name="action_generate_schedule" type="object" string="Generate schedule" class="btn-secondary" invisible="state != 'approved' or line_ids" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                            <field name="line_ids" readonly="1">
                                <list decoration-success="state == 'paid'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'postponed'">
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="adjustment_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <field name="employee_note" placeholder="Notes"/>
                        </page>
                        <page string="Postponements" name="postponements" invisible="not postpone_ids">
                            <field name="postpone_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="installment_date"/>
                                    <field name="new_date"/>
                                    <field name="reason"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decided_by_id"/>
                                    <field name="decided_on"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_loan_list" model="ir.ui.view">
        <field name="name">bs.hr.loan.list</field>
        <field name="model">bs.hr.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="loan_type_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="installment_count" optional="show"/>
                <field name="remaining_amount" sum="Remaining"/>
                <field name="submit_date" optional="show"/>
                <field name="current_approver_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'" decoration-info="state in ('submitted', 'in_approval')"/>
            </list>
        </field>
    </record>
    <record id="view_loan_search" model="ir.ui.view">
        <field name="name">bs.hr.loan.search</field>
        <field name="model">bs.hr.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <field name="loan_type_id"/>
                <filter name="not_disbursed" string="To disburse" domain="[('state', '=', 'approved'), ('disbursed', '=', False)]"/>
                <filter name="to_approve" string="To approve" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'in_approval'))]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'done'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">bs.hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="view_loan_postpone_form" model="ir.ui.view">
        <field name="name">bs.hr.loan.postpone.form</field>
        <field name="model">bs.hr.loan.postpone</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ess_approve" type="object" string="Approve" class="btn-primary" invisible="not can_ess_approve"/>
                    <button name="action_ess_reject_wizard" type="object" string="Reject" invisible="not can_ess_approve"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'in_approval')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state not in ('rejected', 'cancelled')" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_approval,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"></div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="current_approver_ids" widget="many2many_tags" invisible="state != 'in_approval'"/>
                            <field name="can_ess_approve" invisible="1"/>
                            <field name="loan_line_id" readonly="state != 'draft'"/>
                            <field name="loan_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="installment_date"/>
                            <field name="installment_amount"/>
                        </group>
                        <group>
                            <field name="new_date"/>
                            <field name="submit_date"/>
                            <field name="decision_date"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason" readonly="state != 'draft'"/>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decided_by_id"/>
                                    <field name="decided_on"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_loan_postpone_list" model="ir.ui.view">
        <field name="name">bs.hr.loan.postpone.list</field>
        <field name="model">bs.hr.loan.postpone</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="loan_id"/>
                <field name="installment_date"/>
                <field name="new_date" optional="show"/>
                <field name="submit_date" optional="show"/>
                <field name="current_approver_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'" decoration-info="state in ('submitted', 'in_approval')"/>
            </list>
        </field>
    </record>
    <record id="view_loan_postpone_search" model="ir.ui.view">
        <field name="name">bs.hr.loan.postpone.search</field>
        <field name="model">bs.hr.loan.postpone</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>

                <filter name="to_approve" string="To approve" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'in_approval'))]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'done'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_loan_postpone" model="ir.actions.act_window">
        <field name="name">Installment Postponements</field>
        <field name="res_model">bs.hr.loan.postpone</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="view_loan_line_list" model="ir.ui.view">
        <field name="name">bs.hr.loan.line.list</field>
        <field name="model">bs.hr.loan.line</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="state == 'paid'" decoration-warning="state == 'postponed'">
                <field name="loan_id"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="adjustment_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_loan_line_search" model="ir.ui.view">
        <field name="name">bs.hr.loan.line.search</field>
        <field name="model">bs.hr.loan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="loan_id"/>
                <filter name="open" string="To pay" domain="[('state', 'in', ('pending', 'postponed'))]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_loan_line" model="ir.actions.act_window">
        <field name="name">Loan Installments</field>
        <field name="res_model">bs.hr.loan.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1, 'search_default_group_month': 1}</field>
    </record>
</odoo>
