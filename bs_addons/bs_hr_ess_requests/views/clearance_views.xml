<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clearance_form" model="ir.ui.view">
        <field name="name">bs.hr.clearance.form</field>
        <field name="model">bs.hr.clearance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check" type="object" string="Check" class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state == 'done' or blocker_count"/>
                    <button name="action_reset" type="object" string="Reopen" invisible="state != 'done'" groups="bs_hr_ess_base.group_ess_hr_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state == 'done'"/>
                            <field name="date" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="blocker_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-success" role="alert" invisible="blocker_count or state == 'done'">
                        No open item: the clearance can be completed.
                    </div>
                    <notebook>
                        <page string="Open items" name="blockers">
                            <field name="blocker_ids">
                                <list create="0" delete="0">
                                    <field name="category" widget="badge"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <button name="action_open" type="object" string="Open" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_clearance_list" model="ir.ui.view">
        <field name="name">bs.hr.clearance.list</field>
        <field name="model">bs.hr.clearance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="blocker_count"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'blocked'"/>
            </list>
        </field>
    </record>
    <record id="action_clearance" model="ir.actions.act_window">
        <field name="name">Clearances</field>
        <field name="res_model">bs.hr.clearance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Clear a leaving employee</p>
            <p>The clearance lists the custody items, loan balances and open requests that must be settled first.</p>
        </field>
    </record>
</odoo>
