<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_blackout_list" model="ir.ui.view">
        <field name="name">bs.hr.leave.blackout.list</field>
        <field name="model">bs.hr.leave.blackout</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="leave_type_ids" widget="many2many_tags"/>
                <field name="work_location_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_leave_blackout" model="ir.actions.act_window">
        <field name="name">Leave Blackout Periods</field>
        <field name="res_model">bs.hr.leave.blackout</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="view_leave_request_form" model="ir.ui.view">
        <field name="name">bs.hr.leave.request.form</field>
        <field name="model">bs.hr.leave.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ess_approve" type="object" string="Approve" class="btn-primary" invisible="not can_ess_approve"/>
                    <button name="action_ess_reject_wizard" type="object" string="Reject" invisible="not can_ess_approve"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'in_approval')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state not in ('rejected', 'cancelled')" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_approval,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_leave" type="object" class="oe_stat_button" icon="fa-plane" invisible="not leave_id" string="Time Off"/>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="current_approver_ids" widget="many2many_tags" invisible="state != 'in_approval'"/>
                            <field name="can_ess_approve" invisible="1"/>
                            <field name="leave_type_id" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="number_of_days"/>
                        </group>
                        <group>
                            <field name="leave_id" invisible="not leave_id"/>
                            <field name="leave_state" invisible="not leave_id"/>
                            <field name="return_state" invisible="state not in ('approved', 'done')"/>
                            <field name="submit_date"/>
                            <field name="decision_date"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="details">
                            <div class="alert alert-warning" role="alert" invisible="not conflict_warning">
                                <field name="conflict_warning"/>
                            </div>
                            <group>
                                <group>
                                    <field name="need_ticket" readonly="state != 'draft'"/>
                                    <field name="need_exit_reentry" readonly="state != 'draft'"/>
                                    <field name="advance_salary" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="support_document"/>
                                </group>
                            </group>
                            <field name="employee_note" placeholder="Notes"/>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decided_by_id"/>
                                    <field name="decided_on"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_leave_request_list" model="ir.ui.view">
        <field name="name">bs.hr.leave.request.list</field>
        <field name="model">bs.hr.leave.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="number_of_days" sum="Days"/>
                <field name="need_ticket" optional="hide"/>
                <field name="need_exit_reentry" optional="hide"/>
                <field name="return_state" optional="show"/>
                <field name="submit_date" optional="show"/>
                <field name="current_approver_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'" decoration-info="state in ('submitted', 'in_approval')"/>
            </list>
        </field>
    </record>
    <record id="view_leave_request_search" model="ir.ui.view">
        <field name="name">bs.hr.leave.request.search</field>
        <field name="model">bs.hr.leave.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <field name="leave_type_id"/>
                <filter name="ticket" string="Ticket needed" domain="[('need_ticket', '=', True)]"/>
                <filter name="exit_reentry" string="Exit/re-entry needed" domain="[('need_exit_reentry', '=', True)]"/>
                <filter name="late" string="Late return" domain="[('return_state', '=', 'late')]"/>
                <filter name="conflict" string="With conflict" domain="[('conflict_warning', '!=', False)]"/>
                <filter name="to_approve" string="To approve" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'in_approval'))]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'done'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_leave_request" model="ir.actions.act_window">
        <field name="name">Time Off Requests</field>
        <field name="res_model">bs.hr.leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
