<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ess_custody" model="ir.ui.view">
        <field name="name">product.template.form.ess.custody</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Employee custody" name="ess_custody">
                    <group>
                        <group>
                            <field name="ess_is_custody"/>
                            <field name="ess_needs_size" invisible="not ess_is_custody"/>
                            <field name="ess_renew_months" invisible="not ess_is_custody"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="action_custody_products" model="ir.actions.act_window">
        <field name="name">Custody Items</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('ess_is_custody', '=', True)]</field>
        <field name="context">{'default_ess_is_custody': True, 'default_type': 'consu'}</field>
    </record>
    <record id="view_custody_request_form" model="ir.ui.view">
        <field name="name">bs.hr.custody.request.form</field>
        <field name="model">bs.hr.custody.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ess_approve" type="object" string="Approve" class="btn-primary" invisible="not can_ess_approve"/>
                    <button name="action_ess_reject_wizard" type="object" string="Reject" invisible="not can_ess_approve"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'in_approval')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state not in ('rejected', 'cancelled')" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_approval,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <field name="picking_id" string="Transfer" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="current_approver_ids" widget="many2many_tags" invisible="state != 'in_approval'"/>
                            <field name="can_ess_approve" invisible="1"/>
                            <field name="request_type" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="estimated_value"/>
                            <field name="deduction_amount" invisible="request_type not in ('damage', 'loss')" readonly="state not in ('draft', 'submitted', 'in_approval')"/>
                            <field name="adjustment_id" invisible="not adjustment_id"/>
                            <field name="submit_date"/>
                            <field name="decision_date"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="employee_id" column_invisible="1"/>
                                    <field name="holding_id" column_invisible="parent.request_type == 'new'"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="size"/>
                                </list>
                            </field>
                            <field name="reason" placeholder="Reason / what happened" readonly="state != 'draft'"/>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decided_by_id"/>
                                    <field name="decided_on"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_custody_request_list" model="ir.ui.view">
        <field name="name">bs.hr.custody.request.list</field>
        <field name="model">bs.hr.custody.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_type"/>
                <field name="picking_id" optional="show"/>
                <field name="submit_date" optional="show"/>
                <field name="current_approver_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'" decoration-info="state in ('submitted', 'in_approval')"/>
            </list>
        </field>
    </record>
    <record id="view_custody_request_search" model="ir.ui.view">
        <field name="name">bs.hr.custody.request.search</field>
        <field name="model">bs.hr.custody.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <filter name="issue" string="Issues" domain="[('request_type', 'in', ('new', 'replace'))]"/>
                <filter name="incidents" string="Damage / loss" domain="[('request_type', 'in', ('damage', 'loss'))]"/>
                <filter name="to_approve" string="To approve" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'in_approval'))]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'done'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_custody_request" model="ir.actions.act_window">
        <field name="name">Custody Requests</field>
        <field name="res_model">bs.hr.custody.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="view_custody_holding_list" model="ir.ui.view">
        <field name="name">bs.hr.custody.holding.list</field>
        <field name="model">bs.hr.custody.holding</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'returned'" decoration-danger="state in ('lost', 'damaged')">
                <field name="employee_id"/>
                <field name="work_location_id" optional="show"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="size"/>
                <field name="lot_id" optional="hide"/>
                <field name="date_received"/>
                <field name="ack_date" optional="show"/>
                <field name="next_due_date" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="value" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_custody_holding_form" model="ir.ui.view">
        <field name="name">bs.hr.custody.holding.form</field>
        <field name="model">bs.hr.custody.holding</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="size"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="date_received"/>
                            <field name="ack_date"/>
                            <field name="next_due_date"/>
                            <field name="date_returned"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="value"/>
                            <field name="request_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_custody_holding_search" model="ir.ui.view">
        <field name="name">bs.hr.custody.holding.search</field>
        <field name="model">bs.hr.custody.holding</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="product_id"/>
                <field name="work_location_id"/>
                <filter name="held" string="Held" domain="[('state', '=', 'held')]"/>
                <filter name="not_ack" string="Not acknowledged" domain="[('state', '=', 'held'), ('ack_date', '=', False)]"/>
                <filter name="due" string="Renewal due" domain="[('next_due_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_product" string="Item" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_custody_holding" model="ir.actions.act_window">
        <field name="name">Employee Custody</field>
        <field name="res_model">bs.hr.custody.holding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_held': 1}</field>
    </record>
</odoo>
