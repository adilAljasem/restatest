<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_request_type_list" model="ir.ui.view">
        <field name="name">bs.hr.request.type.list</field>
        <field name="model">bs.hr.request.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="require_attachment"/>
                <field name="generate_letter"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_request_type_form" model="ir.ui.view">
        <field name="name">bs.hr.request.type.form</field>
        <field name="model">bs.hr.request.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="request_count" string="Requests" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Salary certificate"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="icon"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="require_attachment"/>
                            <field name="generate_letter"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Explanation shown to employees"/>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="key"/>
                                    <field name="field_type"/>
                                    <field name="required"/>
                                    <field name="options" invisible="field_type != 'selection'" required="field_type == 'selection'"/>
                                    <field name="help_text" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Letter" name="letter" invisible="not generate_letter">
                            <field name="letter_body"/>
                            <div class="text-muted small">
                                Placeholders: {{employee_name}}, {{job}}, {{department}}, {{joining_date}}, {{nationality}},
                                {{id_number}}, {{wage}}, {{company}}, {{today}}, {{hijri_today}}, {{reference}} and {{key}} of
                                any field above.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_request_type" model="ir.actions.act_window">
        <field name="name">Request Types</field>
        <field name="res_model">bs.hr.request.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="view_request_form" model="ir.ui.view">
        <field name="name">bs.hr.request.form</field>
        <field name="model">bs.hr.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ess_approve" type="object" string="Approve" class="btn-primary" invisible="not can_ess_approve"/>
                    <button name="action_ess_reject_wizard" type="object" string="Reject" invisible="not can_ess_approve"/>
                    <button name="action_generate_letter" type="object" string="Regenerate letter" invisible="not generate_letter or state not in ('approved', 'done')" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'in_approval')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state not in ('rejected', 'cancelled')" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_approval,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"></div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="current_approver_ids" widget="many2many_tags" invisible="state != 'in_approval'"/>
                            <field name="can_ess_approve" invisible="1"/>
                            <field name="type_id" readonly="state != 'draft'"/>
                            <field name="generate_letter" invisible="1"/>
                        </group>
                        <group>
                            <field name="letter_attachment_id" invisible="not letter_attachment_id"/>
                            <field name="submit_date"/>
                            <field name="decision_date"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="details">
                            <field name="values_display"/>
                            <field name="employee_note" placeholder="Notes"/>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decided_by_id"/>
                                    <field name="decided_on"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_request_list" model="ir.ui.view">
        <field name="name">bs.hr.request.list</field>
        <field name="model">bs.hr.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="type_id"/>
                <field name="submit_date" optional="show"/>
                <field name="current_approver_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'" decoration-info="state in ('submitted', 'in_approval')"/>
            </list>
        </field>
    </record>
    <record id="view_request_search" model="ir.ui.view">
        <field name="name">bs.hr.request.search</field>
        <field name="model">bs.hr.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <field name="type_id"/>
                <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                <filter name="to_approve" string="To approve" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'in_approval'))]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'done'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_request" model="ir.actions.act_window">
        <field name="name">HR Requests</field>
        <field name="res_model">bs.hr.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
    <record id="view_approval_flow_form_request_type" model="ir.ui.view">
        <field name="name">bs.hr.approval.flow.form.request.type</field>
        <field name="model">bs.hr.approval.flow</field>
        <field name="inherit_id" ref="bs_hr_ess_base.view_approval_flow_form"/>
        <field name="arch" type="xml">
            <field name="res_model" position="after">
                <field name="request_type_id" invisible="res_model != 'bs.hr.request'"/>
            </field>
        </field>
    </record>
</odoo>
