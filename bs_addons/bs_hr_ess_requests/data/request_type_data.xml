<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="request_type_salary_certificate" model="bs.hr.request.type">
        <field name="name">Salary certificate</field>
        <field name="code">salary_certificate</field>
        <field name="sequence">10</field>
        <field name="icon">fa-certificate</field>
        <field name="description">Official letter stating your job and salary, addressed to a bank or an authority.</field>
        <field name="generate_letter" eval="True"/>
        <field name="letter_body"><![CDATA[<p>To: {{addressed_to}}</p>
<p>Subject: Salary certificate</p>
<p>{{company}} certifies that <strong>{{employee_name}}</strong>, {{nationality}} national, ID / Iqama number {{id_number}}, has been working with us as <strong>{{job}}</strong> in the {{department}} department since {{joining_date}}, and currently receives a total monthly salary of <strong>{{wage}}</strong>.</p>
<p>This certificate was issued at the employee's request, without any liability on the company.</p>
<p>Issued on {{today}} ({{hijri_today}}) - Reference {{reference}}</p>]]></field>
    </record>
    <record id="request_type_salary_certificate_to" model="bs.hr.request.type.field">
        <field name="type_id" ref="request_type_salary_certificate"/>
        <field name="sequence">10</field>
        <field name="name">Addressed to</field>
        <field name="key">addressed_to</field>
        <field name="field_type">char</field>
        <field name="required" eval="True"/>
    </record>

    <record id="request_type_to_whom" model="bs.hr.request.type">
        <field name="name">To whom it may concern letter</field>
        <field name="code">to_whom</field>
        <field name="sequence">20</field>
        <field name="icon">fa-envelope-o</field>
        <field name="generate_letter" eval="True"/>
        <field name="letter_body"><![CDATA[<p>To whom it may concern,</p>
<p>{{company}} certifies that <strong>{{employee_name}}</strong>, {{nationality}} national, ID / Iqama number {{id_number}}, is employed as <strong>{{job}}</strong> since {{joining_date}}.</p>
<p>Purpose: {{purpose}}</p>
<p>Issued on {{today}} ({{hijri_today}}) - Reference {{reference}}</p>]]></field>
    </record>
    <record id="request_type_to_whom_purpose" model="bs.hr.request.type.field">
        <field name="type_id" ref="request_type_to_whom"/>
        <field name="name">Purpose</field>
        <field name="key">purpose</field>
        <field name="field_type">char</field>
        <field name="required" eval="True"/>
    </record>

    <record id="request_type_bank_update" model="bs.hr.request.type">
        <field name="name">Bank details update</field>
        <field name="code">bank_update</field>
        <field name="sequence">30</field>
        <field name="icon">fa-bank</field>
        <field name="require_attachment" eval="True"/>
        <field name="description">Attach the IBAN certificate issued by your bank.</field>
    </record>
    <record id="request_type_bank_update_bank" model="bs.hr.request.type.field">
        <field name="type_id" ref="request_type_bank_update"/>
        <field name="sequence">10</field>
        <field name="name">Bank</field>
        <field name="key">bank</field>
        <field name="field_type">char</field>
        <field name="required" eval="True"/>
    </record>
    <record id="request_type_bank_update_iban" model="bs.hr.request.type.field">
        <field name="type_id" ref="request_type_bank_update"/>
        <field name="sequence">20</field>
        <field name="name">IBAN</field>
        <field name="key">iban</field>
        <field name="field_type">char</field>
        <field name="required" eval="True"/>
    </record>

    <record id="request_type_branch_transfer" model="bs.hr.request.type">
        <field name="name">Branch transfer</field>
        <field name="code">branch_transfer</field>
        <field name="sequence">40</field>
        <field name="icon">fa-exchange</field>
    </record>
    <record id="request_type_branch_transfer_branch" model="bs.hr.request.type.field">
        <field name="type_id" ref="request_type_branch_transfer"/>
