        <field name="key">branch</field>
        <field name="field_type">char</field>
        <field name="required" eval="True"/>
    </record>
    <record id="request_type_branch_transfer_date" model="bs.hr.request.type.field">
        <field name="type_id" ref="request_type_branch_transfer"/>
        <field name="sequence">20</field>
        <field name="name">Preferred date</field>
        <field name="key">date</field>
        <field name="field_type">date</field>
    </record>
    <record id="request_type_branch_transfer_reason" model="bs.hr.request.type.field">
        <field name="type_id" ref="request_type_branch_transfer"/>
        <field name="sequence">30</field>
        <field name="name">Reason</field>
        <field name="key">reason</field>
        <field name="field_type">text</field>
    </record>

    <record id="request_type_housing" model="bs.hr.request.type">
        <field name="name">Housing request</field>
        <field name="code">housing</field>
        <field name="sequence">50</field>
        <field name="icon">fa-bed</field>
