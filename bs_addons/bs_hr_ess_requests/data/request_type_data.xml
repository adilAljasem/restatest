        <field name="sequence">10</field>
        <field name="name">Request</field>
        <field name="key">kind</field>
        <field name="field_type">selection</field>
        <field name="options">New accommodation,Room change,Maintenance,Leave accommodation</field>
        <field name="required" eval="True"/>
    </record>
    <record id="request_type_housing_details" model="bs.hr.request.type.field">
        <field name="type_id" ref="request_type_housing"/>
        <field name="sequence">20</field>
        <field name="name">Details</field>
        <field name="key">details</field>
        <field name="field_type">text</field>
    </record>

    <record id="request_type_resignation" model="bs.hr.request.type">
