<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kitchen_flow_log_company_rule" model="ir.rule">
        <field name="name">Kitchen flow diagnostics by company</field>
        <field name="model_id" ref="model_bs_pos_kitchen_flow_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="kitchen_flow_step_company_rule" model="ir.rule">
        <field name="name">Kitchen flow operations by company</field>
        <field name="model_id" ref="model_bs_pos_kitchen_flow_step"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
</odoo>

