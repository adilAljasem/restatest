<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_objection_user" model="ir.rule">
            <field name="name">ESS payslip objection: own / approver</field>
            <field name="model_id" ref="model_bs_hr_payslip_objection"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('current_approver_ids', 'in', [user.id])]</field>
        </record>
        <record id="rule_objection_payroll" model="ir.rule">
            <field name="name">ESS payslip objection: payroll</field>
            <field name="model_id" ref="model_bs_hr_payslip_objection"/>
            <field name="groups" eval="[(4, ref('bs_hr_ess_base.group_ess_hr_officer'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
