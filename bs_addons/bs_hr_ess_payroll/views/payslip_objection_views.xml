<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_objection_form" model="ir.ui.view">
        <field name="name">bs.hr.payslip.objection.form</field>
        <field name="model">bs.hr.payslip.objection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ess_approve" type="object" string="Approve" class="btn-primary" invisible="not can_ess_approve"/>
                    <button name="action_ess_reject_wizard" type="object" string="Reject" invisible="not can_ess_approve"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'in_approval')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state not in ('rejected', 'cancelled')" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_approval,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Objection">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="payslip_id" readonly="state != 'draft'" domain="[('employee_id', '=', employee_id)]"/>
                            <field name="payslip_period"/>
                            <field name="line_id" readonly="state != 'draft'"/>
                            <field name="line_amount" invisible="not line_id"/>
                            <field name="claimed_amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="current_approver_ids" widget="many2many_tags" invisible="state != 'in_approval'"/>
                            <field name="can_ess_approve" invisible="1"/>
                        </group>
                        <group string="Resolution">
                            <field name="resolution_type" readonly="state not in ('draft', 'submitted', 'in_approval')"/>
                            <field name="resolution_amount" readonly="state not in ('draft', 'submitted', 'in_approval')"/>
                            <field name="resolution_note" readonly="state not in ('draft', 'submitted', 'in_approval')"/>
                            <field name="adjustment_id" invisible="not adjustment_id"/>
                            <field name="adjustment_state" invisible="not adjustment_id"/>
                            <field name="submit_date"/>
                            <field name="decision_date"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason" name="reason">
                            <field name="reason" readonly="state != 'draft'"/>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decided_by_id"/>
                                    <field name="decided_on"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payslip_objection_list" model="ir.ui.view">
        <field name="name">bs.hr.payslip.objection.list</field>
        <field name="model">bs.hr.payslip.objection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="work_location_id" optional="show"/>
                <field name="payslip_id"/>
                <field name="line_id" optional="show"/>
                <field name="claimed_amount" sum="Total"/>
                <field name="resolution_amount" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="current_approver_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_objection_search" model="ir.ui.view">
        <field name="name">bs.hr.payslip.objection.search</field>
        <field name="model">bs.hr.payslip.objection</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="payslip_id"/>
                <filter name="to_approve" string="To approve" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'in_approval'))]"/>
                <group>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payslip_objection" model="ir.actions.act_window">
        <field name="name">Payslip Objections</field>
        <field name="res_model">bs.hr.payslip.objection</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
