<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="employee_promotion_usage_view_list" model="ir.ui.view">
        <field name="name">employee.promotion.usage.list</field>
        <field name="model">employee.promotion.usage</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="usage_date"/>
                <field name="employee_name" string="Employee"/>
                <field name="employee_id" column_invisible="True"/>
                <field name="partner_id"/>
                <field name="program_id"/>
                <field name="pos_order_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="employee_promotion_usage_action" model="ir.actions.act_window">
        <field name="name">Employee Promotion Usage</field>
        <field name="res_model">employee.promotion.usage</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="employee_promotion_usage_menu"
              name="Employee Promotion Usage"
              parent="point_of_sale.menu_point_rep"
              action="employee_promotion_usage_action"
              groups="point_of_sale.group_pos_manager"
              sequence="90"/>
</odoo>
