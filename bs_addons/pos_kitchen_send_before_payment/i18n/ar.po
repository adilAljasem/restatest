#. module: pos_kitchen_send_before_payment
#: model:ir.model.fields,field_description:pos_kitchen_send_before_payment.field_pos_config__kitchen_send_before_payment
#: model:ir.model.fields,field_description:pos_kitchen_send_before_payment.field_res_config_settings__pos_kitchen_send_before_payment
#: model_terms:ir.ui.view,arch_db:pos_kitchen_send_before_payment.res_config_settings_view_form_kitchen_send
msgid "Send to Kitchen Before Payment"
msgstr "الإرسال للمطبخ قبل الدفع"

#. module: pos_kitchen_send_before_payment
#: model:ir.model.fields,help:pos_kitchen_send_before_payment.field_pos_config__kitchen_send_before_payment
#: model:ir.model.fields,help:pos_kitchen_send_before_payment.field_res_config_settings__pos_kitchen_send_before_payment
msgid ""
"Show a \"Send\" button on the register (outside Bar/Restaurant mode) to send "
"the order to the preparation printers / display before payment."
msgstr ""
"إظهار زر \"إرسال\" في شاشة البيع (بدون وضع المطعم) لإرسال الطلب إلى طابعات "
"أو شاشة التحضير قبل الدفع."

#. module: pos_kitchen_send_before_payment
#: model_terms:ir.ui.view,arch_db:pos_kitchen_send_before_payment.res_config_settings_view_form_kitchen_send
msgid ""
"Adds a Send button next to Payment (without Bar/Restaurant mode). Requires "
"preparation printers or a preparation display."
msgstr ""
"يضيف زر إرسال بجانب زر الدفع (بدون وضع المطعم). يتطلب طابعات تحضير أو شاشة "
"تحضير."

