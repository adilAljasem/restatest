#. module: pos_kitchen_send_before_payment
#. odoo-javascript
#: code:addons/pos_kitchen_send_before_payment/static/src/app/services/pos_store.js:0
msgid "No kitchen printer"
msgstr "لا توجد طابعة مطبخ"

#. module: pos_kitchen_send_before_payment
#. odoo-javascript
#: code:addons/pos_kitchen_send_before_payment/static/src/app/services/pos_store.js:0
msgid ""
"No preparation printer or preparation display is linked to this Point of "
"Sale. Go to Point of Sale settings > Preparation, enable Preparation "
"Printers, add the kitchen printer with its product categories, then close "
"and reopen the session."
msgstr ""
"لا توجد طابعة تحضير أو شاشة تحضير مرتبطة بنقطة البيع هذه. اذهب إلى إعدادات "
"نقطة البيع ← قسم Preparation، وفعّل Preparation Printers، وأضف طابعة المطبخ "
"مع فئات المنتجات، ثم أغلق الجلسة وافتحها من جديد."

#. module: pos_kitchen_send_before_payment
#. odoo-javascript
#: code:addons/pos_kitchen_send_before_payment/static/src/app/services/pos_store.js:0
msgid "Nothing to send"
msgstr "لا يوجد شيء للإرسال"

#. module: pos_kitchen_send_before_payment
#. odoo-javascript
#: code:addons/pos_kitchen_send_before_payment/static/src/app/services/pos_store.js:0
msgid ""
"There is nothing new to send to the kitchen. Either the items were already "
"sent, or their product categories are not selected on the kitchen printer "
"(Point of Sale > Configuration > Preparation Printers)."
msgstr ""
"لا توجد أصناف جديدة للإرسال للمطبخ. إما أنها أُرسلت مسبقاً، أو أن فئات هذه "
"المنتجات غير محددة في طابعة المطبخ (نقطة البيع ← التهيئة ← طابعات التحضير)."

#. module: pos_kitchen_send_before_payment
#. odoo-javascript
