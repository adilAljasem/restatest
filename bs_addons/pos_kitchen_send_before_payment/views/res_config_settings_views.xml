<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kitchen_send" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.kitchen.send</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='is_order_printer']" position="after">
                <setting id="kitchen_send_before_payment"
                         string="Send to Kitchen Before Payment"
                         help="Adds a Send button next to Payment (without Bar/Restaurant mode). Requires preparation printers or a preparation display."
                         invisible="pos_module_pos_restaurant">
                    <field name="pos_kitchen_send_before_payment"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
