<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_announcement_form" model="ir.ui.view">
        <field name="name">bs.hr.announcement.form</field>
        <field name="model">bs.hr.announcement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_reminder" type="object" string="Send reminder"
                            invisible="state != 'published' or not require_ack"
                            confirm="Send a reminder to every employee who did not acknowledge yet?"/>
                    <button name="action_archive_announcement" type="object" string="Archive" invisible="state != 'published'"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_acks" type="object" class="oe_stat_button" icon="fa-eye" invisible="not id">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="read_count"/> / <field name="recipient_count"/></span>
                                <span class="o_stat_text">Read</span>
                            </div>
                        </button>
                        <button name="action_open_not_acknowledged" type="object" class="oe_stat_button" icon="fa-user-times"
                                invisible="not require_ack or not id">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="ack_rate" widget="integer"/> %</span>
                                <span class="o_stat_text">Who did not acknowledge</span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. New uniform policy"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="announcement_type"/>
                            <field name="summary"/>
                            <field name="pinned"/>
                            <field name="require_ack"/>
                        </group>
                        <group>
                            <field name="date_publish"/>
                            <field name="date_expire"/>
                            <field name="author_id"/>
                            <field name="notified" invisible="1"/>
                            <field name="last_reminder_date" invisible="not require_ack"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="body" options="{'height': 260}"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Audience" name="audience">
                            <group>
                                <group>
                                    <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                                    <field name="target_all"/>
                                </group>
                                <group invisible="target_all">
                                    <field name="work_location_ids" widget="many2many_tags"/>
                                    <field name="department_ids" widget="many2many_tags"/>
                                    <field name="job_ids" widget="many2many_tags"/>
                                    <field name="country_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="target_all">
                                Employees must match every filled criterion (branch AND department AND job AND nationality).
                            </div>
                        </page>
                        <page string="Reads" name="reads" invisible="not id">
                            <group>
                                <group>
                                    <field name="recipient_count"/>
                                    <field name="read_count"/>
                                </group>
                                <group>
                                    <field name="ack_count" invisible="not require_ack"/>
                                    <field name="ack_rate" invisible="not require_ack"/>
                                </group>
                            </group>
                            <field name="ack_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="work_location_id"/>
                                    <field name="read_date"/>
                                    <field name="ack_date"/>
                                    <field name="ip" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_announcement_list" model="ir.ui.view">
        <field name="name">bs.hr.announcement.list</field>
        <field name="model">bs.hr.announcement</field>
        <field name="arch" type="xml">
            <list>
                <field name="pinned" widget="boolean_toggle" optional="show"/>
                <field name="name"/>
                <field name="announcement_type"/>
                <field name="date_publish"/>
                <field name="date_expire" optional="hide"/>
                <field name="require_ack" optional="show"/>
                <field name="recipient_count" optional="show"/>
                <field name="read_count" optional="show"/>
                <field name="ack_rate" optional="show" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'published'" decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_announcement_kanban" model="ir.ui.view">
        <field name="name">bs.hr.announcement.kanban</field>
        <field name="model">bs.hr.announcement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <i class="fa fa-thumb-tack" invisible="not pinned" title="Pinned"/>
                        </div>
                        <field name="announcement_type" class="text-muted"/>
                        <field name="summary" class="small"/>
                        <footer>
                            <field name="date_publish" class="small text-muted"/>
                            <div class="ms-auto" invisible="not require_ack">
                                <field name="ack_rate" widget="progressbar"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_announcement_search" model="ir.ui.view">
        <field name="name">bs.hr.announcement.search</field>
        <field name="model">bs.hr.announcement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="work_location_ids"/>
                <field name="department_ids"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="require_ack" string="Requires acknowledgement" domain="[('require_ack', '=', True)]"/>
                <filter name="pinned" string="Pinned" domain="[('pinned', '=', True)]"/>
                <separator/>
                <filter name="policies" string="Policies" domain="[('announcement_type', '=', 'policy')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'announcement_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_announcement" model="ir.actions.act_window">
        <field name="name">Announcements</field>
        <field name="res_model">bs.hr.announcement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Publish your first announcement</p>
            <p>News, circulars and policies reach the employees on their phones. Circulars can require an
                acknowledgement ("I have read and agree").</p>
        </field>
    </record>

    <record id="action_announcement_policy" model="ir.actions.act_window">
        <field name="name">Policy Library</field>
        <field name="res_model">bs.hr.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('announcement_type', '=', 'policy')]</field>
        <field name="context">{'default_announcement_type': 'policy', 'default_require_ack': True}</field>
    </record>

    <!-- Acknowledgement report -->
    <record id="view_announcement_ack_list" model="ir.ui.view">
        <field name="name">bs.hr.announcement.ack.list</field>
        <field name="model">bs.hr.announcement.ack</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="announcement_id"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <field name="department_id" optional="hide"/>
                <field name="read_date"/>
                <field name="ack_date"/>
                <field name="ip" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_announcement_ack_search" model="ir.ui.view">
        <field name="name">bs.hr.announcement.ack.search</field>
        <field name="model">bs.hr.announcement.ack</field>
        <field name="arch" type="xml">
            <search>
                <field name="announcement_id"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <filter name="acknowledged" string="Acknowledged" domain="[('ack_date', '!=', False)]"/>
                <filter name="read_only" string="Read, not acknowledged" domain="[('ack_date', '=', False)]"/>
                <group>
                    <filter name="group_announcement" string="Announcement" context="{'group_by': 'announcement_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_announcement_ack" model="ir.actions.act_window">
        <field name="name">Acknowledgements</field>
        <field name="res_model">bs.hr.announcement.ack</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_announcement': 1}</field>
    </record>
</odoo>
