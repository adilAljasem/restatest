<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ess_comms" model="ir.ui.view">
        <field name="name">res.config.settings.form.ess.comms</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bs_hr_ess_base.res_config_settings_view_form_ess"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ess_portal']" position="after">
                <block title="Communication" name="ess_comms">
                    <setting string="Birthdays and work anniversaries"
                             help="Show colleagues' birthdays and work anniversaries of the same branch in the portal calendar (name and day only).">
                        <field name="ess_show_birthdays"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
