<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_announcement_company" model="ir.rule">
            <field name="name">ESS announcement: company</field>
            <field name="model_id" ref="model_bs_hr_announcement"/>
            <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
        </record>
        <record id="rule_announcement_ack_company" model="ir.rule">
            <field name="name">ESS announcement acknowledgement: company</field>
            <field name="model_id" ref="model_bs_hr_announcement_ack"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
