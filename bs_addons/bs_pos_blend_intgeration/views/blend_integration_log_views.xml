<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blend_integration_log_list" model="ir.ui.view">
        <field name="name">blend.integration.log.list</field>
        <field name="model">blend.integration.log</field>
        <field name="arch" type="xml">
            <list create="0" delete="0"
                  decoration-success="state == 'success'"
                  decoration-warning="state == 'retry'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state in ['duplicate', 'superseded']">
                <field name="create_date"/>
                <field name="direction" widget="badge"/>
                <field name="event"/>
                <field name="config_id"/>
                <field name="external_reference"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="duration_ms" string="Duration (ms)"/>
                <field name="http_status"/>
                <field name="next_retry_at"/>
            </list>
        </field>
    </record>

    <record id="view_blend_integration_log_form" model="ir.ui.view">
        <field name="name">blend.integration.log.form</field>
        <field name="model">blend.integration.log</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_reprocess_inbound" type="object" string="Reprocess Incoming Order"
                            class="btn-primary" invisible="direction != 'inbound' or event != 'pos.order.create' or state != 'failed'"/>
                    <button name="action_process_now" type="object" string="Process Now"
                            class="btn-primary" invisible="direction != 'outbound' or state not in ['pending', 'retry']"/>
                    <button name="action_retry" type="object" string="Reset and Retry"
                            invisible="direction != 'outbound' or state not in ['failed', 'retry']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="direction"/>
                            <field name="event"/>
                            <field name="event_time"/>
                            <field name="external_reference"/>
                            <field name="idempotency_key"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="config_id"/>
                            <field name="order_id"/>
                            <field name="http_method"/>
                            <field name="endpoint_url"/>
                            <field name="http_status"/>
                        </group>
                    </group>
                    <group string="Timing and Retry">
                        <field name="attempt_count"/>
                        <field name="started_at"/>
                        <field name="completed_at"/>
                        <field name="duration_ms"/>
                        <field name="next_retry_at"/>
                    </group>
                    <group string="Manual Reprocessing" invisible="not reprocessed_at">
                        <field name="reprocess_mode"/>
                        <field name="reprocessed_by_id"/>
                        <field name="reprocessed_at"/>
                    </group>
                    <notebook>
                        <page string="Request Payload">
                            <field name="request_payload" widget="json" nolabel="1"/>
                        </page>
                        <page string="Response Payload">
                            <field name="response_payload" widget="json" nolabel="1"/>
                        </page>
                        <page string="Safe Headers">
                            <field name="request_headers" widget="json" nolabel="1"/>
                        </page>
                        <page string="Shared Menu Scope" invisible="not menu_scope">
                            <field name="menu_scope" widget="json" nolabel="1"/>
                        </page>
                        <page string="Error">
                            <field name="error_message" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_blend_inbound_reprocess_wizard_form" model="ir.ui.view">
        <field name="name">blend.inbound.reprocess.wizard.form</field>
        <field name="model">blend.inbound.reprocess.wizard</field>
        <field name="arch" type="xml">
            <form string="Reprocess Incoming Order">
                <group>
                    <field name="log_id" invisible="1"/>
                    <field name="config_id" readonly="1"/>
                    <field name="external_reference" readonly="1"/>
                    <field name="mode" widget="radio"/>
                </group>
                <div class="alert alert-info" role="alert" invisible="mode != 'fulfilled'">
                    Recover an already fulfilled order as a draft for local review.
                    It will not be accepted automatically, sent to the kitchen, or send status updates to Blend.
                    Review the order before recording payment or issuing an invoice.
                </div>
                <div class="alert alert-warning" role="alert" invisible="mode != 'new'">
                    Use only for an order that has not been fulfilled.
                    Normal branch settings apply, including automatic acceptance, invoicing and kitchen dispatch when enabled.
                </div>
                <p>The original payload and order reference are reused. An existing order will be opened without creating a duplicate.</p>
                <footer>
                    <button name="action_reprocess" type="object" string="Reprocess Order" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_blend_integration_log_search" model="ir.ui.view">
        <field name="name">blend.integration.log.search</field>
        <field name="model">blend.integration.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="event"/>
                <field name="external_reference"/>
                <field name="config_id"/>
                <filter name="blend_activity" string="Blend Activity Only"
                        domain="['|', ('order_id', '=', False), ('order_id.blend_is_inbound', '=', True)]"
                        help="Show incoming Blend order activity and integration operations without an order. Remove this filter to see historical cashier order logs."/>
                <separator/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="retry" string="Retry Scheduled" domain="[('state', '=', 'retry')]"/>
                <filter name="superseded" string="Superseded" domain="[('state', '=', 'superseded')]"/>
                <filter name="inbound" string="Inbound" domain="[('direction', '=', 'inbound')]"/>
                <filter name="outbound" string="Outbound" domain="[('direction', '=', 'outbound')]"/>
                <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                <filter name="group_config" string="POS Branch" context="{'group_by': 'config_id'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_blend_integration_log" model="ir.actions.act_window">
        <field name="name">Blend Integration Logs</field>
        <field name="res_model">blend.integration.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_blend_integration_log_search"/>
        <field name="context">{'search_default_blend_activity': 1}</field>
    </record>

    <menuitem id="menu_blend_integration_root"
              name="Blend Integration"
              parent="point_of_sale.menu_point_config_product"
              sequence="80"
              groups="base.group_system"/>
    <menuitem id="menu_blend_integration_log"
              name="Integration Logs"
              parent="menu_blend_integration_root"
              action="action_blend_integration_log"
              sequence="10"
              groups="base.group_system"/>
</odoo>
