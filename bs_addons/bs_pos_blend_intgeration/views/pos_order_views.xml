<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_filter_blend" model="ir.ui.view">
        <field name="name">pos.order.search.blend</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_reference']" position="after">
                <field name="blend_order_id" string="Blend Order ID"
                       filter_domain="['|', ('blend_order_id', 'ilike', self), ('blend_partner_reference', 'ilike', self)]"/>
                <field name="blend_partner_reference"/>
            </xpath>
            <xpath expr="//filter[@name='order_date']" position="after">
                <separator/>
                <filter name="blend_incoming_orders" string="Incoming Blend Orders"
                        domain="[('blend_is_inbound', '=', True)]"/>
                <separator/>
            </xpath>
            <xpath expr="//search" position="inside">
                <filter name="group_by_blend_source" string="From Blend"
                        context="{'group_by': 'blend_is_inbound'}"/>
            </xpath>
        </field>
    </record>
    <record id="view_pos_pos_form_blend" model="ir.ui.view">
        <field name="name">pos.order.form.blend</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='%(point_of_sale.action_pos_payment)d']" position="attributes">
                <attribute name="invisible" add="blend_financial_required" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='lines']" position="attributes">
                <attribute name="readonly" add="blend_financial_required" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='payment_ids']" position="attributes">
                <attribute name="readonly" add="blend_financial_required" separator=" or "/>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="blend_can_decide" invisible="1"/>
                <field name="blend_financial_required" invisible="1"/>
                <field name="blend_financial_state" invisible="1"/>
                <field name="blend_can_finalize" invisible="1"/>
                <field name="blend_schedule_at" invisible="1"/>
                <field name="blend_scheduled_prepared_at" invisible="1"/>
                <button name="action_blend_accept_order" type="object" string="Accept Order"
                        class="btn-primary" groups="point_of_sale.group_pos_user,base.group_system"
                        invisible="not blend_can_decide or blend_financial_state == 'failed'"/>
                <button name="action_blend_accept_order" type="object" string="Retry Acceptance and Accounting"
                        class="btn-primary" groups="point_of_sale.group_pos_user,base.group_system"
                        invisible="not blend_can_decide or blend_financial_state != 'failed'"/>
                <button name="action_blend_reject_order" type="object" string="Reject Order"
                        class="btn-secondary" groups="point_of_sale.group_pos_user,base.group_system"
                        invisible="not blend_can_decide"/>
                <button name="action_blend_accept_order" type="object" string="تسجيل الدفع وإصدار الفاتورة"
                        class="btn-primary" groups="point_of_sale.group_pos_user,base.group_system"
                        invisible="not blend_is_inbound or not blend_can_finalize"/>
                <button name="action_blend_send_delivery_status"
                        type="object"
                        string="Send Blend Status"
                        groups="base.group_system"
                        invisible="not blend_delivery_status"/>
                <button name="action_blend_retry"
                        type="object"
                        string="Retry Blend"
                        groups="base.group_system"
                        invisible="not blend_is_inbound"/>
                <button name="action_blend_mark_scheduled_prepared" type="object" string="تم التجهيز"
                        class="btn-primary" groups="point_of_sale.group_pos_user,base.group_system"
                        invisible="not blend_schedule_at or blend_scheduled_prepared_at or state == 'cancel' or blend_status in ('cancelled', 'rejected', 'time_out') or (state == 'draft' and blend_status in ('scheduled', 'pending'))"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0 fs-5 fw-bold" role="status" invisible="not blend_schedule_at">
                    طلب مجدول — الموعد: <field name="blend_schedule_at" readonly="1" nolabel="1"/>
                    <field name="general_customer_note" readonly="1" nolabel="1" class="d-block"/>
                    <span invisible="not blend_scheduled_prepared_at">تم التجهيز</span>
                </div>
                <field name="blend_recovered_fulfilled" invisible="1"/>
                <div class="alert alert-info mb-0" role="alert" invisible="not blend_recovered_fulfilled">
                    This already fulfilled Blend order was recovered for local review.
                    Automatic acceptance, kitchen dispatch and status updates to Blend are disabled for this order.
                    Review its totals and accounting before recording payment.
                </div>
                <div name="blend_total_warning" class="alert alert-warning mb-0" role="alert"
                     invisible="not blend_total_warning">
                    <field name="blend_total_warning" nolabel="1" readonly="1"/>
                </div>
                <div name="blend_order_statusbar"
                     class="d-flex justify-content-end align-items-center gap-2 flex-wrap px-3 pt-0 pb-1 border-bottom"
                     groups="point_of_sale.group_pos_user,base.group_system"
                     invisible="not blend_is_inbound">
                    <label for="blend_status_bar" string="Blend Status" class="mb-0 fw-bold text-body"/>
                    <field name="blend_status" id="blend_status_bar" widget="statusbar"
                           readonly="1" options="{'clickable': False}" class="mb-0"
                           statusbar_visible="pending,accepted,preparing,prepared,delivered"/>
                    <field name="blend_decision_sync_state" invisible="1"/>
                    <div name="blend_decision_delivery" role="status"
                         class="d-flex align-items-center gap-2"
                         invisible="not blend_decision_sync_state"
                         title="Delivery of the acceptance or rejection notification. The order status alone does not confirm delivery to Blend.">
                        <span class="small text-muted">Decision to Blend:</span>
                        <span class="badge rounded-pill text-bg-warning"
                              invisible="blend_decision_sync_state not in ('received', 'pending')">Queued for Blend</span>
                        <span class="badge rounded-pill text-bg-info"
                              invisible="blend_decision_sync_state != 'processing'">Sending to Blend</span>
                        <span class="badge rounded-pill text-bg-warning"
                              invisible="blend_decision_sync_state != 'retry'">Awaiting retry to Blend</span>
                        <span class="badge rounded-pill text-bg-success"
                              invisible="blend_decision_sync_state != 'success'">Sent to Blend</span>
                        <span class="badge rounded-pill text-bg-danger"
                              invisible="blend_decision_sync_state != 'failed'">Delivery to Blend failed</span>
                        <span class="badge rounded-pill text-bg-secondary"
                              invisible="blend_decision_sync_state != 'duplicate'">Duplicate notification</span>
                        <span class="badge rounded-pill text-bg-secondary"
                              invisible="blend_decision_sync_state != 'superseded'">Notification superseded</span>
                    </div>
                </div>
            </xpath>
            <xpath expr="//sheet/notebook" position="before">
                <field name="blend_is_inbound" invisible="1"/>
                <group name="blend_order_decision" string="Incoming Blend Order"
                       groups="point_of_sale.group_pos_user,base.group_system" invisible="not blend_is_inbound">
                    <field name="blend_total_matches"/>
                    <field name="blend_expected_total"/>
                    <field name="blend_total_difference"/>
                    <field name="blend_decision_source"/>
                    <field name="blend_decision_user_id"/>
                    <field name="blend_decision_at"/>
                    <field name="blend_scheduled_prepared_at" invisible="not blend_schedule_at"/>
                    <field name="blend_scheduled_prepared_by" invisible="not blend_schedule_at"/>
                    <field name="blend_rejection_reason" invisible="not blend_rejection_reason"/>
                </group>
                <group string="Blend Accounting" invisible="not blend_financial_required"
                       groups="point_of_sale.group_pos_user,base.group_system">
                    <field name="blend_financial_state" widget="badge"/>
                    <field name="blend_payment_method_id"/>
                    <field name="account_move" string="Blend Invoice" readonly="1"/>
                    <field name="blend_financial_completed_at"/>
                    <field name="blend_financial_attempts"/>
                    <field name="blend_financial_error" invisible="not blend_financial_error"/>
                    <field name="blend_refund_required" invisible="not blend_refund_required"/>
                    <div colspan="2" class="alert alert-warning" role="status" invisible="not blend_refund_required">
                        Blend reported a cancellation after payment. Review the standard POS refund and credit note.
                        No money was refunded automatically.
                    </div>
                </group>
            </xpath>
            <xpath expr="//page[@name='extra']" position="inside">
                <group string="Blend Kitchen Printing" invisible="not blend_is_inbound"
                       groups="point_of_sale.group_pos_user,base.group_system">
                    <div class="alert alert-warning" role="status" colspan="2" invisible="not blend_kitchen_print_warning">
                        <field name="blend_kitchen_print_warning" nolabel="1"/>
                    </div>
                    <field name="blend_kitchen_print_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="printer_id"/>
                            <field name="state"/>
                            <field name="claimed_at"/>
                            <field name="printed_at"/>
                            <field name="error"/>
                            <button name="action_retry" type="object" string="Retry Printing"
                                    invisible="state not in ['failed', 'printing']"
                                    confirm="Check the printer first. An unconfirmed receipt may already have printed. Retry can produce a duplicate."/>
                        </list>
                    </field>
                </group>
                <group string="Blend Integration" groups="base.group_system">
                    <field name="blend_order_id" readonly="1"/>
                    <field name="blend_partner_reference" readonly="1"/>
                    <field name="blend_order_type" readonly="1"/>
                    <field name="blend_aggregator" readonly="1"/>
                    <field name="blend_aggregator_order_id" readonly="1"/>
                    <field name="blend_discount_amount" readonly="1"/>
                    <field name="blend_status" readonly="1" invisible="blend_is_inbound"/>
                    <field name="blend_delivery_status"/>
                    <field name="blend_car_color"/>
                    <field name="blend_car_plate_number"/>
                    <field name="blend_car_plate_letters"/>
                    <field name="blend_car_brand"/>
                    <field name="blend_payload" widget="json" readonly="1" colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_blend_scheduled_order_list" model="ir.ui.view">
        <field name="name">pos.order.scheduled.blend.list</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <list string="الطلبات المجدولة" create="0" default_order="blend_schedule_at asc">
                <field name="pos_reference"/>
                <field name="blend_partner_reference"/>
                <field name="blend_schedule_at"/>
                <field name="general_customer_note"/>
                <field name="blend_status"/>
                <field name="state"/>
                <button name="action_blend_mark_scheduled_prepared" type="object" string="تم التجهيز"
                        groups="point_of_sale.group_pos_user,base.group_system"
                        invisible="blend_status in ('cancelled', 'rejected', 'time_out') or (state == 'draft' and blend_status in ('scheduled', 'pending'))"/>
            </list>
        </field>
    </record>
    <record id="action_blend_scheduled_orders" model="ir.actions.act_window">
        <field name="name">الطلبات المجدولة</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_blend_scheduled_order_list"/>
        <field name="domain">[('blend_is_inbound', '=', True), ('blend_schedule_at', '!=', False), ('blend_scheduled_prepared_at', '=', False), ('state', '!=', 'cancel'), ('blend_status', 'not in', ['cancelled', 'rejected', 'time_out'])]</field>
    </record>
    <menuitem id="menu_blend_scheduled_orders" name="الطلبات المجدولة"
              parent="point_of_sale.menu_point_of_sale" action="action_blend_scheduled_orders"
              sequence="3" groups="point_of_sale.group_pos_user,point_of_sale.group_pos_manager"/>
    <record id="view_blend_order_reject_wizard_form" model="ir.ui.view">
        <field name="name">blend.order.reject.wizard.form</field>
        <field name="model">blend.order.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Blend Order">
                <p>This will reject the Blend order and cancel the unpaid POS order. The rejection notification will be queued for delivery to Blend.</p>
                <group>
                    <field name="order_id" options="{'no_open': True}"/>
                    <field name="reason" placeholder="Why are you rejecting this order?"/>
                </group>
                <footer>
                    <button name="action_confirm_rejection" type="object" string="Confirm Rejection" class="btn-primary"/>
                    <button string="Back" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
