<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_blend_outbound_queue" model="ir.cron">
        <field name="name">Blend: Process outbound queue</field>
        <field name="model_id" ref="model_blend_integration_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_outbound()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>

