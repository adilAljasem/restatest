                  "raw": "{\n  \"brand_id\": \"{{brand_id}}\",\n  \"event_time\": \"{{event_time}}\",\n  \"event\": \"item.updated\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"product_id\": \"{{item_id}}\",\n  \"is_stock\": {{is_available}}\n}",
                  "options": {"raw": {"language": "json"}}
