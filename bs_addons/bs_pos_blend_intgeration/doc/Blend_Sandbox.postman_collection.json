  "item": [
    {
      "name": "00 - Authorization (Required)",
      "description": "Blend authenticates with the dedicated POS integration account. The returned access_token is saved automatically for all Blend-to-Odoo requests.",
      "item": [
        {
          "name": "00 - Login with Email & Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('access_token exists', function () { pm.expect(body.access_token).to.be.a('string').and.not.empty; });",
                  "if (body.access_token) { pm.collectionVariables.set('odoo_inbound_token', body.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{pos_login_email}}\",\n  \"password\": \"{{pos_login_password}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/login",
            "description": "ضع email/password في Collection Variables. النجاح يرجع access_token ويحفظه تلقائيًا في odoo_inbound_token."
          }
        }
      ]
    },
    {
      "name": "01 - Blend to Odoo (Required)",
      "description": "كل الأحداث الأساسية التي يرسلها Blend إلى Odoo.\nAuthorization: Bearer {{odoo_inbound_token}}",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{odoo_inbound_token}}", "type": "string"}]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
              "const body = pm.response.json();",
              "pm.test('status = success', function () { pm.expect(body.status).to.eql('success'); });",
              "pm.test('trace_id exists', function () { pm.expect(body.trace_id).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "00 - Check Connection & Auth",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Request-ID", "value": "{{request_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"branch_availability\",\n  \"event_time\": \"{{event_time}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"payload\": {\n    \"branch_id\": \"{{branch_id}}\",\n    \"is_available\": true\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/blend/webhook",
            "description": "ابدأ بهذا الطلب. HTTP 200 يعني أن URL والتوكن والفرع مضبوطين."
          }
        },
        {
          "name": "01 - Menu Sync",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Request-ID", "value": "{{request_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"menu_sync\",\n  \"event_time\": \"{{event_time}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"payload\": {\n    \"categories\": [{\n      \"id\": \"{{category_id}}\",\n      \"name\": {\"ar\": \"البيتزا\", \"en\": \"Pizza\"},\n      \"description\": {\"ar\": \"قسم البيتزا\", \"en\": \"Pizza category\"},\n      \"schedule_time\": {},\n      \"items\": [\"{{item_id}}\"]\n    }],\n    \"items\": [{\n      \"id\": \"{{item_id}}\",\n      \"name\": {\"ar\": \"بيتزا مارجريتا\", \"en\": \"Margherita Pizza\"},\n      \"description\": {\"ar\": \"صلصة طماطم وجبن\", \"en\": \"Tomato sauce and cheese\"},\n      \"price\": 150.0,\n      \"is_available\": true,\n      \"categories\": [\"{{category_id}}\"],\n      \"images\": [],\n      \"schedule_time\": {}\n    }],\n    \"toppings\": [{\n      \"id\": \"{{modifier_group_id}}\",\n      \"name\": {\"ar\": \"الإضافات\", \"en\": \"Add-ons\"},\n      \"is_required\": true,\n      \"min\": 1,\n      \"max\": 2,\n      \"max_per_quantity\": 2,\n      \"options\": [{\n        \"id\": \"{{modifier_id}}\",\n        \"name\": {\"ar\": \"جبن إضافي\", \"en\": \"Extra Cheese\"},\n        \"price\": 10.0\n      }],\n      \"items\": [\"{{item_id}}\"]\n    }],\n    \"branch_schedule_time\": {}\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/blend/webhook",
            "description": "شغّله أولًا لإنشاء الـ Menu والمنتجات والـ Modifiers داخل Odoo."
          }
        },
        {
          "name": "02 - Item Availability",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"item_availability\",\n  \"event_time\": \"{{event_time}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"payload\": {\n    \"item_id\": \"{{item_id}}\",\n    \"is_available\": {{is_available}}\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/blend/webhook",
            "description": "غيّر is_available في Variables إلى false للإخفاء أو true للإظهار."
          }
        },
        {
          "name": "03 - Modifier Availability",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"modifier_availability\",\n  \"event_time\": \"{{event_time}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"payload\": {\n    \"modifier_id\": \"{{modifier_id}}\",\n    \"is_available\": {{is_available}}\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/blend/webhook",
            "description": "يمكن وضع modifier_group_id بدل modifier_id لاختبار المجموعة كاملة."
          }
        },
        {
          "name": "04 - Branch Availability",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"branch_availability\",\n  \"event_time\": \"{{event_time}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"payload\": {\n    \"branch_id\": \"{{branch_id}}\",\n    \"is_available\": {{is_available}}\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/blend/webhook",
            "description": "false يعمل Pause، وtrue يعيد تشغيل الفرع."
          }
        },
        {
          "name": "05 - Order Status (Blend to Odoo)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"order_updated\",\n  \"event_time\": \"{{event_time}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"payload\": {\n    \"order_id\": \"{{odoo_order_id}}\",\n    \"status\": \"{{blend_to_odoo_status}}\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/blend/webhook",
            "description": "ضع Blend Order ID لطلب موجود. الحالات الأساسية: accepted, rejected, cancelled, prepared."
          }
        }
      ]
    },
    {
      "name": "02 - Blend calls Manual POS APIs (Required)",
      "description": "الـManual POS endpoints المنشورة في Blend: GET /api/menu، GET /api/branches، POST /api/orders، PUT /api/order/update.",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{odoo_inbound_token}}", "type": "string"}]
      },
      "item": [
        {
          "name": "01 - Get Full Menu",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                "const body = pm.response.json();",
                "pm.test('categories and pagination exist', function () { pm.expect(body.categories).to.be.an('array'); pm.expect(body.pagination).to.be.an('object'); });",
                "pm.test('all modifier maximums are positive', function () { const groups = body.categories.flatMap((category) => category.products || []).flatMap((product) => product.modifier_groups || []); groups.forEach((group) => { pm.expect(group.max_selection, 'max_selection for group ' + group.id).to.be.a('number').and.above(0); }); });"
              ]
            }
          }],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{odoo_inbound_token}}", "type": "string"}]
            },
            "method": "GET",
            "header": [{"key": "X-Request-ID", "value": "{{request_id}}"}],
            "url": "{{odoo_domain}}/api/menu",
            "description": "يسحب القائمة الكاملة من Odoo بدون Pagination أو Product Filter في رابط الطلب."
          }
        },
        {
          "name": "02 - Get Menu by Product ID",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                "const body = pm.response.json();",
                "pm.test('categories and pagination exist', function () { pm.expect(body.categories).to.be.an('array'); pm.expect(body.pagination).to.be.an('object'); });",
                "pm.test('filtered product exists and has a numeric ID', function () { const products = body.categories.flatMap((category) => category.products || []); const product = products.find((entry) => String(entry.id) === String(pm.variables.get('item_id'))); pm.expect(product, 'filtered product id').to.be.an('object'); pm.expect(product.id).to.be.a('number'); });",
                "pm.test('all modifier maximums are positive', function () { const groups = body.categories.flatMap((category) => category.products || []).flatMap((product) => product.modifier_groups || []); groups.forEach((group) => { pm.expect(group.max_selection, 'max_selection for group ' + group.id).to.be.a('number').and.above(0); }); });"
              ]
            }
          }],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{odoo_inbound_token}}", "type": "string"}]
            },
            "method": "GET",
            "header": [{"key": "X-Request-ID", "value": "{{request_id}}"}],
            "url": "{{odoo_domain}}/api/menu?page=1&per=25&filter['product_id']={{item_id}}",
            "description": "يسحب صفحة من القائمة بعد فلترتها برقم المنتج الموجود في المتغير item_id."
          }
        },
        {
          "name": "03 - Get Branches",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                "const body = pm.response.json();",
                "pm.test('configured branch exists', function () { pm.expect(body.branches).to.be.an('array'); pm.expect(body.branches.some((branch) => String(branch.id) === String(pm.variables.get('branch_id')))).to.eql(true); });"
              ]
            }
          }],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{odoo_inbound_token}}", "type": "string"}]
            },
            "method": "GET",
            "header": [{"key": "X-Request-ID", "value": "{{request_id}}"}],
            "url": "{{odoo_domain}}/api/branches",
            "description": "يرجع id/name/status/brand_id/location للفروع المرتبطة بنفس Login User."
          }
        },
        {
          "name": "04 - Create Order in POS",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const aggregatorOrderId = String(Date.now());",
                  "pm.collectionVariables.set('aggregator_order_id', aggregatorOrderId);",
                  "pm.collectionVariables.set('pos_partner_reference', pm.variables.get('aggregator') + ': ' + aggregatorOrderId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('order created', function () { pm.expect(body.success).to.eql(true); pm.expect(body.order_id).to.be.a('string').and.not.empty; });",
                  "if (body.order_id) { pm.collectionVariables.set('pos_created_order_id', body.order_id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{odoo_inbound_token}}", "type": "string"}]
            },
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Request-ID", "value": "{{request_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch_id\": \"{{branch_id}}\",\n  \"brand_id\": \"{{brand_id}}\",\n  \"partner_reference\": \"{{pos_partner_reference}}\",\n  \"order_type\": \"{{order_type}}\",\n  \"aggregator\": \"{{aggregator}}\",\n  \"aggregator_order_id\": \"{{aggregator_order_id}}\",\n  \"note\": \"cut in half please\",\n  \"total\": 103.5,\n  \"subtotal\": 100,\n  \"tax\": 13.5,\n  \"status\": \"PENDING\",\n  \"customer\": {\n    \"phone\": \"0122222\",\n    \"name\": \"SSSSW\"\n  },\n  \"products\": [\n    {\n      \"id\": \"{{item_id}}\",\n      \"quantity\": 2,\n      \"total\": 95.5,\n      \"note\": null,\n      \"modifiers\": [\n        {\n          \"id\": \"{{modifier_id}}\",\n          \"quantity\": 2,\n          \"total\": 8,\n          \"note\": \"Add cheese\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/orders",
            "description": "مطابق لعقد Blend المنشور، ويشمل order_type وaggregator وaggregator_order_id. يحتاج POS Session مفتوحة، ويحفظ order_id تلقائيًا لطلب Update Order التالي."
          }
        },
        {
          "name": "05 - Update Order in POS",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                "const body = pm.response.json();",
                "pm.test('order updated', function () { pm.expect(body.success).to.eql(true); pm.expect(body.status).to.eql(pm.variables.get('pos_order_status')); });"
              ]
            }
          }],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{odoo_inbound_token}}", "type": "string"}]
            },
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Request-ID", "value": "{{request_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{pos_created_order_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"brand_id\": \"{{brand_id}}\",\n  \"status\": \"{{pos_order_status}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{odoo_domain}}/api/order/update",
            "description": "الحالات: ACCEPTED، PREPARING، CANCELED، REJECTED، TIME_OUT."
          }
        }
      ]
    },
    {
      "name": "03 - Legacy Odoo to Blend (Separate Contract)",
      "description": "الطلبات الأساسية التي ترسلها Odoo إلى Blend.\nAuthorization: Bearer {{blend_outbound_token}}",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{blend_outbound_token}}", "type": "string"}]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status is 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "01 - Order Created",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('status = success', function () { pm.expect(body.status).to.eql('success'); });",
                  "pm.test('order_id exists', function () { pm.expect(body.order_id).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Request-ID", "value": "{{request_id}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"order_created\",\n  \"event_time\": \"{{event_time}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"payload\": {\n    \"id\": \"{{odoo_order_id}}\",\n    \"payment_method\": \"cash\",\n    \"order_type\": \"DELIVERY\",\n    \"note\": \"Postman sandbox test\",\n    \"subtotal\": 160.0,\n    \"tax\": 0.0,\n    \"discount\": 0.0,\n    \"total\": 160.0,\n    \"is_schedule\": 0,\n    \"schedule_date\": null,\n    \"car_data\": null,\n    \"items\": [{\n      \"id\": \"{{item_id}}\",\n      \"quantity\": 1,\n      \"price\": 150.0,\n      \"note\": \"\",\n      \"options\": [{\n        \"id\": \"{{modifier_id}}\",\n        \"price\": 10.0,\n        \"quantity\": 1\n      }]\n    }],\n    \"customer\": {\n      \"name\": \"Postman Customer\",\n      \"phone\": \"+201000000000\",\n      \"address\": \"Cairo, Egypt\"\n    }\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{blend_order_created_url}}",
            "description": "Expected: {\"order_id\":\"55\",\"status\":\"success\"}."
          }
        },
        {
          "name": "02 - Order Status (Odoo to Blend)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"order_updated\",\n  \"event_time\": \"{{event_time}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"payload\": {\n    \"order_id\": \"{{odoo_order_id}}\",\n    \"status\": \"{{delivery_status}}\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": "{{blend_order_status_url}}",
            "description": "الحالات: assigned, at_pick_up, on_the_way, cancelled, delivered. استخدم Odoo Order ID الأصلي."
          }
        }
      ]
    },
    {
      "name": "04 - Alternate POS Webhooks",
      "description": "استخدمه فقط إذا أكد فريق Blend استخدام Alternate POS schema.",
      "item": [
        {
          "name": "A - Blend to Odoo",
          "description": "Authorization: Bearer {{odoo_inbound_token}}",
