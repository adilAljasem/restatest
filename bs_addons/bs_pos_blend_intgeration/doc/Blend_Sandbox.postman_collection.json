{
  "info": {
    "_postman_id": "d3b61c2d-7b30-4dd4-b483-cb50d00ff2ad",
    "name": "Blend - PRODUCTION CONTRACT (Domain Only)",
    "description": "مجموعة مطابقة لعقود Blend المنشورة. ضع دومين Odoo فقط في odoo_domain؛ كل endpoints تُبنى منه تلقائيًا، بدون اسم قاعدة بيانات وبدون X-Odoo-Database. ابدأ بطلب POST /api/login باستخدام email/password؛ يتم حفظ access_token واستخدامه تلقائيًا كـ Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = new Date();",
          "pm.variables.set('event_time', now.toISOString().replace('T', ' ').replace(/\\.\\d{3}Z$/, ''));",
          "pm.variables.set('request_id', pm.variables.replaceIn('{{$guid}}'));",
          "let domain = String(pm.collectionVariables.get('odoo_domain') || '').trim();",
          "domain = domain.replace(/^(GET|POST|PUT|PATCH|DELETE)\\s+/i, '').replace(/\\/+$/, '');",
          "if (domain && !/^https?:\\/\\//i.test(domain)) { domain = 'https://' + domain; }",
          "pm.collectionVariables.set('odoo_domain', domain);"
        ]
      }
    }
  ],
  "variable": [
