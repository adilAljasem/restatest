        {
          "name": "B - Unified Outbound Webhook (Odoo to Blend)",
          "description": "All four events POST their complete JSON payload to blend_outbound_webhook_url. Set it to the URL supplied by Blend. Use blend_outbound_token only if Blend requires Bearer authentication; it is not the Odoo login token. Legacy order_created remains separate.",
          "auth": {
            "type": "bearer",
            "bearer": [{"key": "token", "value": "{{blend_outbound_token}}", "type": "string"}]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
                ]
              }
            }
          ],
          "item": [
            {
              "name": "01 - Order Updated",
