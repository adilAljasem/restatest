<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="blend_kitchen_print_company_rule" model="ir.rule">
        <field name="name">Blend kitchen printing by company</field>
        <field name="model_id" ref="model_blend_kitchen_print"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="blend_payment_mapping_company_rule" model="ir.rule">
        <field name="name">Blend payment mappings by company</field>
        <field name="model_id" ref="model_blend_payment_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="blend_log_company_rule" model="ir.rule">
        <field name="name">Blend logs by company</field>
        <field name="model_id" ref="model_blend_integration_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="blend_stock_state_company_rule" model="ir.rule">
        <field name="name">Blend stock delivery state by company</field>
        <field name="model_id" ref="model_blend_stock_state"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
