<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_receipt_settings_view_list" model="ir.ui.view">
        <field name="name">pos.config.receipt.settings.list</field>
        <field name="model">pos.config</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Receipt Settings" create="0" delete="0">
                <field name="name"/>
                <field name="receipt_design_id"/>
            </list>
        </field>
    </record>

    <record id="pos_receipt_settings_view_form" model="ir.ui.view">
        <field name="name">pos.config.receipt.settings.form</field>
        <field name="model">pos.config</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Receipt Settings" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Changes apply to the Arabic thermal receipt design. Reload the Point of Sale after saving.
                    </div>
                    <group>
                        <group string="Invoice Numbers">
                            <field name="receipt_show_reference" widget="boolean_toggle"/>
                            <field name="receipt_show_order_number" widget="boolean_toggle"/>
                            <field name="order_number_range_enabled" widget="boolean_toggle"/>
                            <field name="order_number_start" invisible="not order_number_range_enabled"
                                   required="order_number_range_enabled"/>
                            <field name="order_number_end" invisible="not order_number_range_enabled"
                                   required="order_number_range_enabled"/>
                            <div colspan="2" class="text-muted" invisible="not order_number_range_enabled">Example: from 1 to 100 gives 001, 002 ... 100, then 001 again. Numbering starts again from the start number at each new session.</div>
                            <div colspan="2" class="text-muted" invisible="not order_number_range_enabled">The order number always has 3 digits: the end number can be 999 at most.</div>
                            <div colspan="2" class="text-muted" invisible="order_number_range_enabled">Order numbers have 3 digits: 001 ... 999, then 001 again.</div>
                            <div colspan="2" class="text-muted" invisible="not order_number_range_enabled">The same number is shown on the POS screen, the customer receipt and the kitchen ticket.</div>
                        </group>
                        <group string="Items and Totals">
                            <field name="receipt_show_unit_price" widget="boolean_toggle"/>
                            <field name="receipt_show_item_english" widget="boolean_toggle"/>
                            <field name="receipt_show_totals_english" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Top of the Receipt">
                            <field name="receipt_show_header_text" widget="boolean_toggle"/>
                            <field name="receipt_top_text" invisible="not receipt_show_header_text"
                                   placeholder="Empty: company name"/>
                            <field name="receipt_show_customer_phone" widget="boolean_toggle"/>
                            <field name="receipt_show_opened_by" widget="boolean_toggle"/>
                            <field name="receipt_show_closed_by" widget="boolean_toggle"/>
                        </group>
                        <group string="Bottom of the Receipt">
                            <field name="receipt_show_bottom_text" widget="boolean_toggle"/>
                            <field name="receipt_bottom_text" invisible="not receipt_show_bottom_text"/>
                        </group>
                    </group>
                    <group>
                        <group string="Delivery Orders">
                            <field name="receipt_show_delivery" widget="boolean_toggle"/>
                        </group>
                        <group string="Printer">
                            <field name="receipt_print_width" widget="radio"/>
                            <field name="receipt_font_size" widget="radio" options="{'horizontal': true}"/>
                            <field name="receipt_print_sharp" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_receipt_settings" model="ir.actions.act_window">
        <field name="name">Receipt Settings</field>
        <field name="res_model">pos.config</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('pos_receipt_settings_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('pos_receipt_settings_view_form')})]"/>
    </record>

    <menuitem id="menu_pos_receipt_settings"
              name="Receipt Settings"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_receipt_settings"
              groups="point_of_sale.group_pos_manager"
              sequence="3"/>
</odoo>
