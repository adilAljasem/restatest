<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="dk_pos_employee_access_rights.PartnerList" t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension">
        <!-- Hide desktop Create button -->
        <xpath expr="//t[@t-set-slot='header']//button[@aria-label='Add a customer']" position="attributes">
            <attribute name="t-if"
                       add="!this.pos.getCashier()?.sbl_hide_pos_create_customer_button"
                       separator=" and "/>
        </xpath>
        <!-- Hide mobile New button -->
        <xpath expr="//t[@t-set-slot='footer']//button[@aria-label='Add a customer']" position="attributes">
            <attribute name="t-if"
                       add="!this.pos.getCashier()?.sbl_hide_pos_create_customer_button"
                       separator=" and "/>
        </xpath>
    </t>
</templates>
