<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="dk_pos_employee_access_rights.Numpad" t-inherit="point_of_sale.Numpad" t-inherit-mode="extension">
        <xpath expr="//div[contains(@t-attf-class,'numpad')]" position="before">
            <t t-set="current_employee" t-value="pos.getCashier()"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class,'numpad')]" position="attributes">
            <attribute name="t-if">!current_employee?.sbl_hide_pos_numpad</attribute>
        </xpath>
    </t>
</templates>
