#. module: dk_pos_employee_access_rights
#: model:ir.model.fields,field_description:dk_pos_employee_access_rights.field_hr_employee__sbl_disallow_pos_remove_sent_lines
#: model:ir.model.fields,field_description:dk_pos_employee_access_rights.field_hr_employee_public__sbl_disallow_pos_remove_sent_lines
msgid "Prevent Removing Lines Sent to Kitchen"
msgstr "منع حذف الأصناف المرسلة للمطبخ"

#. module: dk_pos_employee_access_rights
#: model:ir.model.fields,help:dk_pos_employee_access_rights.field_hr_employee__sbl_disallow_pos_remove_sent_lines
msgid ""
"If checked, this employee cannot delete an order line or decrease its "
"quantity below what was already sent to the kitchen, and cannot cancel an "
"order that contains lines already sent to the kitchen."
msgstr ""
"عند التفعيل لا يستطيع الموظف حذف صنف من الطلب أو تقليل كميته عن الكمية "
"المرسلة للمطبخ، ولا يستطيع إلغاء طلب يحتوي على أصناف مرسلة للمطبخ."

#. module: dk_pos_employee_access_rights
#. odoo-javascript
#: code:addons/dk_pos_employee_access_rights/static/src/overrides/services/pos_store.js:0
msgid ""
"You are not allowed to remove or decrease items already sent to the kitchen."
msgstr "غير مسموح لك بحذف أو تقليل كمية صنف تم إرساله للمطبخ."

#. module: dk_pos_employee_access_rights
#. odoo-javascript
#: code:addons/dk_pos_employee_access_rights/static/src/overrides/services/pos_store.js:0
msgid ""
"This order has items already sent to the kitchen and cannot be cancelled."
msgstr "هذا الطلب يحتوي على أصناف مرسلة للمطبخ ولا يمكن إلغاؤه."
