<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_ess" model="ir.ui.view">
        <field name="name">pos.config.form.ess</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <group name="ess_hr" string="HR (Self-Service)">
                    <group>
                        <field name="ess_work_location_id"/>
                        <field name="ess_require_attendance" invisible="not ess_work_location_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
