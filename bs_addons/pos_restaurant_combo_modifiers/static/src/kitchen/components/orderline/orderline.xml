<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_combo_modifiers.KitchenOrderline"
       t-inherit="pos_enterprise.Orderline"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pdis_orderline_warning')]" position="before">
            <div t-if="preparation_line.modifier_display_data?.length"
                 class="o_combo_modifier_kitchen_list d-flex flex-column gap-1 my-2 pe-2">
                <div t-foreach="preparation_line.modifier_display_data"
                     t-as="modifier"
                     t-key="modifier.key"
                     class="o_combo_modifier_kitchen_item d-flex align-items-baseline flex-wrap gap-1"
                     t-att-class="{
                         'text-decoration-line-through text-muted': modifier.change_status === 'removed',
                         'fw-semibold': modifier.change_status === 'added' || modifier.change_status === 'updated',
                     }">
                    <span class="o_combo_modifier_kitchen_symbol" t-esc="modifier.kind === 'instruction' ? '•' : '-'"/>
                    <span class="text-uppercase small fw-bold">
                        <t t-if="modifier.kind === 'instruction'">Instruction</t>
                        <t t-elif="modifier.operation === 'remove'">Remove</t>
                        <t t-else="">Add</t>
                    </span>
                    <span t-esc="modifier.name"/>
                    <span t-if="modifier.quantity !== 1" class="text-muted" t-esc="`×${modifier.quantity}`"/>
                    <span t-if="modifier.change_status === 'added'" class="badge rounded-pill text-bg-success">Added</span>
                    <span t-elif="modifier.change_status === 'removed'" class="badge rounded-pill text-bg-danger">Removed</span>
                    <span t-elif="modifier.change_status === 'updated'" class="badge rounded-pill text-bg-warning">Updated</span>
                </div>
            </div>
        </xpath>
    </t>
</templates>
