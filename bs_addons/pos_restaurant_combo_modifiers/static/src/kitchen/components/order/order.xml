<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_combo_modifiers.KitchenOrder"
       t-inherit="pos_enterprise.Order"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pdis_table-info')]" position="after">
            <div class="o_combo_modifier_kitchen_order_meta d-grid gap-1 pt-2 mt-2 border-top small">
                <div t-if="this.order.pos_order_id.kitchen_delivery_app" class="d-flex justify-content-between gap-2">
                    <span class="text-muted">App / التطبيق</span>
                    <strong class="text-break text-end" t-esc="this.order.pos_order_id.kitchen_delivery_app"/>
                </div>
                <div t-if="this.order.pos_order_id.kitchen_delivery_ref" class="d-flex justify-content-between gap-2">
                    <span class="text-muted">App Order No.</span>
                    <strong class="text-break text-end" t-esc="this.order.pos_order_id.kitchen_delivery_ref"/>
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <span class="text-muted">Order Number</span>
                    <strong class="text-break text-end" t-esc="this.order.pos_order_id.name"/>
                </div>
                <div t-if="this.order.pos_order_id.kitchen_table_name" class="d-flex justify-content-between gap-2">
                    <span class="text-muted">Table Number</span>
                    <strong t-esc="this.order.pos_order_id.kitchen_table_name"/>
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <span class="text-muted">Order Time</span>
                    <strong t-esc="this.order.pos_order_id.date_order?.toFormat('HH:mm') || ''"/>
                </div>
                <div t-if="this.order.pos_order_id.kitchen_cashier_name" class="d-flex justify-content-between gap-2">
                    <span class="text-muted">Cashier</span>
                    <strong class="text-break text-end" t-esc="this.order.pos_order_id.kitchen_cashier_name"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
