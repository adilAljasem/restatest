msgid "Blind count"
msgstr "الجرد الفعلي"

#. module: pos_blind_closing
#. odoo-javascript
#: code:addons/pos_blind_closing/static/src/closing_popup/closing_popup.xml:0
msgid "Count the cash in the drawer and the card terminal totals, then enter the actual amounts carefully."
msgstr "اعدد النقد في الدرج وإجماليات أجهزة الشبكة، ثم أدخل المبالغ الفعلية بدقة."

#. module: pos_blind_closing
#. odoo-javascript
#: code:addons/pos_blind_closing/static/src/closing_popup/closing_popup.js:0
msgid "Confirm counted amounts"
msgstr "تأكيد المبالغ المُدخلة"

#. module: pos_blind_closing
#. odoo-javascript
#: code:addons/pos_blind_closing/static/src/closing_popup/closing_popup.js:0
msgid "Please make sure the amounts below are correct. They cannot be changed after closing."
msgstr "تأكد من صحة المبالغ التالية، لا يمكن تعديلها بعد الإقفال."

#. module: pos_blind_closing
#. odoo-javascript
#: code:addons/pos_blind_closing/static/src/closing_popup/closing_popup.js:0
msgid "Close Register"
msgstr "إقفال الصندوق"

