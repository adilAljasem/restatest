<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_closing_report_generate_form" model="ir.ui.view">
        <field name="name">pos.closing.report.generate.form</field>
        <field name="model">pos.closing.report.generate</field>
        <field name="arch" type="xml">
            <form string="Generate Closing Reports Retroactively">
                <p class="text-muted">Creates a closing report for every closed session that does not have one yet. Cash expected and counted amounts are read from the session. For Bank payment methods of old sessions, the counted amount is assumed equal to the expected amount because Odoo does not store what the cashier entered.</p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="config_ids" widget="many2many_tags"/>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="regenerate"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_closing_report_generate" model="ir.actions.act_window">
        <field name="name">Generate Retroactively</field>
        <field name="res_model">pos.closing.report.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pos_closing_report_generate" name="Generate Retroactively"
              parent="menu_pos_closing_report_root" action="action_pos_closing_report_generate" sequence="2"/>
</odoo>
