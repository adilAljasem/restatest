<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="product_modifiers.OrderSummary" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//Orderline" position="inside">
            <t t-set-slot="default">
            <t t-if="line.product_id and line.product_id.is_modifier">
                <li>
                    <button class="modifier-product-btn" t-on-click.stop="() => this.ediModifiers(line)">
                        <i class="fa fa-edit" />
                        <span> </span>
                        <span>Modifier</span>
                    </button>
                </li>
            </t>
            </t>
        </xpath>
    </t>
</templates>
