<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="product_variant_action_custom" model="ir.actions.act_window">
            <field name="name">Product Variants</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.product</field>
            <field name="context">{'search_default_product_tmpl_id': [active_id],
                'default_product_tmpl_id': active_id}</field>
            <field name="search_view_id" ref="product.product_search_form_view" />
            <field name="view_ids"
                eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list'}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_normal_form_view')}),
                          (0, 0, {'view_mode': 'kanban'})]" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to define a new product.
                </p>
                <p>
                    You must define a product for everything you sell, whether it's
                    a physical product, a consumable or a service you offer to
                    customers.
                </p>
                <p>
                    The product form contains information to simplify the sale
                    process: price, notes in the quotation, accounting data,
                    procurement methods, etc.
                </p>
            </field>
        </record>

    </data>
</odoo>