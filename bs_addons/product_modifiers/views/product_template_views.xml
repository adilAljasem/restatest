<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="point_of_sale.product_template_action_pos_product" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain" eval="[('use_as_modifier', '!=', True)]" />
            <field name="context" eval="{'search_default_filter_to_availabe_pos': 1}" />
        </record>
        <record id="product_template_form_view_kanak_inh" model="ir.ui.view">
            <field name="name">product.template.common.form.kanak.inh</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='options']" position="inside">
                    <div invisible="use_as_modifier == True">
                        <field name="is_modifier" />
                        <label for="is_modifier" />
                    </div>
                    <div>
                        <field name="allow_portion" />
                        <label for="allow_portion" />
                    </div>
                    <div>
                        <field name="use_as_modifier" />
                        <label for="use_as_modifier" />
                    </div>
                </xpath>
                <xpath expr="//page[@name='inventory']" position="after">
                    <page name="product_modifiers" string="Modifiers" invisible="not is_modifier">
                        <group>
                            <label for="modifier_grp_ids" />
                            <div class="o_row">
                                <field name="modifier_grp_ids" widget="many2many_tags" />
                                <button name="get_modifier" string="Get Modifier" type="object"
                                    class="oe_highlight" />
                            </div>
                        </group>
                        <field name="modifier_ids">
                            <list editable="bottom" string="Modifiers Lines">
                                <field name="name" />
                                <field name="desc" />
                                <field name="price" />
                                <field name="apply_selector" />
                                <field name="min_selector" readonly="not apply_selector" />
                                <field name="max_selector" readonly="not apply_selector" />
                                <field name="product_id" invisible="1" />
                            </list>
                        </field>
                    </page>
                    <page name="product_modifier_sides" string="Sides Products" invisible="not is_modifier">
                        <group>
                            <label for="slice_product_ids" />
                            <div class="o_row">
                                <field name="slice_product_ids" widget="many2many_tags"
                                    domain="[('available_in_pos', '=', True)]" />
                            </div>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="product_template_only_form_view_kanak_inh" model="ir.ui.view">
            <field name="name">product.template.only.form.kanak.inh</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="arch" type="xml">
                <button icon="fa-sitemap" position="replace">
                    <button name="%(product_variant_action_custom)d" type="action" icon="fa-sitemap"
                        class="oe_stat_button" invisible="product_variant_count &lt;= '1'"
                        groups="product.group_product_variant">
                        <field string="Variants" name="product_variant_count" widget="statinfo" />
                    </button>
                </button>
            </field>
        </record>
    </data>
</odoo>
