<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pino_guest_stay_pivot" model="ir.ui.view">
        <field name="name">pos.order.pivot.pino.guest.stay</field>
        <field name="model">pos.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Guest Stay" sample="1">
                <field name="pino_opened_config_id" type="row"/>
                <field name="date_order" interval="day" type="col"/>
                <field name="pino_stay_duration" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="view_pino_guest_stay_graph" model="ir.ui.view">
        <field name="name">pos.order.graph.pino.guest.stay</field>
        <field name="model">pos.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Guest Stay" type="bar" sample="1">
                <field name="date_order" interval="day"/>
                <field name="pino_stay_minutes" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_pino_guest_stay_list" model="ir.ui.view">
        <field name="name">pos.order.list.pino.guest.stay</field>
        <field name="model">pos.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Guest Stay" create="0" edit="0">
                <field name="name"/>
                <field name="table_id"/>
                <field name="pino_opened_by_name"/>
                <field name="pino_opened_at"/>
                <field name="pino_closed_by_name"/>
                <field name="pino_closed_at"/>
                <field name="pino_stay_duration" widget="float_time"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_pino_guest_stay_analysis" model="ir.actions.act_window">
        <field name="name">Guest Stay</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('table_id', '!=', False), ('pino_closed_at', '!=', False), ('state', 'in', ('paid', 'done', 'invoiced'))]</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'pivot', 'view_id': ref('view_pino_guest_stay_pivot')}),
            Command.create({'view_mode': 'graph', 'view_id': ref('view_pino_guest_stay_graph')}),
            Command.create({'view_mode': 'list', 'view_id': ref('view_pino_guest_stay_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No closed table orders yet</p>
            <p>Guest stay is measured from opening the table until it is paid.</p>
        </field>
    </record>

    <menuitem id="menu_pino_guest_stay_analysis"
              name="Guest Stay"
              action="action_pino_guest_stay_analysis"
              parent="point_of_sale.menu_point_rep"
              sequence="5"/>
</odoo>
