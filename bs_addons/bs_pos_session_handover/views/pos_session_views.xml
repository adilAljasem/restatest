<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form_inherit_pino_session_handover" model="ir.ui.view">
        <field name="name">pos.session.form.inherit.pino.session.handover</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='open_frontend_cb']" position="after">
                <button name="action_pino_prepare_table_handover"
                        type="object"
                        string="Transfer Open Tables"
                        class="btn-secondary"
                        invisible="state == 'closed' or rescue"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_pino_view_handover_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="pino_handover_order_count == 0">
                    <field name="pino_handover_order_count" widget="statinfo" string="Table Transfers"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_pos_session_tree_inherit_pino_session_handover" model="ir.ui.view">
        <field name="name">pos.session.list.inherit.pino.session.handover</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="pino_handover_order_count" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
