<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pino_bill_color" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pino.bill.color</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="pos_restaurant.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="iface_printbill" position="inside">
                <div class="content-group" invisible="not pos_iface_printbill">
                    <div class="mt8">
                        <label for="pos_pino_bill_printed_color" string="Table color after printing the bill" class="o_light_label me-2"/>
                        <field name="pos_pino_bill_printed_color" widget="color"/>
                    </div>
                </div>
            </setting>
        </field>
    </record>
</odoo>
