<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="profit_loss_by_center" model="account.report">
        <field name="name">Profit and Loss by Center</field>
        <field name="sequence">21</field>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="filter_budgets" eval="True"/>
        <field name="allow_account_audit_status_on_lines" eval="True"/>
        <field name="default_opening_date_filter">this_year</field>
        <field name="custom_handler_model_id" ref="model_bs_profit_loss_by_center_report_handler"/>
        <field name="column_ids">
            <record id="profit_loss_by_center_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="profit_loss_by_center_revenue" model="account.report.line">
                <field name="name">Revenue</field>
                <field name="code">REV</field>
                <field name="sequence">10</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_revenue_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'income')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_cost_sales" model="account.report.line">
                <field name="name">Less Costs of Revenue</field>
                <field name="code">COS</field>
                <field name="sequence">20</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_cost_sales_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost')]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_gross_profit" model="account.report.line">
                <field name="name">Gross Profit</field>
                <field name="code">GRP</field>
                <field name="sequence">30</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_gross_profit_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">REV.balance - COS.balance</field>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_expense" model="account.report.line">
                <field name="name">Less Operating Expenses</field>
                <field name="code">EXP</field>
                <field name="sequence">40</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_expense_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense')]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_operating_income" model="account.report.line">
                <field name="name">Operating Income (or Loss)</field>
                <field name="code">INC</field>
                <field name="sequence">50</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_operating_income_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">REV.balance - COS.balance - EXP.balance</field>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_other_income" model="account.report.line">
                <field name="name">Plus Other Income</field>
                <field name="code">OIN</field>
                <field name="sequence">60</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_other_income_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'income_other')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_other_expense" model="account.report.line">
                <field name="name">Less Other Expenses</field>
                <field name="code">OEXP</field>
                <field name="sequence">70</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_other_expense_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', 'in', ('expense_other', 'expense_depreciation'))]"/>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_net_profit" model="account.report.line">
                <field name="name">Net Profit</field>
                <field name="code">NEP</field>
                <field name="sequence">80</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_net_profit_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">REV.balance + OIN.balance - COS.balance - EXP.balance - OEXP.balance</field>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_allocations" model="account.report.line">
                <field name="name">Less Allocations and Plus Withdrawals</field>
                <field name="code">ALLOC</field>
                <field name="sequence">90</field>
                <field name="hierarchy_level">1</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_allocations_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'equity_unaffected')]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>

            <record id="profit_loss_by_center_net_profit_after_allocations" model="account.report.line">
                <field name="name">Net Profit Left After Allocations and Withdrawals</field>
                <field name="code">NEPAL</field>
                <field name="sequence">100</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="profit_loss_by_center_net_profit_after_allocations_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">NEP.balance - ALLOC.balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

    <record id="action_profit_loss_by_center" model="ir.actions.client">
        <field name="name">Profit and Loss by Center</field>
        <field name="tag">account_report</field>
        <field name="path">profit-and-loss-by-center</field>
        <field name="context" eval="{'report_id': ref('profit_loss_by_center')}"/>
    </record>

    <record id="account_reports.menu_action_account_report_balance_sheet" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>
    <record id="account_reports.menu_action_account_report_profit_and_loss" model="ir.ui.menu">
        <field name="sequence">20</field>
    </record>
    <menuitem id="menu_action_profit_loss_by_center"
              name="Profit and Loss by Center"
              action="action_profit_loss_by_center"
              parent="account.account_reports_legal_statements_menu"
              sequence="21"
              groups="account.group_account_readonly,account.group_account_basic"/>
    <record id="account_reports.menu_action_account_report_cash_flow" model="ir.ui.menu">
        <field name="sequence">30</field>
    </record>
</odoo>

