<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_form_center_type" model="ir.ui.view">
        <field name="name">account.analytic.account.form.center.type</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <field name="plan_id" position="after">
                <field name="bs_center_type"/>
            </field>
        </field>
    </record>

    <record id="view_account_analytic_account_list_center_type" model="ir.ui.view">
        <field name="name">account.analytic.account.list.center.type</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list"/>
        <field name="arch" type="xml">
            <field name="plan_id" position="after">
                <field name="bs_center_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_analytic_account_search_center_type" model="ir.ui.view">
        <field name="name">account.analytic.account.search.center.type</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="bs_center_type"/>
            </field>
            <filter name="associatedpartner" position="after">
                <filter string="Center Type" name="group_by_bs_center_type" context="{'group_by': 'bs_center_type'}"/>
            </filter>
        </field>
    </record>
</odoo>

