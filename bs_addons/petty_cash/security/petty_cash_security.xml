<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Petty Cash Category under Accounting -->
        <record id="module_category_petty_cash" model="ir.module.category">
            <field name="name">Petty Cash</field>
            <field name="description">Access rights for petty cash management</field>
            <field name="sequence">105</field>
            <field name="parent_id" ref="base.module_category_accounting"/>
        </record>

        <!-- Odoo 19: res.groups.category_id was removed; groups are now grouped
             through res.groups.privilege, which itself points at the
             ir.module.category above. Settings > Users looks unchanged. -->
        <record id="res_groups_privilege_petty_cash" model="res.groups.privilege">
            <field name="name">Petty Cash</field>
            <field name="description">Access rights for petty cash management</field>
            <field name="category_id" ref="module_category_petty_cash"/>
            <field name="sequence">105</field>
        </record>

        <!-- User Group -->
        <record id="group_petty_cash_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
            <field name="sequence">10</field>
            <field name="comment">Can create requests for self and subordinates</field>
        </record>

        <!-- Administrator Group (implies User) -->
        <record id="group_petty_cash_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
            <field name="comment">Can create requests for all employees</field>
        </record>

        <!-- Record Rules for Users -->
        <record id="petty_cash_request_user_rule" model="ir.rule">
            <field name="name">Petty Cash: User can see own and subordinates requests (Multi-Company)</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="domain_force">[
                ('company_id', 'in', company_ids),
                '|',
                ('requester_emp_id.user_id', '=', user.id),
                ('requester_emp_id.parent_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rules for Administrators -->
        <record id="petty_cash_request_admin_rule" model="ir.rule">
            <field name="name">Petty Cash: Administrator can see all requests (Multi-Company)</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_petty_cash_administrator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>