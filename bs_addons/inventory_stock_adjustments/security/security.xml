<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_stock_adjustments" model="ir.module.category">
        <field name="name">Stock Adjustments</field>
        <field name="description">Helps you manage your inventory adjustments</field>
        <field name="sequence">10</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_stock_adjustment">
        <field name="name">Stock Adjustments</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="module_category_stock_adjustments"/>
    </record>

    <record id="group_stock_adjustments_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_adjustment"/>
    </record>

    <record id="group_stock_adjustments_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_adjustment"/>
        <field name="implied_ids" eval="[(4, ref('group_stock_adjustments_user'))]"/>
    </record>

    <record id="inventory_template_company_rule" model="ir.rule">
        <field name="name">Inventory templates: allowed companies</field>
        <field name="model_id" ref="model_stock_inventory_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="inventory_template_line_company_rule" model="ir.rule">
        <field name="name">Inventory template products: allowed companies</field>
        <field name="model_id" ref="model_stock_inventory_template_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
