<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_vendor_bill_date_controls" model="ir.ui.view">
        <field name="name">account.move.form.vendor.bill.date.controls</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Keep Odoo's existing requirements for refunds and receipts while
                 explicitly preserving the Vendor Bill requirement. -->
            <xpath
                expr="//*[@id='header_right_group']/field[@name='invoice_date'][@required]"
                position="attributes"
            >
                <attribute name="required">
                    move_type in ('in_invoice', 'in_refund', 'in_receipt')
                </attribute>
            </xpath>
            <xpath
                expr="//*[@id='header_right_group']//label[@for='invoice_date_due']"
                position="attributes"
            >
                <attribute name="invisible">
                    move_type == 'in_invoice' or invoice_payment_term_id
                </attribute>
            </xpath>
            <xpath
                expr="//*[@id='header_right_group']//label[@for='invoice_payment_term_id']"
                position="attributes"
            >
                <attribute name="invisible">
                    not invoice_payment_term_id and move_type != 'in_invoice'
                </attribute>
            </xpath>
            <xpath
                expr="//div[@name='due_date']/field[@name='invoice_date_due']"
                position="attributes"
            >
                <attribute name="invisible">
                    move_type == 'in_invoice' or invoice_payment_term_id
                </attribute>
            </xpath>
            <xpath
                expr="//div[@name='due_date']/field[@name='invoice_payment_term_id']"
                position="attributes"
            >
                <attribute name="required">
                    move_type == 'in_invoice' and state == 'draft'
                </attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']/span" position="attributes">
                <attribute name="invisible">
                    move_type == 'in_invoice' or state != 'draft' or invoice_payment_term_id
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_vendor_bill_date_controls" model="ir.ui.view">
        <field name="name">account.invoice.list.vendor.bill.date.controls</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="column_invisible">
                    context.get('default_move_type') == 'in_invoice'
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
