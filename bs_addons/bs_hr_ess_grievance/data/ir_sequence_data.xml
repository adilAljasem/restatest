<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_ess_grievance" model="ir.sequence">
        <field name="name">ESS Grievance</field>
        <field name="code">bs.hr.grievance</field>
        <field name="prefix">GRV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_ess_disciplinary" model="ir.sequence">
        <field name="name">ESS Disciplinary action</field>
        <field name="code">bs.hr.disciplinary</field>
        <field name="prefix">DIS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
