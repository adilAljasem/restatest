#. module: pos_cash_management
#: model_terms:ir.ui.view,arch_db:pos_cash_management.res_config_settings_view_form_pcm
msgid ""
"Hides the theoretical balance, the live difference and the auto-fill button "
"at closing."
msgstr "يخفي الرصيد المتوقع والفرق اللحظي وزر التعبئة التلقائية عند الإقفال."

#. module: pos_cash_management
#: model:ir.model.fields,help:pos_cash_management.field_pos_config__pcm_blind_count
#: model:ir.model.fields,help:pos_cash_management.field_res_config_settings__pos_pcm_blind_count
msgid ""
"Hides the theoretical balance, the live difference and the auto-fill button "
"at closing. The amounts are stripped on the server, not only in the "
"interface. Applies to every user, managers included."
msgstr ""
"يخفي الرصيد المتوقع والفرق اللحظي وزر التعبئة التلقائية عند الإقفال. الأرقام"
" تُحذف على مستوى الخادم لا في الواجهة فقط. يُطبَّق على جميع المستخدمين بمن "
"فيهم المدير."

