<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Appraisals: internal users see their own appraisals and those they review as manager;
             HR officers see everything of their companies. -->
        <record id="rule_appraisal_user" model="ir.rule">
            <field name="name">ESS appraisal: own / managed</field>
            <field name="model_id" ref="model_bs_hr_ess_appraisal"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('manager_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_appraisal_hr" model="ir.rule">
            <field name="name">ESS appraisal: HR</field>
            <field name="model_id" ref="model_bs_hr_ess_appraisal"/>
            <field name="groups" eval="[(4, ref('bs_hr_ess_base.group_ess_hr_officer'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_appraisal_line_user" model="ir.rule">
            <field name="name">ESS appraisal line: own / managed</field>
            <field name="model_id" ref="model_bs_hr_ess_appraisal_line"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('appraisal_id.employee_id.user_id', '=', user.id), ('appraisal_id.manager_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_appraisal_line_hr" model="ir.rule">
            <field name="name">ESS appraisal line: HR</field>
            <field name="model_id" ref="model_bs_hr_ess_appraisal_line"/>
            <field name="groups" eval="[(4, ref('bs_hr_ess_base.group_ess_hr_officer'))]"/>
            <field name="domain_force">[('appraisal_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_cycle_company" model="ir.rule">
            <field name="name">ESS appraisal cycle: company</field>
            <field name="model_id" ref="model_bs_hr_appraisal_cycle"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_template_company" model="ir.rule">
            <field name="name">ESS appraisal template: company</field>
            <field name="model_id" ref="model_bs_hr_appraisal_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="rule_goal_user" model="ir.rule">
            <field name="name">ESS goal: own / managed</field>
            <field name="model_id" ref="model_bs_hr_goal"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('manager_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_goal_hr" model="ir.rule">
            <field name="name">ESS goal: HR</field>
            <field name="model_id" ref="model_bs_hr_goal"/>
            <field name="groups" eval="[(4, ref('bs_hr_ess_base.group_ess_hr_officer'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_kudos_user" model="ir.rule">
            <field name="name">ESS kudos: sent / received</field>
            <field name="model_id" ref="model_bs_hr_kudos"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('from_employee_id.user_id', '=', user.id), ('to_employee_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_kudos_hr" model="ir.rule">
            <field name="name">ESS kudos: HR</field>
            <field name="model_id" ref="model_bs_hr_kudos"/>
            <field name="groups" eval="[(4, ref('bs_hr_ess_base.group_ess_hr_officer'))]"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
