<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kudos_list" model="ir.ui.view">
        <field name="name">bs.hr.kudos.list</field>
        <field name="model">bs.hr.kudos</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="from_employee_id"/>
                <field name="to_employee_id"/>
                <field name="badge" widget="badge"/>
                <field name="message"/>
                <field name="work_location_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_kudos_form" model="ir.ui.view">
        <field name="name">bs.hr.kudos.form</field>
        <field name="model">bs.hr.kudos</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="from_employee_id"/>
                            <field name="to_employee_id"/>
                            <field name="badge"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_kudos_search" model="ir.ui.view">
        <field name="name">bs.hr.kudos.search</field>
        <field name="model">bs.hr.kudos</field>
        <field name="arch" type="xml">
            <search>
                <field name="to_employee_id"/>
                <field name="from_employee_id"/>
                <filter name="this_month" string="This month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_to" string="Receiver" context="{'group_by': 'to_employee_id'}"/>
                    <filter name="group_badge" string="Badge" context="{'group_by': 'badge'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_kudos_pivot" model="ir.ui.view">
        <field name="name">bs.hr.kudos.pivot</field>
        <field name="model">bs.hr.kudos</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="to_employee_id" type="row"/>
                <field name="badge" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="action_kudos" model="ir.actions.act_window">
        <field name="name">Kudos</field>
        <field name="res_model">bs.hr.kudos</field>
        <field name="view_mode">list,pivot,form</field>
    </record>
</odoo>
