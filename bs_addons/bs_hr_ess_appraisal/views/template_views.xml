<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_template_form" model="ir.ui.view">
        <field name="name">bs.hr.appraisal.template.form</field>
        <field name="model">bs.hr.appraisal.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Kitchen staff appraisal"/></h1></div>
                    <group>
                        <group>
                            <field name="is_probation"/>
                            <field name="kpi_weight"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="total_weight"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="competency_id"/>
                            <field name="weight" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_template_list" model="ir.ui.view">
        <field name="name">bs.hr.appraisal.template.list</field>
        <field name="model">bs.hr.appraisal.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_probation"/>
                <field name="kpi_weight"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_template" model="ir.actions.act_window">
        <field name="name">Appraisal Templates</field>
        <field name="res_model">bs.hr.appraisal.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
