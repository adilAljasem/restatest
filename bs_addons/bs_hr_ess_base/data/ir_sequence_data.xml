<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_ess_request" model="ir.sequence">
        <field name="name">ESS Request</field>
        <field name="code">bs.hr.request</field>
        <field name="prefix">REQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_ess_profile_change" model="ir.sequence">
        <field name="name">ESS Profile Update</field>
        <field name="code">bs.hr.profile.change</field>
        <field name="prefix">UPD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
