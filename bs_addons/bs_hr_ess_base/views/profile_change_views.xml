<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Standard request header used by every ESS request form:
        copy this block in your own form views.
    -->
    <record id="view_profile_change_form" model="ir.ui.view">
        <field name="name">bs.hr.profile.change.form</field>
        <field name="model">bs.hr.profile.change</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ess_approve" type="object" string="Approve" class="btn-primary" invisible="not can_ess_approve"/>
                    <button name="action_ess_reject_wizard" type="object" string="Reject" invisible="not can_ess_approve"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'in_approval')"/>
                    <button name="action_reset_draft" type="object" string="Reset to draft" invisible="state not in ('rejected', 'cancelled')" groups="bs_hr_ess_base.group_ess_hr_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_approval,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="current_approver_ids" widget="many2many_tags" invisible="state != 'in_approval'"/>
                            <field name="can_ess_approve" invisible="1"/>
                        </group>
                        <group>
                            <field name="submit_date"/>
                            <field name="decision_date"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested changes" name="changes">
                            <group>
                                <group>
                                    <field name="new_mobile" readonly="state != 'draft'"/>
                                    <field name="new_private_email" readonly="state != 'draft'"/>
                                    <field name="new_private_street" readonly="state != 'draft'"/>
                                    <field name="new_private_city" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="new_emergency_contact" readonly="state != 'draft'"/>
                                    <field name="new_emergency_phone" readonly="state != 'draft'"/>
                                    <field name="new_iban" readonly="state != 'draft'"/>
                                    <field name="new_bank_name" readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <field name="employee_note" placeholder="Notes"/>
                        </page>
                        <page string="Approvals" name="approvals">
                            <field name="approval_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="approver_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge"/>
                                    <field name="decided_by_id"/>
                                    <field name="decided_on"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_profile_change_list" model="ir.ui.view">
        <field name="name">bs.hr.profile.change.list</field>
        <field name="model">bs.hr.profile.change</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="submit_date"/>
                <field name="current_approver_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_profile_change_search" model="ir.ui.view">
        <field name="name">bs.hr.profile.change.search</field>
        <field name="model">bs.hr.profile.change</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="to_approve" string="To approve" domain="[('current_approver_ids', 'in', [uid])]"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('submitted', 'in_approval'))]"/>
            </search>
        </field>
    </record>

    <record id="action_profile_change" model="ir.actions.act_window">
        <field name="name">Profile Updates</field>
        <field name="res_model">bs.hr.profile.change</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
