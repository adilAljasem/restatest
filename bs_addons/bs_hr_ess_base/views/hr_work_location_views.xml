<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_work_location_form_view_ess" model="ir.ui.view">
        <field name="name">hr.work.location.form.ess</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <notebook name="ess_notebook">
                    <page name="ess_general" string="Self-Service">
                        <group>
                            <group>
                                <field name="ess_manager_id"/>
                                <field name="ess_employee_count"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="hr_work_location_tree_view_ess" model="ir.ui.view">
        <field name="name">hr.work.location.list.ess</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ess_manager_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="action_ess_branches" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">hr.work.location</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
