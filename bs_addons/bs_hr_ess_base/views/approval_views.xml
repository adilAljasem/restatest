<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval flows -->
    <record id="view_approval_flow_list" model="ir.ui.view">
        <field name="name">bs.hr.approval.flow.list</field>
        <field name="model">bs.hr.approval.flow</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="res_model"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="condition_domain"/>
            </list>
        </field>
    </record>

    <record id="view_approval_flow_form" model="ir.ui.view">
        <field name="name">bs.hr.approval.flow.form</field>
        <field name="model">bs.hr.approval.flow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Loans above 5,000"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="res_model"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="condition_domain" widget="domain" options="{'model': 'res_model', 'in_dialog': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Steps" name="steps">
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="group_id" invisible="approver_type != 'group'" required="approver_type == 'group'"/>
                                    <field name="user_ids" widget="many2many_tags" invisible="approver_type != 'users'" required="approver_type == 'users'"/>
                                    <field name="condition_domain"/>
                                    <field name="sla_hours"/>
                                    <field name="escalation"/>
                                    <field name="escalation_user_ids" widget="many2many_tags" invisible="escalation != 'users'"/>
                                </list>
                            </field>
                            <div class="text-muted small">
                                Steps without any approver (e.g. no manager set) are skipped automatically.
                                An employee can never approve his own request.
                                Step conditions use a domain on the request, e.g. [("amount", "&gt;", 5000)].
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_flow" model="ir.actions.act_window">
        <field name="name">Approval Flows</field>
        <field name="res_model">bs.hr.approval.flow</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define who approves each type of request</p>
            <p>Without a flow, requests go to the direct manager and then to HR.</p>
        </field>
    </record>

    <!-- Approval lines -->
    <record id="view_approval_line_list" model="ir.ui.view">
        <field name="name">bs.hr.approval.line.list</field>
        <field name="model">bs.hr.approval.line</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="state == 'pending' and sla_breached" decoration-muted="state in ('skipped', 'cancelled')">
                <field name="request_name"/>
                <field name="employee_id"/>
                <field name="work_location_id" optional="show"/>
                <field name="name"/>
                <field name="approver_ids" widget="many2many_tags"/>
                <field name="date_pending"/>
                <field name="deadline" optional="show"/>
                <field name="decided_by_id" optional="show"/>
                <field name="decided_on" optional="show"/>
                <field name="duration_hours" optional="hide"/>
                <field name="sla_breached" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-warning="state == 'pending'"/>
                <field name="res_model" column_invisible="1"/>
                <button name="action_open_request" type="object" icon="fa-external-link" title="Open request"/>
            </list>
        </field>
    </record>

    <record id="view_approval_line_search" model="ir.ui.view">
        <field name="name">bs.hr.approval.line.search</field>
        <field name="model">bs.hr.approval.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_name"/>
                <field name="employee_id"/>
                <field name="approver_ids"/>
                <filter name="to_approve" string="To approve by me" domain="[('state', '=', 'pending'), ('approver_ids', 'in', [uid])]"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="sla" string="SLA breached" domain="[('sla_breached', '=', True)]"/>
                <group>
                    <filter name="group_model" string="Request type" context="{'group_by': 'res_model'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'work_location_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_approval_line_pivot" model="ir.ui.view">
        <field name="name">bs.hr.approval.line.pivot</field>
        <field name="model">bs.hr.approval.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="res_model" type="row"/>
                <field name="state" type="col"/>
                <field name="duration_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_my_approvals" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">bs.hr.approval.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Nothing waiting for you</p></field>
    </record>

    <record id="action_all_approvals" model="ir.actions.act_window">
        <field name="name">Approvals Analysis</field>
        <field name="res_model">bs.hr.approval.line</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <!-- Delegations -->
    <record id="view_delegation_list" model="ir.ui.view">
        <field name="name">bs.hr.approval.delegation.list</field>
        <field name="model">bs.hr.approval.delegation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="delegate_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="action_delegation" model="ir.actions.act_window">
        <field name="name">Approval Delegations</field>
        <field name="res_model">bs.hr.approval.delegation</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Decision wizard -->
    <record id="view_decision_wizard_form" model="ir.ui.view">
        <field name="name">bs.hr.ess.decision.wizard.form</field>
        <field name="model">bs.hr.ess.decision.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="decision" widget="radio" options="{'horizontal': true}"/>
                    <field name="comment" required="decision == 'reject'"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_ids" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
