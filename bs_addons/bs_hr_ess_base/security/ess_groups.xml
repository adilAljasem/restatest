<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_ess" model="res.groups.privilege">
        <field name="name">Employee Self-Service</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_ess_branch_supervisor" model="res.groups">
        <field name="name">Branch Supervisor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ess"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Approves requests and follows attendance of the branches / teams they manage.</field>
    </record>

    <record id="group_ess_hr_officer" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ess"/>
        <field name="implied_ids" eval="[(4, ref('group_ess_branch_supervisor')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_ess_hr_manager" model="res.groups">
        <field name="name">HR Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_ess"/>
        <field name="implied_ids" eval="[(4, ref('group_ess_hr_officer')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_ess_payroll_officer" model="res.groups">
        <field name="name">ESS Payroll Officer</field>
        <field name="implied_ids" eval="[(4, ref('group_ess_hr_officer'))]"/>
        <field name="comment">Manages payroll adjustments, loans and payslip objections.</field>
    </record>

    <record id="group_ess_grievance_committee" model="res.groups">
        <field name="name">ESS Grievance Committee</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Only members of this group can read complaints and grievances.</field>
    </record>
</odoo>
