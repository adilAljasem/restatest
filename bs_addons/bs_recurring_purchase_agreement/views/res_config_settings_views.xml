<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.bs.recurring.purchase</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="stock_request.stock_transfer_res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='stock_request_purchase_line_warehouse_setting']"
                position="after"
            >
                <setting
                    id="bs_recurring_purchase_order_setting"
                    string="Recurring Purchase Order"
                    help="Create confirmed purchase orders automatically from recurring blanket agreements."
                >
                    <field name="bs_recurring_purchase_order_enabled" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
